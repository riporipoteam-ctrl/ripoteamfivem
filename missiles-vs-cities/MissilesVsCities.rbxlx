<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX60"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="Lighting" referent="RBX61"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><bool name="GlobalShadows">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX62"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX10"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">BuildingDefs</string><ProtectedString name="Source">-- The 12 buildable city zones, in plot order (4 columns x 3 rows).

local Config = require(script.Parent.Config)

local BuildingDefs = {}

BuildingDefs.List = {
	{ id = "house", name = "Houses", emoji = "\u{1F3E0}", color = Color3.fromRGB(240, 120, 120), baseCost = 100, baseIncome = 4, hp = 600, style = "houses", material = "Brick" },
	{ id = "apartments", name = "Apartments", emoji = "\u{1F3D8}\u{FE0F}", color = Color3.fromRGB(245, 170, 90), baseCost = 750, baseIncome = 12, hp = 900, style = "houses", material = "Brick" },
	{ id = "shops", name = "Shops", emoji = "\u{1F3EA}", color = Color3.fromRGB(255, 220, 90), baseCost = 6500, baseIncome = 45, hp = 1200, style = "towers", material = "SmoothPlastic" },
	{ id = "bank", name = "Bank", emoji = "\u{1F3E6}", color = Color3.fromRGB(140, 220, 120), baseCost = 60e3, baseIncome = 210, hp = 1800, style = "towers", material = "Marble" },
	{ id = "factory", name = "Factory", emoji = "\u{1F3ED}", color = Color3.fromRGB(170, 170, 180), baseCost = 550e3, baseIncome = 950, hp = 2600, style = "towers", material = "Metal" },
	{ id = "solar", name = "Solar Field", emoji = "\u{2600}\u{FE0F}", color = Color3.fromRGB(80, 140, 235), baseCost = 5e6, baseIncome = 4200, hp = 1500, style = "panels", material = "Glass" },
	{ id = "downtown", name = "Downtown", emoji = "\u{1F3D9}\u{FE0F}", color = Color3.fromRGB(120, 200, 255), baseCost = 48e6, baseIncome = 19e3, hp = 5200, style = "towers", material = "Glass" },
	{ id = "stadium", name = "Stadium", emoji = "\u{1F3DF}\u{FE0F}", color = Color3.fromRGB(220, 130, 240), baseCost = 450e6, baseIncome = 88e3, hp = 6500, style = "towers", material = "Concrete" },
	{ id = "airport", name = "Airport", emoji = "\u{2708}\u{FE0F}", color = Color3.fromRGB(235, 235, 240), baseCost = 4.2e9, baseIncome = 400e3, hp = 8000, style = "panels", material = "Concrete" },
	{ id = "military", name = "Military Base", emoji = "\u{1FA96}", color = Color3.fromRGB(110, 140, 90), baseCost = 40e9, baseIncome = 1.9e6, hp = 16000, style = "towers", material = "Slate" },
	{ id = "wind", name = "Wind Farm", emoji = "\u{1F300}", color = Color3.fromRGB(200, 240, 250), baseCost = 380e9, baseIncome = 8.8e6, hp = 9000, style = "turbines", material = "SmoothPlastic" },
	{ id = "space", name = "Space Center", emoji = "\u{1F6F0}\u{FE0F}", color = Color3.fromRGB(255, 255, 255), baseCost = 3.6e12, baseIncome = 42e6, hp = 30000, style = "towers", material = "Metal" },
	{ id = "techhub", name = "Tech Hub", emoji = "\u{1F4BB}", color = Color3.fromRGB(90, 230, 220), baseCost = 34e12, baseIncome = 380e6, hp = 45000, style = "towers", material = "Glass" },
	{ id = "casino", name = "Casino", emoji = "\u{1F3B0}", color = Color3.fromRGB(250, 180, 60), baseCost = 320e12, baseIncome = 3.4e9, hp = 60000, style = "towers", material = "Marble" },
	{ id = "port", name = "Mega Port", emoji = "\u{2693}", color = Color3.fromRGB(120, 150, 190), baseCost = 3e15, baseIncome = 30e9, hp = 90000, style = "panels", material = "Metal" },
	{ id = "goldtower", name = "Golden Tower", emoji = "\u{1F3C6}", color = Color3.fromRGB(255, 215, 80), baseCost = 28e15, baseIncome = 260e9, hp = 150000, style = "towers", material = "Metal" },
}

BuildingDefs.ById = {}
for i, def in ipairs(BuildingDefs.List) do
	def.zoneIndex = i
	BuildingDefs.ById[def.id] = def
end

-- Cost to go from (targetLevel - 1) to targetLevel. Level 1 = the initial purchase.
-- The very first house is FREE (players start from $0).
function BuildingDefs.upgradeCost(def, targetLevel)
	if def.id == "house" and targetLevel == 1 then
		return 0
	end
	return math.floor(def.baseCost * Config.CostGrowth ^ (targetLevel - 1))
end

function BuildingDefs.population(def, level)
	if level &lt;= 0 then
		return 0
	end
	return (Config.PopulationPer[def.id] or 5) * level
end

-- Cost to unlock this zone's land (islands expand area by area).
function BuildingDefs.unlockCost(def)
	return math.max(50, math.floor(def.baseCost * 0.4))
end

function BuildingDefs.income(def, level)
	if level &lt;= 0 then
		return 0
	end
	return def.baseIncome * level * Config.IncomeGrowth ^ (level - 1)
end

function BuildingDefs.maxHp(def, level)
	return math.floor(def.hp * (1 + 0.35 * (level - 1)))
end

-- Total cash ever invested into this building at the given level (geometric sum).
function BuildingDefs.totalWorth(def, level)
	if level &lt;= 0 then
		return 0
	end
	local g = Config.CostGrowth
	return def.baseCost * (g ^ level - 1) / (g - 1)
end

return BuildingDefs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Central balance / tuning for Missiles vs Cities.
-- Every number a designer would want to touch lives here.

local Config = {}

Config.MaxPlayers = 5

-- Visual style switches. The default look is classic blocky "stud brick"
-- (like the reference game / old Roblox). Flip these to true to use inserted
-- Creator Store mesh models instead.
Config.UseStoreDecor = true -- Store trees/benches/fountains vs blocky ones
Config.UseStoreBuildings = true -- real Store mesh buildings for every zone
Config.UseStoreSky = true -- community skybox (9.7k upvotes)

-- Classic stud overlay texture (transparent, tints with the brick color).
Config.StudTexture = "rbxassetid://8890102519"

-- Load free Creator Store UI packs at runtime and use their real icons/art.
-- Set false to keep the built-in code-drawn UI. These load in Studio too.
Config.UseStoreUIKit = true
Config.UIKitPacks = {
	99176447965360, -- "Simulator Icon Pack" by DevJoob (+30)
	12528362526, -- "Tycoon Button Pack (WITH GUIs)" by goalmwo (+19)
}

-- Extra rocket silos: fire one rocket per silo, per launch.
Config.Silos = {
	Max = 3,
	Costs = { 0, 25e6, 25e9 }, -- silo 1 free, then 25M, then 25B
}

-- Jets (need an Airport built): buy hangars, upgrade jets, strike cities or
-- DISABLE enemy rocket silos for a while.
Config.Jets = {
	MaxHangars = 3,
	HangarCosts = { 5e6, 100e6, 2e9 },
	MaxLevel = 50,
	BaseDamage = 2000,
	DamageGrowth = 1.25,
	BaseUpgradeCost = 2e6,
	CostGrowth = 1.5,
	Cooldown = 120,
	FlightTime = 8,
	SiloDisable = 75, -- seconds the victim can't launch rockets
}

-- Air defense: each level adds intercept chance vs missiles and jets.
Config.Defense = {
	MaxLevel = 12,
	BaseCost = 100e3,
	CostGrowth = 6,
	MissileChancePerLevel = 0.05, -- capped below
	JetChancePerLevel = 0.04,
	MaxChance = 0.6,
}

-- Missile battery: a small island of BIG silos next to your island.
-- No aiming — six missiles rain on random parts of the target city.
Config.Battery = {
	UnlockCost = 50e6,
	MaxLevel = 20,
	BaseDamage = 3000,
	DamageGrowth = 1.4,
	BaseUpgradeCost = 50e6,
	CostGrowth = 8,
	Cooldown = 600, -- big reload
	Volley = 6,
}

-- Population: each building type houses people (per level). Getting bombed
-- costs you population AND money.
Config.PopulationPer = {
	house = 4, apartments = 10, shops = 6, bank = 8, factory = 12, solar = 5,
	downtown = 40, stadium = 30, airport = 25, military = 20, wind = 8,
	space = 35, techhub = 45, casino = 30, port = 40, goldtower = 60,
}
Config.VictimCashLossRate = 0.15 -- % of destroyed worth the victim also loses

-- Pilot random event (airport owners): accept his landing for a payout, or
-- decline and risk him crashing into your city.
Config.Pilot = {
	MinReward = 100e3,
	RewardMinutes = 5, -- plus income-scaled bonus
	DecideSeconds = 25,
}

-- Admins: put Roblox UserIds here to unlock the in-game Admin Panel.
-- Find your id at roblox.com/users/profile (the number in the URL).
Config.Admins = {}

-- World layout
Config.PlotCount = 5
Config.PlotSize = 272 -- 4x4 zone grid + rocket silo strip
Config.PlotDistance = 700 -- big gaps between islands
Config.ZoneSize = 40
Config.GroundY = 4

-- Economy: everyone starts from ZERO. The first house is free.
Config.StartingCash = 0
Config.StartingGems = 25
Config.AutoCollectCost = 200e3 -- buy once, income goes straight to wallet
Config.IncomeInterval = 2
Config.AutosaveInterval = 120
Config.BuildingMaxLevel = 60
Config.CostGrowth = 1.32
Config.IncomeGrowth = 1.13

-- Rockets
Config.Rocket = {
	MaxLevel = 100,
	BaseDamage = 400,
	DamageGrowth = 1.16,
	BaseUpgradeCost = 2500,
	CostGrowth = 1.42,
	Cooldown = 45,
	FlightTime = 8, -- includes the vertical lift-off phase
	BlastRadius = 34,
}

-- Nukes
Config.Nuke = {
	IslandCost = 995e12, -- $995 Trillion for nuke access
	Cooldown = 24 * 60 * 60, -- one nuke per day
	FlightTime = 13, -- includes the vertical lift-off phase
	ImmunityAfter = 180, -- seconds of protection after being nuked
}

Config.MissileRepairTime = 120 -- seconds for a missile-destroyed building to rebuild
Config.HpRegenDelay = 60 -- damaged (not destroyed) buildings heal after this long without hits
Config.JoinImmunity = 120 -- new joiners can't be attacked for this long

-- Rebirth: reset your buildings for a permanent income multiplier.
-- Cost scales forever, so the game never runs out of goals.
Config.Rebirth = {
	BaseCost = 25e9,
	CostGrowth = 120, -- each rebirth costs 120x the previous
	IncomePerRebirth = 1, -- +100% income per rebirth
}

-- Random world events.
Config.Events = {
	MinInterval = 200,
	MaxInterval = 340,
	FrenzyDuration = 60,
	FrenzyMult = 2,
	GemRainAmount = 15,
	MeteorCount = 8,
	MeteorDamage = 2500,
	SupplyCashMinutes = 10,
	SupplyGems = 20,
}

-- Gem shop
Config.Shop = {
	RepairAllGems = 25,
	SkipCooldownGems = 10,
	ShieldGems = 40,
	BarrageGems = 40,
}

-- Character shop (Tilly). Tiered items cost Costs[tier+1] gems.
Config.Character = {
	SpeedCosts = { 30, 60, 120 },
	SpeedPerTier = 4, -- +WalkSpeed per tier
	JumpCosts = { 25, 50, 100 },
	JumpPerTier = 12, -- +JumpPower per tier
	TrailCost = 150,
	Titles = {
		{ id = "tycoon", label = "\u{1F4B0} Tycoon", cost = 100 },
		{ id = "warlord", label = "\u{2622}\u{FE0F} WARLORD", cost = 250 },
		{ id = "legend", label = "\u{1F31F} LEGEND", cost = 500 },
	},
}
Config.GiftInterval = 15 * 60 -- free gift every 15 minutes of playtime
Config.GiftGems = 15

-- Monetization placeholders. Create gamepasses for your experience and put
-- their IDs here; 0 leaves the buttons in "not configured" mode.
Config.GamePassCash2x = 0
Config.GamePassDamage2x = 0

-- Daily rewards (index = streak day). Client renders this table directly.
Config.DailyRewards = {
	{ label = "50 Gems", emoji = "\u{1F48E}", kind = "gems", amount = 50 },
	{ label = "Cash Boost", emoji = "\u{1F4B5}", kind = "cash_minutes", amount = 10 },
	{ label = "Shield", emoji = "\u{1F6E1}\u{FE0F}", kind = "shield", amount = 1 },
	{ label = "Barrage", emoji = "\u{1F680}", kind = "barrage", amount = 1 },
	{ label = "150 Gems", emoji = "\u{1F48E}", kind = "gems", amount = 150 },
	{ label = "400 Gems", emoji = "\u{1F48E}", kind = "gems", amount = 400 },
	{ label = "FREE NUKE", emoji = "\u{2622}\u{FE0F}", kind = "nuke_charge", amount = 1 },
}
Config.DailyClaimWindow = 20 * 60 * 60 -- can claim again 20h after last claim
Config.DailyStreakBreak = 48 * 60 * 60 -- miss 48h and the streak resets

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">DecorSets</string><ProtectedString name="Source">-- Curated free models from the Roblox Creator Store (create.roblox.com/store),
-- picked by community rating. The DecorService inserts these at runtime with
-- InsertService and falls back gracefully if any id fails to load.
-- Swap in your own favorites: any free model id works.

local DecorSets = {}

-- Multiple candidates per category; the first that loads gets used.
DecorSets.Models = {
	tree = { 4893246329, 3287226226, 12549617200 }, -- "Low Poly Tree" (828+ votes)
	bush = { 8647777369, 10302128725, 15022313886 }, -- "Bush" (1.8k+ votes)
	bench = { 741384218, 393609716, 8924251735 }, -- "The Generic Park Bench"
	lamp = { 15472204631, 11146095708, 15323049348 }, -- "Street Lamp Light"
	fountain = { 11423259371, 13782728612, 2332885124 }, -- "Fountain"
	rock = { 7299047040, 16098456067 }, -- "Low Poly Rock"
	car = { 11493825596, 113700576399250 }, -- "Low Poly Car"
}

-- Skybox models (contain a Sky object). "Sky-Realistic" has 9.7k upvotes.
DecorSets.Sky = { 10256505900, 4607457995, 7108851308 }

-- Target sizes (studs) used to auto-scale whatever loads.
DecorSets.TargetSize = {
	tree = 18, -- height
	bush = 4,
	bench = 7, -- width
	lamp = 12, -- height
	fountain = 14, -- width
	rock = 5,
	car = 13, -- length
}

-- Store models for the 16 tycoon buildings themselves, curated from
-- create.roblox.com/store. mode "cluster" = several copies that multiply
-- with level; "single" = one centerpiece that grows with level.
-- size = target footprint (or height when byHeight). If every id in a
-- category fails to load, the game falls back to its built-in part visuals.
DecorSets.Buildings = {
	house = { ids = { 18144266950, 105797187065697, 91447454268215 }, mode = "cluster", size = 15 },
	apartments = { ids = { 15075550418, 15082419807 }, mode = "cluster", size = 16 },
	shops = { ids = { 9642714623, 18828724532 }, mode = "cluster", size = 16 },
	bank = { ids = { 76831024602896 }, mode = "cluster", size = 16 },
	factory = { ids = { 11387823607, 78205505459731 }, mode = "single", size = 34 },
	solar = { ids = { 11100628682, 15174071780 }, mode = "cluster", size = 12 },
	downtown = { ids = { 12006622902, 85506482351178, 114750850222093 }, mode = "cluster", size = 16 },
	stadium = { ids = { 107182109387966 }, mode = "single", size = 36 },
	airport = { ids = { 137558548393747, 105826236392834 }, mode = "single", size = 34 },
	military = { ids = { 120453129382585, 96964466281091 }, mode = "cluster", size = 14 },
	wind = { ids = { 6221197459, 11464875249 }, mode = "cluster", size = 26, byHeight = true },
	space = { ids = { 126157921427052, 11714293744 }, mode = "single", size = 28, byHeight = true },
	techhub = { ids = { 13893512148, 5140904246 }, mode = "cluster", size = 16 },
	casino = { ids = { 8984780407 }, mode = "single", size = 34 },
	port = { ids = { 72746749225388, 92609497200026 }, mode = "single", size = 34 },
	goldtower = { ids = { 8533751203, 119160909 }, mode = "single", size = 30, byHeight = true },
}

-- Destroyed-building rubble (replaces the part rubble when it loads).
DecorSets.Rubble = { 8389261449, 95266753561513 }

return DecorSets
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Layout</string><ProtectedString name="Source">-- Deterministic world layout math, shared by server (to build the world)
-- and client (to aim cameras, popups and crosshairs) so nothing needs replicating.

local Config = require(script.Parent.Config)

local Layout = {}

Layout.GroundY = Config.GroundY

local HALF = Config.PlotSize / 2

-- Zone grid: 4 columns x 4 rows of 40-stud zones separated by 12-stud roads.
local COL_X = { -78, -26, 26, 78 }
local ROW_Z = { 104, 52, 0, -52 }

-- Each island also has a "town square" strip at the front (positive Z)
-- holding the spawn, shop stand, NPCs, leaderboard and rebirth shrine.
Layout.TownDepth = 60 -- extra island depth in front of the city grid

function Layout.plotCenter(plotIndex)
	local angle = math.rad(-54 + (plotIndex - 1) * 72)
	return Vector3.new(math.cos(angle) * Config.PlotDistance, 0, math.sin(angle) * Config.PlotDistance)
end

function Layout.zoneOffset(zoneIndex)
	local row = math.ceil(zoneIndex / 4)
	local col = ((zoneIndex - 1) % 4) + 1
	return Vector3.new(COL_X[col], 0, ROW_Z[row])
end

function Layout.zoneCenter(plotIndex, zoneIndex)
	local c = Layout.plotCenter(plotIndex)
	local o = Layout.zoneOffset(zoneIndex)
	return Vector3.new(c.X + o.X, Config.GroundY, c.Z + o.Z)
end

-- Buy/upgrade pad sits on the road directly in front of its zone.
function Layout.padPos(plotIndex, zoneIndex)
	return Layout.zoneCenter(plotIndex, zoneIndex) + Vector3.new(0, 0, 26)
end

-- Silos live on the town square, right next to spawn. Up to 3 in a row.
function Layout.siloPos(plotIndex, siloIndex)
	local c = Layout.plotCenter(plotIndex)
	local townZ = c.Z + Config.PlotSize / 2
	return Vector3.new(c.X - 66 - ((siloIndex or 1) - 1) * 32, Config.GroundY, townZ + 36)
end

function Layout.nukePadPos(plotIndex)
	local c = Layout.plotCenter(plotIndex)
	return Vector3.new(c.X - 38, Config.GroundY, c.Z + Config.PlotSize / 2 + 36)
end

-- Small missile-battery island floating beside each player island.
function Layout.batteryIslandCenter(plotIndex)
	local c = Layout.plotCenter(plotIndex)
	return Vector3.new(c.X - Config.PlotSize / 2 - 90, 0, c.Z + 40)
end

-- Air-defense turret corner spots (up to 4).
function Layout.defensePos(plotIndex, turretIndex)
	local c = Layout.plotCenter(plotIndex)
	local half = Config.PlotSize / 2 - 10
	local corners = {
		Vector3.new(c.X - half, Config.GroundY, c.Z - half),
		Vector3.new(c.X + half, Config.GroundY, c.Z - half),
		Vector3.new(c.X - half, Config.GroundY, c.Z + half),
		Vector3.new(c.X + half, Config.GroundY, c.Z + half),
	}
	return corners[((turretIndex - 1) % 4) + 1]
end

-- The airport zone (jets take off from here).
Layout.AirportZoneIndex = 9

function Layout.plotSpawn(plotIndex)
	local c = Layout.plotCenter(plotIndex)
	return Vector3.new(c.X, Config.GroundY + 4, c.Z + 152)
end

-- Road intersection waypoints (world space) that citizens walk between.
Layout.RoadXs = { -104, -52, 0, 52, 104 }
Layout.RoadZs = { 130, 78, 26, -26, -78 }

function Layout.intersection(plotIndex, ix, iz)
	local c = Layout.plotCenter(plotIndex)
	return Vector3.new(c.X + Layout.RoadXs[ix], Config.GroundY, c.Z + Layout.RoadZs[iz])
end

function Layout.plotBounds(plotIndex)
	local c = Layout.plotCenter(plotIndex)
	return c.X - HALF, c.Z - HALF, c.X + HALF, c.Z + HALF
end

function Layout.clampToPlot(plotIndex, pos)
	local minX, minZ, maxX, maxZ = Layout.plotBounds(plotIndex)
	return Vector3.new(
		math.clamp(pos.X, minX, maxX),
		Layout.GroundY,
		math.clamp(pos.Z, minZ, maxZ)
	)
end

-- Top-down camera used by the attack ("BLOW UP") view.
function Layout.attackCameraCFrame(plotIndex)
	local c = Layout.plotCenter(plotIndex)
	local eye = Vector3.new(c.X, 390, c.Z + 50)
	return CFrame.lookAt(eye, Vector3.new(c.X, Layout.GroundY, c.Z))
end

return Layout
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">NPCDefs</string><ProtectedString name="Source">-- Lobby NPCs: looks, positions, dialogue lines and what they do.
-- Positions are offsets from the lobby center.

local NPCDefs = {}

NPCDefs.List = {
	{
		id = "shopkeeper",
		name = "Benny the Shopkeeper",
		emoji = "\u{1F6D2}",
		shirt = Color3.fromRGB(60, 150, 240),
		pants = Color3.fromRGB(60, 60, 70),
		hat = Color3.fromRGB(240, 200, 40),
		pos = Vector3.new(32, 0, 14),
		facing = -90,
		action = "shop",
		actionLabel = "\u{1F6D2} Open Shop",
		lines = {
			"Welcome to Benny's Battle Bazaar! \u{1F6D2}",
			"Shields, barrages, instant repairs... everything a city at war could need!",
			"All prices in gems \u{1F48E} — grab your free gift every 15 minutes to stock up!",
		},
	},
	{
		id = "tailor",
		name = "Tilly the Tailor",
		emoji = "\u{1FA84}",
		shirt = Color3.fromRGB(220, 130, 240),
		pants = Color3.fromRGB(120, 80, 160),
		hat = Color3.fromRGB(255, 120, 180),
		pos = Vector3.new(-32, 0, 14),
		facing = 90,
		action = "charshop",
		actionLabel = "\u{2728} Character Shop",
		lines = {
			"Darling! You simply cannot conquer the world dressed like THAT. \u{1FA84}",
			"I've got speed boosts, mega jumps, glorious titles and a rainbow trail!",
			"A true warlord should LOOK the part, don't you think?",
		},
	},
	{
		id = "mayor",
		name = "Mayor Penny",
		emoji = "\u{1F3DB}\u{FE0F}",
		shirt = Color3.fromRGB(90, 200, 120),
		pants = Color3.fromRGB(50, 90, 60),
		hat = Color3.fromRGB(240, 240, 245),
		pos = Vector3.new(20, 0, -30),
		facing = 160,
		action = "quest",
		chain = "mayor",
		actionLabel = "\u{1F4DC} View Quests",
		lines = {
			"Ah, a new city builder! Welcome, welcome! \u{1F3DB}\u{FE0F}",
			"This town won't grow itself — I have building contracts with YOUR name on them.",
			"Complete my quests and the city treasury will reward you handsomely!",
		},
	},
	{
		id = "general",
		name = "General Boom",
		emoji = "\u{1F4A5}",
		shirt = Color3.fromRGB(110, 140, 90),
		pants = Color3.fromRGB(60, 75, 50),
		hat = Color3.fromRGB(60, 75, 50),
		pos = Vector3.new(-20, 0, -30),
		facing = -160,
		action = "quest",
		chain = "general",
		actionLabel = "\u{1F4DC} View Quests",
		lines = {
			"SOLDIER! You call that a rocket silo?! \u{1F4A5}",
			"Out there five cities compete for glory, and only firepower decides who eats!",
			"Complete my combat missions and I'll make it worth your while. DISMISSED!",
		},
	},
}

NPCDefs.ById = {}
for _, def in ipairs(NPCDefs.List) do
	NPCDefs.ById[def.id] = def
end

return NPCDefs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">NumberFormat</string><ProtectedString name="Source">-- Big-number formatting: 1.28M / 846T / 71.3Sx style plus full comma strings.

local NumberFormat = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "UDc", "DDc", "TDc" }

function NumberFormat.abbrev(n)
	n = math.floor(n + 0.5)
	if n &lt; 0 then
		return "-" .. NumberFormat.abbrev(-n)
	end
	if n &lt; 1000 then
		return tostring(n)
	end
	local idx = math.floor(math.log10(n) / 3)
	idx = math.min(idx, #SUFFIXES - 1)
	local scaled = n / 10 ^ (idx * 3)
	local txt
	if scaled &gt;= 100 then
		txt = string.format("%.0f", scaled)
	elseif scaled &gt;= 10 then
		txt = string.format("%.1f", scaled)
	else
		txt = string.format("%.2f", scaled)
	end
	txt = txt:gsub("%.0+$", ""):gsub("(%.%d-)0+$", "%1")
	return txt .. SUFFIXES[idx + 1]
end

function NumberFormat.commas(n)
	n = math.floor(n + 0.5)
	local neg = n &lt; 0
	local s = string.format("%.0f", math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,")
	out = out:reverse():gsub("^,", "")
	return (neg and "-" or "") .. out
end

-- 1:35:03 style countdown text.
function NumberFormat.clock(sec)
	sec = math.max(0, math.floor(sec))
	local h = sec // 3600
	local m = (sec % 3600) // 60
	local s = sec % 60
	if h &gt; 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return NumberFormat
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">QuestDefs</string><ProtectedString name="Source">-- Quest chains. Kinds:
--   counters (increment on events): upgrade, destroy, missile_launch, nuke
--   stats (evaluated against live values): cash, worth, rocket_level, buildings
-- The last quest of a chain can be repeatable = the game never runs out.
-- Rewards: cash, gems, shield, barrage, cashMinutes (income-scaled cash).

local QuestDefs = {}

QuestDefs.Chains = {
	mayor = {
		npc = "mayor",
		title = "\u{1F3DB}\u{FE0F} Mayor Penny",
		quests = {
			{ name = "First Bricks", desc = "Buy or upgrade buildings 3 times", kind = "upgrade", goal = 3, reward = { cash = 2500 } },
			{ name = "Growing Town", desc = "Own 5 different building types", kind = "buildings", goal = 5, reward = { cash = 20000, gems = 15 } },
			{ name = "Millionaire", desc = "Hold $1M cash at once", kind = "cash", goal = 1e6, reward = { gems = 40 } },
			{ name = "Skyline", desc = "Own 10 different building types", kind = "buildings", goal = 10, reward = { cashMinutes = 10, gems = 25 } },
			{ name = "Billion Dollar City", desc = "Reach $1B city worth", kind = "worth", goal = 1e9, reward = { gems = 75 } },
			{ name = "Full House", desc = "Own all 16 building types", kind = "buildings", goal = 16, reward = { gems = 120, shield = 1 } },
			{ name = "Trillion Club", desc = "Hold $1T cash at once", kind = "cash", goal = 1e12, reward = { gems = 250 } },
			{ name = "Quadrillionaire", desc = "Reach $1Qa city worth", kind = "worth", goal = 1e15, reward = { gems = 500 } },
			{ name = "Keep Building!", desc = "Buy or upgrade buildings 25 times", kind = "upgrade", goal = 25, reward = { cashMinutes = 20, gems = 30 }, repeatable = true },
		},
	},
	general = {
		npc = "general",
		title = "\u{1F4A5} General Boom",
		quests = {
			{ name = "First Strike", desc = "Launch a missile at another city", kind = "missile_launch", goal = 1, reward = { cash = 5000 } },
			{ name = "Demolition Job", desc = "Destroy 5 enemy buildings", kind = "destroy", goal = 5, reward = { gems = 30 } },
			{ name = "Rocket Scientist", desc = "Upgrade your rocket to Lv10", kind = "rocket_level", goal = 10, reward = { cashMinutes = 10, gems = 20 } },
			{ name = "Carpet Bomber", desc = "Launch 15 missiles", kind = "missile_launch", goal = 15, reward = { barrage = 1, gems = 25 } },
			{ name = "Warlord", desc = "Destroy 25 enemy buildings", kind = "destroy", goal = 25, reward = { gems = 100 } },
			{ name = "Big Red Button", desc = "Fire a NUKE", kind = "nuke", goal = 1, reward = { gems = 300 } },
			{ name = "Doomsday Engine", desc = "Upgrade your rocket to Lv40", kind = "rocket_level", goal = 40, reward = { gems = 400, shield = 1 } },
			{ name = "War Never Ends", desc = "Destroy 10 enemy buildings", kind = "destroy", goal = 10, reward = { gems = 35 }, repeatable = true },
		},
	},
}

return QuestDefs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Remotes</string><ProtectedString name="Source">-- Creates (server) or fetches (client) all RemoteEvents/RemoteFunctions.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"State", -- server -&gt; client: full player state snapshot
	"IncomePops", -- server -&gt; all: floating +$ popup batches
	"Notify", -- server -&gt; client(s): toast messages
	"MissileEvent", -- server -&gt; all: rocket/nuke flight for client FX
	"Alarm", -- server -&gt; victim: incoming strike warning
	"ShieldFX", -- server -&gt; all: shield block visual
	"DailyData", -- server -&gt; client: daily rewards refresh
	"RequestLaunch", -- client -&gt; server: fire rocket/nuke
	"UpgradeRocket", -- client -&gt; server
	"ClaimDaily", -- client -&gt; server
	"ShopBuy", -- client -&gt; server: gem shop / gamepass / character shop
	"ClaimGift", -- client -&gt; server
	"GameEvent", -- server -&gt; all: random world events (frenzy, meteors, ...)
	"RequestRebirth", -- client -&gt; server
	"RequestJet", -- client -&gt; server: jet strike (city or silos)
	"RequestBattery", -- client -&gt; server: battery volley
	"UpgradeBattery", -- client -&gt; server
	"JetEvent", -- server -&gt; all: jet flight FX
	"PlaneEvent", -- server -&gt; all: pilot plane FX (landing / crash)
	"PilotOffer", -- server -&gt; client: the old pilot asks to land
	"PilotAnswer", -- client -&gt; server: accept / decline
	"AdminAction", -- client -&gt; server (validated against Config.Admins)
}
local FUNCTIONS = {
	"GetSnapshot", -- client asks for initial state
	"GetTargets", -- client asks who can be attacked
}

local Remotes = { Events = {}, Functions = {} }

if RunService:IsServer() then
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in ipairs(EVENTS) do
		local ev = Instance.new("RemoteEvent")
		ev.Name = name
		ev.Parent = folder
		Remotes.Events[name] = ev
	end
	for _, name in ipairs(FUNCTIONS) do
		local fn = Instance.new("RemoteFunction")
		fn.Name = name
		fn.Parent = folder
		Remotes.Functions[name] = fn
	end
	folder.Parent = ReplicatedStorage
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in ipairs(EVENTS) do
		Remotes.Events[name] = folder:WaitForChild(name)
	end
	for _, name in ipairs(FUNCTIONS) do
		Remotes.Functions[name] = folder:WaitForChild(name)
	end
end

return Remotes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">SoundBook</string><ProtectedString name="Source">-- All game audio in one place. The rbxasset:// entries are built into every
-- Roblox install so they always play; swap any of them for marketplace ids
-- ("rbxassetid://12345") if you want richer audio later.

local SoundBook = {}

-- Primary ids are real Creator Store SFX (all licensed for any experience,
-- curated from create.roblox.com/store audio). Every entry has a built-in
-- rbxasset fallback that plays if the Store id ever fails to load.
SoundBook.Defs = {
	Click = { id = "rbxassetid://8755541422", fallback = "rbxasset://sounds/button.wav", volume = 0.7 }, -- pop click
	Good = { id = "rbxassetid://8646410774", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.8 }, -- coin collect
	Bad = { id = "rbxasset://sounds/uuhhh.wav", volume = 0.7 },
	Buy = { id = "rbxassetid://134810204798705", fallback = "rbxasset://sounds/snap.wav", volume = 0.9 }, -- cash register
	Launch = { id = "rbxassetid://12222065", fallback = "rbxasset://sounds/swoosh.wav", volume = 1 }, -- official Roblox rocket launch
	Explosion = { id = "rbxassetid://125127520917980", fallback = "rbxasset://sounds/collide.wav", volume = 1 }, -- big explosion
	Nuke = { id = "rbxassetid://7163539309", fallback = "rbxasset://sounds/bass.wav", volume = 1 }, -- 21s nuclear blast
	BigRumble = { id = "rbxasset://sounds/bass.wav", volume = 1 },
	Glass = { id = "rbxasset://sounds/glassbreak.wav", volume = 0.9 },
	Victory = { id = "rbxassetid://1836473422", fallback = "rbxasset://sounds/victory.wav", volume = 0.9 }, -- APM fanfare
	Flash = { id = "rbxasset://sounds/flashbulb.wav", volume = 0.9 },
	Siren = { id = "rbxassetid://9113073796", fallback = "rbxasset://sounds/bass.wav", volume = 0.9 }, -- real air raid siren
	PanelOpen = { id = "rbxassetid://138890894929151", fallback = "rbxasset://sounds/swoosh.wav", volume = 0.6 }, -- whoosh
	Blip = { id = "rbxasset://sounds/button.wav", volume = 0.25 }, -- dialogue typewriter
	Horn = { id = "rbxasset://sounds/bass.wav", volume = 0.9 }, -- world event fanfare (pitched up)
	Ding = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9 },
	Splat = { id = "rbxasset://sounds/splat.wav", volume = 0.8 },
	Hit = { id = "rbxasset://sounds/hit.wav", volume = 0.8 },
	Collect = { id = "rbxassetid://135483737426662", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5 }, -- coin pickup
	Upgrade = { id = "rbxassetid://9118823105", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7 }, -- power-up
	Unlock = { id = "rbxassetid://9125423797", fallback = "rbxasset://sounds/switch.wav", volume = 0.8 }, -- chime
}

-- Chill background music (Creator Store, free-to-use): first id that loads
-- plays on loop forever. "Pixel Dreams" leads — fits the blocky vibe.
SoundBook.Music = { 123846926386533, 136419664364400, 137626560269194 }

function SoundBook.make(key, props)
	local def = SoundBook.Defs[key]
	if not def then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = def.id
	s.Volume = def.volume
	if props then
		for k, v in pairs(props) do
			s[k] = v
		end
	end
	return s
end

function SoundBook.play(key, parent, props)
	local def = SoundBook.Defs[key]
	local s = SoundBook.make(key, props)
	if not s then
		return nil
	end
	s.Parent = parent
	s:Play()
	-- If the Store id hasn't loaded shortly after, swap to the built-in.
	if def.fallback then
		task.delay(0.7, function()
			if s.Parent and not s.IsLoaded then
				s:Stop()
				s.SoundId = def.fallback
				s:Play()
			end
		end)
	end
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(25, function()
		if s and s.Parent then
			s:Destroy()
		end
	end)
	return s
end

-- Client-side: warm the Store sound ids so first plays are instant.
function SoundBook.preload()
	task.spawn(function()
		local ContentProvider = game:GetService("ContentProvider")
		local SoundService = game:GetService("SoundService")
		local temp = {}
		for _, def in pairs(SoundBook.Defs) do
			if def.id:sub(1, 11) == "rbxassetid:" then
				local s = Instance.new("Sound")
				s.SoundId = def.id
				s.Parent = SoundService
				temp[#temp + 1] = s
			end
		end
		pcall(function()
			ContentProvider:PreloadAsync(temp)
		end)
		task.delay(5, function()
			for _, s in ipairs(temp) do
				s:Destroy()
			end
		end)
	end)
end

-- Positional one-shot: spins up a throwaway invisible part to host the sound.
function SoundBook.playAt(key, position, props)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position
	holder.Parent = workspace
	local s = SoundBook.play(key, holder, props)
	task.delay(12, function()
		holder:Destroy()
	end)
	return s
end

return SoundBook
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX63"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX33"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">AdminService</string><ProtectedString name="Source">-- Admin panel backend. Only UserIds listed in Config.Admins can use these.
-- Actions are whitelisted and validated server-side; never trust the client.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MessagingService = game:GetService("MessagingService")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local AdminService = {}

local ctx
local CROSS_TOPIC = "MVC_AdminCross"

local banStore
do
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore("MVC_Bans_v1")
	end)
	if ok then
		banStore = s
	end
end

function AdminService.isBanned(userId)
	if not banStore then
		return false
	end
	local ok, v = pcall(function()
		return banStore:GetAsync("ban_" .. userId)
	end)
	return ok and v == true
end

local function isAdmin(player)
	-- In Studio playtests everyone is an admin, so you can always see the panel.
	if RunService:IsStudio() then
		return true
	end
	-- The game's owner is always an admin.
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		if ok and rank &gt;= 254 then
			return true
		end
	end
	for _, id in ipairs(Config.Admins) do
		if id == player.UserId then
			return true
		end
	end
	return false
end
AdminService.isAdmin = isAdmin

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function onAdminAction(player, action, arg)
	if not isAdmin(player) then
		return -- silent: not an admin
	end
	local profile = ctx.Data.get(player)
	if not profile then
		return
	end

	if action == "give_cash" then
		local amount = tonumber(arg) or 1e9
		profile.cash += amount
		notify(player, "\u{1F6E0}\u{FE0F} Admin: +\u{1F4B5} " .. NumberFormat.abbrev(amount), "victory")
	elseif action == "give_gems" then
		local amount = tonumber(arg) or 1000
		profile.gems += amount
		notify(player, "\u{1F6E0}\u{FE0F} Admin: +\u{1F48E} " .. amount, "victory")
	elseif action == "max_rockets" then
		profile.rocketLevel = Config.Rocket.MaxLevel
		profile.siloCount = Config.Silos.Max
		local slot = ctx.Plot.getSlot(player)
		if slot then
			ctx.Plot.updateSilos(slot, profile.siloCount)
			ctx.Plot.updateRocketVisual(slot, profile.rocketLevel)
		end
		notify(player, "\u{1F6E0}\u{FE0F} Admin: rockets maxed!", "victory")
	elseif action == "give_nuke" then
		profile.nukeIsland = true
		profile.lastNukeAt = 0
		notify(player, "\u{1F6E0}\u{FE0F} Admin: nuke access + reset cooldown!", "victory")
	elseif action == "repair" then
		local slot = ctx.Plot.getSlot(player)
		if slot then
			ctx.Plot.repairAll(slot)
		end
		notify(player, "\u{1F6E0}\u{FE0F} Admin: city repaired!", "good")
	elseif action == "unlock_all" then
		local BuildingDefs = require(Shared.BuildingDefs)
		profile.unlocked = #BuildingDefs.List
		local slot = ctx.Plot.getSlot(player)
		if slot then
			ctx.Plot.resetBuildings(player) -- re-derives locks with new unlocked count
		end
		notify(player, "\u{1F6E0}\u{FE0F} Admin: all areas unlocked!", "victory")
	elseif action == "trigger_event" then
		if ctx.Events then
			ctx.Events.fireRandom()
		end
		notify(player, "\u{1F6E0}\u{FE0F} Admin: random event triggered!", "info")
	elseif action == "trigger_pilot" then
		local slot = ctx.Plot.getSlot(player)
		if slot and ctx.Pilot then
			ctx.Pilot.trigger(slot)
		end
	elseif action == "nuke_server" then
		AdminService.nukeServer(player.DisplayName)
	elseif action == "nuke_all_servers" then
		pcall(function()
			MessagingService:PublishAsync(CROSS_TOPIC, { kind = "nuke", by = player.DisplayName })
		end)
		AdminService.nukeServer(player.DisplayName)
		notify(player, "\u{1F6E0}\u{FE0F} Nuking ALL servers!", "victory")
	elseif action == "announce_server" then
		AdminService.announce(tostring(arg), player.DisplayName)
	elseif action == "announce_all" then
		pcall(function()
			MessagingService:PublishAsync(CROSS_TOPIC, { kind = "announce", text = tostring(arg), by = player.DisplayName })
		end)
		AdminService.announce(tostring(arg), player.DisplayName)
	elseif action == "kick" then
		local target = Players:GetPlayerByUserId(tonumber(arg) or 0)
		if target then
			target:Kick("Kicked by an admin.")
			notify(player, "\u{1F6E0}\u{FE0F} Kicked " .. target.DisplayName, "info")
		end
	elseif action == "ban" then
		local id = tonumber(arg) or 0
		if banStore then
			pcall(function()
				banStore:SetAsync("ban_" .. id, true)
			end)
		end
		local target = Players:GetPlayerByUserId(id)
		if target then
			target:Kick("You are banned from this game.")
		end
		notify(player, "\u{1F6E0}\u{FE0F} Banned user " .. id, "bad")
	elseif action == "unban" then
		local id = tonumber(arg) or 0
		if banStore then
			pcall(function()
				banStore:RemoveAsync("ban_" .. id)
			end)
		end
		notify(player, "\u{1F6E0}\u{FE0F} Unbanned user " .. id, "good")
	elseif action == "take_cash" then
		local target = Players:GetPlayerByUserId(tonumber(arg) or 0)
		local tp = target and ctx.Data.get(target)
		if tp then
			tp.cash = 0
			ctx.Economy.pushState(target)
			notify(player, "\u{1F6E0}\u{FE0F} Wiped " .. target.DisplayName .. "'s cash", "info")
		end
	elseif action == "take_gems" then
		local target = Players:GetPlayerByUserId(tonumber(arg) or 0)
		local tp = target and ctx.Data.get(target)
		if tp then
			tp.gems = 0
			ctx.Economy.pushState(target)
			notify(player, "\u{1F6E0}\u{FE0F} Wiped " .. target.DisplayName .. "'s gems", "info")
		end
	elseif action == "nuke_player" then
		local target = Players:GetPlayerByUserId(tonumber(arg) or 0)
		local slot = target and ctx.Plot.getSlot(target)
		if slot then
			ctx.Plot.nukeSlot(slot)
			notify(target, "\u{2622}\u{FE0F} An admin nuked your city!", "bad")
			ctx.Economy.pushState(target)
		end
	end
	ctx.Economy.pushState(player)
end

-- Nukes every owned city in THIS server.
function AdminService.nukeServer(byName)
	for _, slot in ipairs(ctx.Plot.slots()) do
		if slot.owner then
			ctx.Plot.nukeSlot(slot)
			ctx.Economy.pushState(slot.owner)
		end
	end
	Remotes.Events.Notify:FireAllClients({
		msg = "\u{2622}\u{FE0F} ADMIN " .. (byName or "") .. " NUKED THE ENTIRE SERVER!",
		kind = "bad",
	})
end

function AdminService.announce(text, byName)
	Remotes.Events.Notify:FireAllClients({
		msg = "\u{1F4E2} [ADMIN" .. (byName and " " .. byName or "") .. "] " .. text,
		kind = "victory",
	})
end

function AdminService.init(context)
	ctx = context
	ctx.isAdmin = isAdmin
	Remotes.Events.AdminAction.OnServerEvent:Connect(onAdminAction)

	-- Cross-server admin commands.
	pcall(function()
		MessagingService:SubscribeAsync(CROSS_TOPIC, function(message)
			local data = message.Data
			if type(data) ~= "table" then
				return
			end
			if data.kind == "nuke" then
				AdminService.nukeServer(data.by)
			elseif data.kind == "announce" then
				AdminService.announce(data.text, data.by)
			end
		end)
	end)

	-- Enforce bans on join.
	Players.PlayerAdded:Connect(function(plr)
		task.spawn(function()
			if AdminService.isBanned(plr.UserId) then
				plr:Kick("You are banned from this game.")
			end
		end)
	end)
end

return AdminService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">BatteryService</string><ProtectedString name="Source">-- Missile Battery: a small island beside each player island holding several
-- BIG silos. No aiming — one "BLOW UP" button rains a volley across random
-- parts of the target city. Big cooldown; upgradeable damage.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local BatteryService = {}

local ctx
local rng = Random.new()

local function now()
	return os.clock()
end

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function announceBattery(player, target)
	Remotes.Events.Notify:FireAllClients({
		msg = "\u{1F680} " .. player.DisplayName .. " unleashed a MISSILE BATTERY on " .. target.DisplayName .. "!",
		kind = "bad",
	})
end

local SMOOTH_MATERIALS = {
	[Enum.Material.Neon] = true, [Enum.Material.Glass] = true,
	[Enum.Material.Metal] = true, [Enum.Material.DiamondPlate] = true,
}
local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	local mat = props.Material or Enum.Material.Plastic
	if mat == Enum.Material.SmoothPlastic then mat = Enum.Material.Plastic end
	local smooth = SMOOTH_MATERIALS[mat]
	local s = smooth and Enum.SurfaceType.Smooth or Enum.SurfaceType.Studs
	p.TopSurface = s; p.BottomSurface = s
	p.LeftSurface = s; p.RightSurface = s
	p.FrontSurface = s; p.BackSurface = s
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Material" then
			p[k] = v
		end
	end
	p.Material = mat
	p.Parent = props.Parent
	return p
end

-- Builds the little battery island (hidden until unlocked).
function BatteryService.buildIsland(slot)
	local c = Layout.batteryIslandCenter(slot.index)
	local folder = Instance.new("Folder")
	folder.Name = "BatteryIsland"
	folder.Parent = slot.folder
	folder:SetAttribute("Hidden", true)

	part({
		Name = "Base",
		Size = Vector3.new(70, 8, 60),
		Position = Vector3.new(c.X, -1, c.Z),
		Color = Color3.fromRGB(96, 96, 104),
		Material = Enum.Material.Concrete,
		Parent = folder,
	})
	part({
		Name = "Rim",
		Size = Vector3.new(82, 6, 72),
		Position = Vector3.new(c.X, -1.6, c.Z),
		Color = Color3.fromRGB(226, 200, 140),
		Material = Enum.Material.Sand,
		Parent = folder,
	})

	local launchPositions = {}
	local cols, rowsN = 3, 2
	for r = 0, rowsN - 1 do
		for cc = 0, cols - 1 do
			local sx = c.X - 18 + cc * 18
			local sz = c.Z - 10 + r * 20
			-- Big silo tube.
			part({
				Name = "BigSilo",
				Size = Vector3.new(7, 4, 7),
				Position = Vector3.new(sx, Config.GroundY + 2, sz),
				Color = Color3.fromRGB(60, 62, 68),
				Material = Enum.Material.DiamondPlate,
				Parent = folder,
			})
			local rocket = part({
				Name = "BigRocket",
				Size = Vector3.new(4, 12, 4),
				Position = Vector3.new(sx, Config.GroundY + 9, sz),
				Color = Color3.fromRGB(220, 80, 60),
				Material = Enum.Material.Metal,
				Parent = folder,
			})
			part({
				Name = "BigNose",
				Size = Vector3.new(2.6, 3, 2.6),
				Position = Vector3.new(sx, Config.GroundY + 16, sz),
				Color = Color3.fromRGB(250, 210, 90),
				Material = Enum.Material.Neon,
				Parent = folder,
			})
			launchPositions[#launchPositions + 1] = Vector3.new(sx, Config.GroundY + 16, sz)
		end
	end

	-- BLOW UP battery pad the owner steps on.
	local pad = part({
		Name = "BatteryPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 14, 14),
		CFrame = CFrame.new(c.X, Config.GroundY + 0.5, c.Z + 24) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(235, 60, 60),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(18, 0, 7, 0)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.MaxDistance = 260
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 200, 200)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = "\u{1F680} MISSILE BATTERY\nOpen the Attack menu to fire"
	label.Parent = gui
	gui.Parent = pad

	slot.batteryFolder = folder
	slot.batteryLaunchPositions = launchPositions
end

function BatteryService.showIsland(slot, visible)
	if not slot.batteryFolder then
		return
	end
	slot.batteryFolder.Parent = visible and slot.folder or nil
end

local function batteryDamage(profile)
	local level = profile.batteryLevel or 1
	return math.floor(Config.Battery.BaseDamage * Config.Battery.DamageGrowth ^ (level - 1))
end

local function impactBatteryMissile(attackerUserId, targetUserId, pos, damage, isLast)
	local target = Players:GetPlayerByUserId(targetUserId)
	local attacker = Players:GetPlayerByUserId(attackerUserId)
	if not target then
		return
	end
	local slot = ctx.Plot.getSlot(target)
	if not slot then
		return
	end
	if ctx.Defense and ctx.Defense.tryIntercept(slot, "missile", pos) then
		return
	end
	local worth, count, popLost = ctx.Plot.applyBlast(slot, pos, damage)
	if count &gt; 0 and attacker then
		ctx.Economy.addCash(attacker, worth)
		local aProfile = ctx.Data.get(attacker)
		if aProfile then
			aProfile.stats.stolen += worth
		end
		ctx.Economy.pushState(attacker)
	end
	if isLast then
		notify(target, "\u{1F680} A MISSILE BATTERY volley hit your city!", "bad")
		ctx.Economy.pushState(target)
	end
end

local function onRequestBattery(player, targetUserId)
	if type(targetUserId) ~= "number" then
		return
	end
	local session = ctx.session[player]
	local profile = ctx.Data.get(player)
	local mySlot = ctx.Plot.getSlot(player)
	if not session or not profile or not mySlot then
		return
	end
	if not profile.batteryUnlocked then
		notify(player, "\u{1F680} Buy the Missile Battery first!", "bad")
		return
	end
	if now() &lt; (session.batteryReadyAt or 0) then
		notify(player, "\u{1F680} Battery reloading! " .. NumberFormat.clock((session.batteryReadyAt or 0) - now()), "bad")
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		notify(player, "That player isn't here!", "bad")
		return
	end
	local targetSlot = ctx.Plot.getSlot(target)
	if not targetSlot or ctx.Plot.isImmune(targetSlot) then
		notify(player, "\u{1F6E1}\u{FE0F} That city is protected right now!", "bad")
		return
	end

	session.batteryReadyAt = now() + Config.Battery.Cooldown
	local damage = batteryDamage(profile)
	local launches = mySlot.batteryLaunchPositions or {}
	local minX, minZ, maxX, maxZ = Layout.plotBounds(targetSlot.index)

	for i = 1, Config.Battery.Volley do
		local from = launches[((i - 1) % #launches) + 1] or Layout.batteryIslandCenter(mySlot.index)
		-- Random spread across the enemy city (no aiming).
		local pos = Vector3.new(rng:NextNumber(minX, maxX), Layout.GroundY, rng:NextNumber(minZ, maxZ))
		local flight = Config.Rocket.FlightTime + rng:NextNumber(0, 2)
		Remotes.Events.MissileEvent:FireAllClients({
			kind = "rocket",
			from = from,
			to = pos,
			flight = flight,
			attacker = player.DisplayName,
			previewFor = (i == 1) and player.UserId or nil,
		})
		task.delay(flight, impactBatteryMissile, player.UserId, target.UserId, pos, damage, i == Config.Battery.Volley)
	end

	Remotes.Events.Alarm:FireClient(target, {
		kind = "battery",
		pos = Layout.plotCenter(targetSlot.index),
		eta = Config.Rocket.FlightTime,
	})
	announceBattery(player, target)
	ctx.Economy.pushState(player)
end

local function onUpgradeBattery(player)
	local profile = ctx.Data.get(player)
	if not profile or not profile.batteryUnlocked then
		return
	end
	local lvl = profile.batteryLevel or 1
	if lvl &gt;= Config.Battery.MaxLevel then
		notify(player, "\u{1F680} Battery is max level!", "info")
		return
	end
	local cost = math.floor(Config.Battery.BaseUpgradeCost * Config.Battery.CostGrowth ^ (lvl - 1))
	if not ctx.Economy.trySpend(player, cost) then
		notify(player, "Battery upgrade costs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
		return
	end
	profile.batteryLevel = lvl + 1
	notify(player, "\u{1F680} Missile Battery upgraded to Lv" .. profile.batteryLevel .. "!", "buy")
	ctx.Economy.pushState(player)
end

function BatteryService.init(context)
	ctx = context
	for _, slot in ipairs(ctx.World.slots) do
		BatteryService.buildIsland(slot)
		BatteryService.showIsland(slot, false)
	end
	Remotes.Events.RequestBattery.OnServerEvent:Connect(onRequestBattery)
	Remotes.Events.UpgradeBattery.OnServerEvent:Connect(onUpgradeBattery)
end

return BatteryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">BuildingVisuals</string><ProtectedString name="Source">-- Renders a zone's buildings for its level. Styles:
--   houses   - little homes with pitched wedge roofs
--   towers   - city blocks with glowing windows + rooftop details
--   panels   - solar/container fields
--   turbines - wind turbines
-- Plus the smoking rubble state. Deterministic per (plot, zone).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DecorSets = require(Shared.DecorSets)
local StoreModels = require(script.Parent.StoreModels)

local BuildingVisuals = {}

local SUB_OFFSETS = {
	Vector3.new(-10, 0, -10),
	Vector3.new(10, 0, 10),
	Vector3.new(10, 0, -10),
	Vector3.new(-10, 0, 10),
}

local WINDOW_COLOR = Color3.fromRGB(255, 236, 160)

local SMOOTH_MATERIALS = {
	[Enum.Material.Neon] = true,
	[Enum.Material.Glass] = true,
	[Enum.Material.ForceField] = true,
	[Enum.Material.DiamondPlate] = true,
	[Enum.Material.Metal] = true,
}

local function applySurfaces(p, smooth)
	local s = smooth and Enum.SurfaceType.Smooth or Enum.SurfaceType.Studs
	p.TopSurface = s
	p.BottomSurface = s
	p.LeftSurface = s
	p.RightSurface = s
	p.FrontSurface = s
	p.BackSurface = s
end

-- Buildings are classic studded bricks (Plastic + Studs) unless the material
-- should stay smooth (glass windows, neon signs, metal) or props.Smooth is set.
local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	local mat = props.Material or Enum.Material.Plastic
	if mat == Enum.Material.SmoothPlastic then
		mat = Enum.Material.Plastic
	end
	local smooth = props.Smooth or SMOOTH_MATERIALS[mat]
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Smooth" and k ~= "Material" then
			p[k] = v
		end
	end
	p.Material = mat
	applySurfaces(p, smooth)
	p.Parent = props.Parent
	return p
end

local function wedge(props)
	local p = Instance.new("WedgePart")
	p.Anchored = true
	local mat = props.Material or Enum.Material.Plastic
	if mat == Enum.Material.SmoothPlastic then
		mat = Enum.Material.Plastic
	end
	local smooth = props.Smooth or SMOOTH_MATERIALS[mat]
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Smooth" and k ~= "Material" then
			p[k] = v
		end
	end
	p.Material = mat
	applySurfaces(p, smooth)
	p.Parent = props.Parent
	return p
end

local function lighten(color, amt)
	return Color3.new(math.min(color.R + amt, 1), math.min(color.G + amt, 1), math.min(color.B + amt, 1))
end

-- Parts are already studded on every face via part(); this is now a no-op
-- kept so existing call sites keep working.
local function studBrick(p)
	return p
end

local function darken(color, amt)
	return Color3.new(math.max(color.R - amt, 0), math.max(color.G - amt, 0), math.max(color.B - amt, 0))
end

-- Buildings use clean studded Plastic (like the reference) except glass and
-- metal towers, which keep their material for shine.
local KEEP_MATERIAL = { Glass = true, Metal = true }
local function materialOf(def)
	if def.material and KEEP_MATERIAL[def.material] then
		return Enum.Material[def.material]
	end
	return Enum.Material.Plastic
end

-- Little homes with pitched roofs (houses / apartments).
local function renderHouses(model, def, level, center, rng)
	local count = math.clamp(1 + math.floor(level / 12), 1, 4)
	local roofColor = darken(def.color, 0.25)
	for i = 1, count do
		local off = SUB_OFFSETS[i]
		local w = 11 + rng:NextNumber() * 2
		local h = 5 + math.min(level, 60) * 0.12
		local base = Vector3.new(center.X + off.X, Config.GroundY, center.Z + off.Z)
		local yaw = (i % 2 == 0) and math.rad(90) or 0
		local cf = CFrame.new(base) * CFrame.Angles(0, yaw, 0)

		studBrick(part({
			Name = "HouseBody",
			Size = Vector3.new(w, h, w),
			CFrame = cf * CFrame.new(0, h / 2, 0),
			Color = def.color,
			Material = materialOf(def),
			Parent = model,
		}))
		-- Pitched roof from two wedges.
		wedge({
			Name = "RoofA",
			Size = Vector3.new(w + 1, 3, (w + 1) / 2),
			CFrame = cf * CFrame.new(0, h + 1.5, (w + 1) / 4),
			Color = roofColor,
			Material = Enum.Material.Slate,
			Parent = model,
		})
		wedge({
			Name = "RoofB",
			Size = Vector3.new(w + 1, 3, (w + 1) / 2),
			CFrame = cf * CFrame.new(0, h + 1.5, -(w + 1) / 4) * CFrame.Angles(0, math.pi, 0),
			Color = roofColor,
			Material = Enum.Material.Slate,
			Parent = model,
		})
		part({
			Name = "Door",
			Size = Vector3.new(2.4, 3.6, 0.4),
			CFrame = cf * CFrame.new(0, 1.8, w / 2 + 0.15),
			Color = Color3.fromRGB(92, 64, 40),
			Material = Enum.Material.Wood,
			Parent = model,
		})
		for _, wx in ipairs({ -w / 4 - 0.4, w / 4 + 0.6 }) do
			part({
				Name = "Window",
				Size = Vector3.new(2.2, 2, 0.3),
				CFrame = cf * CFrame.new(wx, h - 1.6, w / 2 + 0.12),
				Color = WINDOW_COLOR,
				Material = Enum.Material.Neon,
				Smooth = true,
				Transparency = 0.1,
				Parent = model,
			})
		end
		-- Brick chimney with a little smoke.
		local chim = part({
			Name = "Chimney",
			Size = Vector3.new(1.6, 3.5, 1.6),
			CFrame = cf * CFrame.new(w / 3, h + 2.5, -w / 4),
			Color = darken(def.color, 0.15),
			Parent = model,
		})
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Rate = 3
		smoke.Lifetime = NumberRange.new(1, 2)
		smoke.Size = NumberSequence.new(1.5)
		smoke.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		})
		smoke.Speed = NumberRange.new(2, 4)
		smoke.Color = ColorSequence.new(Color3.fromRGB(210, 210, 210))
		smoke.Parent = chim
	end
end

-- Adds a grid of glowing window squares up a tower face. Random lit/dark
-- windows give the "real city building" look from the reference.
local function windowGrid(model, base, h, faceCF, faceWidth, rng)
	local floorH = 3.2
	-- Cap floors so tall towers don't spawn thousands of window parts.
	local floors = math.clamp(math.floor((h - 2) / floorH), 1, 8)
	local cols = 2
	local winW = faceWidth / (cols + 1)
	for f = 0, floors - 1 do
		local y = 2 + f * floorH + floorH / 2 - h / 2
		for c = 1, cols do
			local x = -faceWidth / 2 + c * (faceWidth / (cols + 1))
			local lit = rng:NextNumber() &gt; 0.35
			local win = part({
				Name = "Win",
				Size = Vector3.new(winW * 0.7, floorH * 0.6, 0.3),
				CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * faceCF * CFrame.new(x, y, 0),
				Color = lit and WINDOW_COLOR or Color3.fromRGB(70, 90, 120),
				Material = lit and Enum.Material.Neon or Enum.Material.Glass,
				Smooth = true,
				Parent = model,
			})
			win.Transparency = lit and 0.05 or 0.35
		end
	end
end

local function renderTowers(model, def, level, center, rng)
	local count = math.clamp(1 + math.floor(level / 15), 1, 4)
	for i = 1, count do
		local off = SUB_OFFSETS[i]
		local h = math.min(12 + math.min(level, Config.BuildingMaxLevel) * 0.7 * (0.85 + rng:NextNumber() * 0.3), 44)
		local base = Vector3.new(center.X + off.X, Config.GroundY, center.Z + off.Z)
		local w = 15

		studBrick(part({
			Name = "Tower",
			Size = Vector3.new(w, h, w),
			Position = base + Vector3.new(0, h / 2, 0),
			Color = def.color,
			Material = materialOf(def),
			Reflectance = def.material == "Glass" and 0.15 or 0,
			Parent = model,
		}), true)

		-- Window grid on all four faces.
		local faces = {
			CFrame.new(0, 0, w / 2 + 0.16),
			CFrame.new(0, 0, -w / 2 - 0.16) * CFrame.Angles(0, math.pi, 0),
			CFrame.new(w / 2 + 0.16, 0, 0) * CFrame.Angles(0, math.rad(90), 0),
			CFrame.new(-w / 2 - 0.16, 0, 0) * CFrame.Angles(0, math.rad(-90), 0),
		}
		for _, fcf in ipairs(faces) do
			windowGrid(model, base, h, fcf, w, rng)
		end

		-- Colored roof trim (parapet) around the top.
		part({
			Name = "Trim",
			Size = Vector3.new(w + 0.8, 1.2, w + 0.8),
			Position = base + Vector3.new(0, h + 0.6, 0),
			Color = lighten(def.color, 0.25),
			Material = level &gt;= 30 and Enum.Material.Neon or Enum.Material.Plastic,
			Parent = model,
		})
		-- Rooftop details.
		part({
			Name = "RoofBox",
			Size = Vector3.new(4, 2.4, 4),
			Position = base + Vector3.new(3, h + 2.4, 3),
			Color = Color3.fromRGB(120, 120, 128),
			Material = Enum.Material.Metal,
			Parent = model,
		})
		part({
			Name = "WaterTank",
			Size = Vector3.new(3, 3, 3),
			Position = base + Vector3.new(-3.5, h + 2.7, -3),
			Color = Color3.fromRGB(150, 120, 90),
			Parent = model,
		})
		if i == 1 then
			part({
				Name = "Antenna",
				Size = Vector3.new(0.4, 8, 0.4),
				Position = base + Vector3.new(-4, h + 5.5, -4),
				Color = Color3.fromRGB(200, 60, 60),
				Material = Enum.Material.Neon,
				Smooth = true,
				Parent = model,
			})
		end
	end
end

local function renderPanels(model, def, level, center, rng)
	local rows = math.clamp(2 + math.floor(level / 10), 2, 6)
	for i = 1, rows do
		local rowIdx = math.ceil(i / 2)
		local side = (i % 2 == 0) and 1 or -1
		local pos = Vector3.new(center.X + side * 9, Config.GroundY + 2.2, center.Z - 14 + rowIdx * 8)
		part({
			Name = "Panel",
			Size = Vector3.new(14, 0.6, 7),
			CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(-18), 0, 0),
			Color = def.color,
			Material = materialOf(def),
			Reflectance = 0.25,
			Parent = model,
		})
		part({
			Name = "PanelLeg",
			Size = Vector3.new(1, 2.4, 1),
			Position = Vector3.new(pos.X, Config.GroundY + 1.2, pos.Z),
			Color = Color3.fromRGB(110, 110, 118),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	-- Control hut with a glowing window.
	part({
		Name = "Hut",
		Size = Vector3.new(7, 5, 7),
		Position = Vector3.new(center.X, Config.GroundY + 2.5, center.Z + 14),
		Color = darken(def.color, 0.15),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	part({
		Name = "HutWindow",
		Size = Vector3.new(3, 1.6, 0.3),
		Position = Vector3.new(center.X, Config.GroundY + 3.4, center.Z + 17.6),
		Color = WINDOW_COLOR,
		Material = Enum.Material.Neon,
		Transparency = 0.2,
		Parent = model,
	})
	local _ = rng
end

local function renderTurbines(model, def, level, center, rng)
	local count = math.clamp(1 + math.floor(level / 12), 1, 4)
	for i = 1, count do
		local off = SUB_OFFSETS[i]
		local h = 18 + math.min(level, 60) * 0.2 + rng:NextNumber() * 2
		local base = Vector3.new(center.X + off.X, Config.GroundY, center.Z + off.Z)
		part({
			Name = "TurbinePole",
			Size = Vector3.new(1.6, h, 1.6),
			Position = base + Vector3.new(0, h / 2, 0),
			Color = Color3.fromRGB(240, 240, 245),
			Material = Enum.Material.SmoothPlastic,
			Parent = model,
		})
		local hub = base + Vector3.new(0, h, 1.2)
		part({
			Name = "TurbineHub",
			Size = Vector3.new(2.4, 2.4, 2.4),
			Position = hub,
			Color = def.color,
			Parent = model,
		})
		for b = 0, 2 do
			local ang = math.rad(b * 120 + rng:NextNumber() * 40)
			part({
				Name = "Blade",
				Size = Vector3.new(0.8, 9, 0.4),
				CFrame = CFrame.new(hub) * CFrame.Angles(0, 0, ang) * CFrame.new(0, 5.5, 0),
				Color = Color3.fromRGB(240, 240, 245),
				Parent = model,
			})
		end
	end
end

local function addSmoke(model, center)
	local smokePart = part({
		Name = "SmokeSource",
		Size = Vector3.new(4, 1, 4),
		Position = center + Vector3.new(0, 2, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(70, 70, 70), Color3.fromRGB(120, 120, 120))
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 3),
		NumberSequenceKeypoint.new(1, 8),
	})
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Lifetime = NumberRange.new(1.2, 2.2)
	smoke.Rate = 8
	smoke.Speed = NumberRange.new(3, 6)
	smoke.SpreadAngle = Vector2.new(18, 18)
	smoke.Parent = smokePart
	local fire = Instance.new("Fire")
	fire.Size = 8
	fire.Heat = 10
	fire.Parent = smokePart
end

-- Drop a Store-model clone so its feet touch the ground, facing the road.
local function groundSnap(clone, x, z)
	local bbCF, bbSize = clone:GetBoundingBox()
	local pivotY = clone:GetPivot().Position.Y
	local feet = pivotY - (bbCF.Position.Y - bbSize.Y / 2)
	local pos = Vector3.new(x, Config.GroundY + feet, z)
	clone:PivotTo(CFrame.lookAt(pos, Vector3.new(x, pos.Y, z + 60)))
end

-- Render with a real Creator Store model. Returns false to fall back to parts.
local function renderStore(container, def, level, center, rng)
	if not Config.UseStoreBuildings then
		return false
	end
	local set = DecorSets.Buildings[def.id]
	if not set then
		return false
	end
	local entry = StoreModels.get("bld_" .. def.id, set.ids, { size = set.size, byHeight = set.byHeight })
	if not entry then
		return false
	end
	-- Buildings physically grow as they level up.
	local growth = 0.82 + 0.38 * math.min(level, Config.BuildingMaxLevel) / Config.BuildingMaxLevel
	if set.mode == "single" then
		local clone = entry.model:Clone()
		local ok = pcall(function()
			clone:ScaleTo(entry.scale * growth)
		end)
		if not ok then
			clone:Destroy()
			return false
		end
		clone.Parent = container
		groundSnap(clone, center.X, center.Z)
	else
		local count = math.clamp(1 + math.floor(level / 12), 1, 4)
		for i = 1, count do
			local off = SUB_OFFSETS[i]
			local clone = entry.model:Clone()
			pcall(function()
				clone:ScaleTo(entry.scale * growth * (0.9 + rng:NextNumber() * 0.2))
			end)
			clone.Parent = container
			groundSnap(clone, center.X + off.X, center.Z + off.Z)
		end
	end
	return true
end

local function renderStoreRubble(container, center)
	if not Config.UseStoreBuildings then
		return false
	end
	local entry = StoreModels.get("rubble", DecorSets.Rubble, { size = 30 })
	if not entry then
		return false
	end
	local clone = entry.model:Clone()
	clone.Parent = container
	groundSnap(clone, center.X, center.Z)
	addSmoke(container, center)
	return true
end

-- Warm the template cache (called once at startup, off the main thread).
function BuildingVisuals.preload()
	if not Config.UseStoreBuildings then
		return
	end
	for defId, set in pairs(DecorSets.Buildings) do
		StoreModels.get("bld_" .. defId, set.ids, { size = set.size, byHeight = set.byHeight })
	end
	StoreModels.get("rubble", DecorSets.Rubble, { size = 30 })
end

local function renderRubble(model, def, center, rng)
	for i = 1, 5 do
		local off = Vector3.new((rng:NextNumber() - 0.5) * 26, 0, (rng:NextNumber() - 0.5) * 26)
		local size = Vector3.new(6 + rng:NextNumber() * 8, 2 + rng:NextNumber() * 3, 6 + rng:NextNumber() * 8)
		part({
			Name = "Rubble",
			Size = size,
			CFrame = CFrame.new(center + off + Vector3.new(0, size.Y / 2, 0))
				* CFrame.Angles(0, rng:NextNumber() * math.pi, math.rad((rng:NextNumber() - 0.5) * 20)),
			Color = (i % 2 == 0) and Color3.fromRGB(52, 50, 48) or Color3.fromRGB(72, 66, 60),
			Material = Enum.Material.Slate,
			Parent = model,
		})
	end
	addSmoke(model, center)
	local _ = def
end

function BuildingVisuals.render(container, def, level, plotIndex, zoneIndex, center, destroyed)
	container:ClearAllChildren()
	local rng = Random.new(plotIndex * 1000 + zoneIndex * 17)
	local ground = Vector3.new(center.X, Config.GroundY, center.Z)
	if destroyed then
		if not renderStoreRubble(container, ground) then
			renderRubble(container, def, ground, rng)
		end
	elseif level &gt; 0 then
		-- Real Creator Store buildings first; part-built visuals as fallback.
		if renderStore(container, def, level, ground, rng) then
			return
		end
		if def.style == "houses" then
			renderHouses(container, def, level, ground, rng)
		elseif def.style == "panels" then
			renderPanels(container, def, level, ground, rng)
		elseif def.style == "turbines" then
			renderTurbines(container, def, level, ground, rng)
		else
			renderTowers(container, def, level, ground, rng)
		end
	end
end

return BuildingVisuals
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">CitizensService</string><ProtectedString name="Source">-- Small citizen avatars (real R15 rigs, scaled down) that walk the road
-- network of every occupied island, following intersection-to-intersection
-- paths with walk animations.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)

local CitizensService = {}

local WALK_ANIM = "rbxassetid://507777826" -- Roblox default R15 walk
local MAX_CITIZENS = 12
local MAX_CARS = 6

local CAR_COLORS = {
	Color3.fromRGB(220, 60, 60), Color3.fromRGB(60, 110, 220), Color3.fromRGB(240, 200, 60),
	Color3.fromRGB(90, 90, 100), Color3.fromRGB(230, 230, 235), Color3.fromRGB(80, 180, 90),
}

local ctx
local rng = Random.new()
local folder
local carFolder
local citizens = {} -- [slotIndex] = { {model, alive}, ... }
local cars = {} -- [slotIndex] = { {model, alive}, ... }

-- Population/citizen/car counts scale with how many buildings the city has.
local function builtZones(slot)
	local n = 0
	for _, zone in pairs(slot.zones) do
		if zone.level &gt; 0 and not zone.destroyed then
			n += 1
		end
	end
	return n
end

local function targetCitizens(slot)
	return math.clamp(2 + builtZones(slot), 2, MAX_CITIZENS)
end

local function targetCars(slot)
	local n = builtZones(slot)
	if n &lt; 3 then
		return 0
	end
	return math.clamp(math.floor(n / 2), 1, MAX_CARS)
end

local SHIRT_COLORS = {
	Color3.fromRGB(235, 60, 60), Color3.fromRGB(60, 150, 240), Color3.fromRGB(88, 200, 60),
	Color3.fromRGB(250, 200, 60), Color3.fromRGB(190, 90, 240), Color3.fromRGB(255, 140, 60),
}

local function makeCitizenModel()
	local desc = Instance.new("HumanoidDescription")
	desc.HeightScale = 0.65
	desc.WidthScale = 0.7
	desc.HeadScale = 0.95
	local shirt = SHIRT_COLORS[rng:NextInteger(1, #SHIRT_COLORS)]
	local pants = SHIRT_COLORS[rng:NextInteger(1, #SHIRT_COLORS)]
	desc.TorsoColor = shirt
	desc.LeftArmColor = shirt
	desc.RightArmColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	desc.HeadColor = Color3.fromRGB(255, 204, 148)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	return model
end

local function startWalking(record, slotIndex)
	task.spawn(function()
		local model = record.model
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		humanoid.WalkSpeed = 7

		-- Walk animation looped forever (citizens never stop strolling).
		pcall(function()
			local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
			local anim = Instance.new("Animation")
			anim.AnimationId = WALK_ANIM
			local track = animator:LoadAnimation(anim)
			track.Looped = true
			track:Play()
		end)

		-- Random walk over the road intersection grid.
		local ix = rng:NextInteger(1, #Layout.RoadXs)
		local iz = rng:NextInteger(1, #Layout.RoadZs)
		while record.alive and model.Parent do
			-- Step to a random adjacent intersection.
			if rng:NextNumber() &lt; 0.5 then
				ix = math.clamp(ix + (rng:NextNumber() &lt; 0.5 and -1 or 1), 1, #Layout.RoadXs)
			else
				iz = math.clamp(iz + (rng:NextNumber() &lt; 0.5 and -1 or 1), 1, #Layout.RoadZs)
			end
			local target = Layout.intersection(slotIndex, ix, iz)
			humanoid:MoveTo(target)
			local reached = false
			local conn = humanoid.MoveToFinished:Once(function()
				reached = true
			end)
			local waited = 0
			while not reached and waited &lt; 10 and record.alive do
				task.wait(0.25)
				waited += 0.25
			end
			conn:Disconnect()
			task.wait(rng:NextNumber(0.2, 1.2))
		end
	end)
end

local function spawnCitizen(slot)
	local model = makeCitizenModel()
	if not model then
		return nil
	end
	model.Name = "Citizen_" .. slot.index
	local spawnPos = Layout.intersection(slot.index, rng:NextInteger(1, #Layout.RoadXs), rng:NextInteger(1, #Layout.RoadZs))
	model.Parent = folder
	model:PivotTo(CFrame.new(spawnPos + Vector3.new(0, 4, 0)))

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)
	end

	local record = { model = model, alive = true }
	startWalking(record, slot.index)
	return record
end

local function clearIsland(slotIndex)
	local list = citizens[slotIndex]
	if list then
		for _, record in ipairs(list) do
			record.alive = false
			record.model:Destroy()
		end
		citizens[slotIndex] = nil
	end
	local clist = cars[slotIndex]
	if clist then
		for _, record in ipairs(clist) do
			record.alive = false
			record.model:Destroy()
		end
		cars[slotIndex] = nil
	end
end

-- Simple blocky car that drives the road grid.
local function makeCar()
	local model = Instance.new("Model")
	local color = CAR_COLORS[rng:NextInteger(1, #CAR_COLORS)]
	local function p(name, size, off, c)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Anchored = true
		piece.CanCollide = false
		piece.Size = size
		piece.Color = c
		piece.Material = Enum.Material.SmoothPlastic
		piece.Parent = model
		piece.CFrame = CFrame.new(off)
		return piece
	end
	local body = p("Body", Vector3.new(4, 1.6, 8), Vector3.new(0, 1.2, 0), color)
	p("Cabin", Vector3.new(3.4, 1.4, 4), Vector3.new(0, 2.5, -0.5), color)
	p("Glass", Vector3.new(3.5, 1.1, 4.1), Vector3.new(0, 2.6, -0.5), Color3.fromRGB(120, 180, 220))
	for _, wx in ipairs({ -1.8, 1.8 }) do
		for _, wz in ipairs({ -2.6, 2.6 }) do
			local w = p("Wheel", Vector3.new(0.7, 1.4, 1.4), Vector3.new(wx, 0.7, wz), Color3.fromRGB(30, 30, 30))
			w.Shape = Enum.PartType.Cylinder
			w.CFrame = CFrame.new(wx, 0.7, wz) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
	model.PrimaryPart = body
	return model
end

local function driveCar(record, slotIndex)
	task.spawn(function()
		local model = record.model
		local ix = rng:NextInteger(1, #Layout.RoadXs)
		local iz = rng:NextInteger(1, #Layout.RoadZs)
		local pos = Layout.intersection(slotIndex, ix, iz) + Vector3.new(0, 1.5, 0)
		while record.alive and model.Parent do
			if rng:NextNumber() &lt; 0.5 then
				ix = math.clamp(ix + (rng:NextNumber() &lt; 0.5 and -1 or 1), 1, #Layout.RoadXs)
			else
				iz = math.clamp(iz + (rng:NextNumber() &lt; 0.5 and -1 or 1), 1, #Layout.RoadZs)
			end
			local target = Layout.intersection(slotIndex, ix, iz) + Vector3.new(0, 1.5, 0)
			local dist = (target - pos).Magnitude
			local speed = 22
			local dur = math.max(dist / speed, 0.2)
			local t0 = os.clock()
			local startPos = pos
			while record.alive and os.clock() - t0 &lt; dur do
				local a = (os.clock() - t0) / dur
				local p = startPos:Lerp(target, a)
				model:PivotTo(CFrame.lookAt(p, target))
				task.wait()
			end
			pos = target
			task.wait(rng:NextNumber(0.1, 0.5))
		end
	end)
end

local function spawnCar(slot)
	local model = makeCar()
	model.Name = "Car_" .. slot.index
	model.Parent = carFolder
	local start = Layout.intersection(slot.index, rng:NextInteger(1, #Layout.RoadXs), rng:NextInteger(1, #Layout.RoadZs))
	model:PivotTo(CFrame.new(start + Vector3.new(0, 1.5, 0)))
	local record = { model = model, alive = true }
	driveCar(record, slot.index)
	return record
end

function CitizensService.init(context)
	ctx = context
	folder = Instance.new("Folder")
	folder.Name = "Citizens"
	folder.Parent = workspace
	carFolder = Instance.new("Folder")
	carFolder.Name = "Cars"
	carFolder.Parent = workspace

	task.spawn(function()
		while true do
			task.wait(5)
			for _, slot in ipairs(ctx.Plot.slots()) do
				if slot.owner then
					-- Citizens scale with city size.
					local list = citizens[slot.index]
					if not list then
						list = {}
						citizens[slot.index] = list
					end
					for i = #list, 1, -1 do
						if not list[i].model.Parent then
							table.remove(list, i)
						end
					end
					local wantP = targetCitizens(slot)
					if #list &lt; wantP then
						local record = spawnCitizen(slot)
						if record then
							list[#list + 1] = record
						end
					elseif #list &gt; wantP then
						local rec = table.remove(list)
						if rec then
							rec.alive = false
							rec.model:Destroy()
						end
					end

					-- Cars appear once the city has a few buildings.
					local clist = cars[slot.index]
					if not clist then
						clist = {}
						cars[slot.index] = clist
					end
					for i = #clist, 1, -1 do
						if not clist[i].model.Parent then
							table.remove(clist, i)
						end
					end
					local wantC = targetCars(slot)
					if #clist &lt; wantC then
						clist[#clist + 1] = spawnCar(slot)
					elseif #clist &gt; wantC then
						local rec = table.remove(clist)
						if rec then
							rec.alive = false
							rec.model:Destroy()
						end
					end
				elseif citizens[slot.index] or cars[slot.index] then
					clearIsland(slot.index)
				end
			end
		end
	end)
end

return CitizensService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">CombatService</string><ProtectedString name="Source">-- Rockets and nukes: validation, cooldowns, flights, impacts, payouts.
-- Clients only render FX; every gameplay decision happens here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local CombatService = {}

local ctx

local function now()
	return os.clock()
end

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function notifyAll(msg, kind)
	Remotes.Events.Notify:FireAllClients({ msg = msg, kind = kind or "info" })
end

local function siloLaunchPos(plotIndex, siloIndex)
	return Layout.siloPos(plotIndex, siloIndex or 1) + Vector3.new(0, 16, 0)
end

-- Spread pattern for multi-rocket volleys.
local SALVO_OFFSETS = {
	Vector3.new(0, 0, 0), Vector3.new(18, 0, 10), Vector3.new(-16, 0, 14),
	Vector3.new(10, 0, -16), Vector3.new(-14, 0, -12), Vector3.new(24, 0, -4),
	Vector3.new(-24, 0, 2), Vector3.new(4, 0, 22), Vector3.new(-6, 0, -24),
}

local function rocketDamage(player)
	local profile = ctx.Data.get(player)
	local level = profile and profile.rocketLevel or 1
	return math.floor(Config.Rocket.BaseDamage * Config.Rocket.DamageGrowth ^ (level - 1))
		* ctx.Economy.damageMultiplier(player)
end

local function impactRocket(attackerUserId, targetUserId, pos, damage)
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target then
		return
	end
	local slot = ctx.Plot.getSlot(target)
	if not slot then
		return
	end
	local attacker = Players:GetPlayerByUserId(attackerUserId)

	local profile = ctx.Data.get(target)
	if profile and profile.shields &gt; 0 then
		profile.shields -= 1
		Remotes.Events.ShieldFX:FireAllClients(slot.index, pos)
		notify(target, "\u{1F6E1}\u{FE0F} Your shield blocked a missile!", "good")
		if attacker then
			notify(attacker, "\u{1F6E1}\u{FE0F} " .. target.DisplayName .. "'s shield blocked your missile!", "bad")
		end
		ctx.Economy.pushState(target)
		return
	end

	-- Air defense may shoot the missile down before impact.
	if ctx.Defense and ctx.Defense.tryIntercept(slot, "missile", pos) then
		notify(target, "\u{1F6E1}\u{FE0F} Your air defense intercepted an incoming missile!", "good")
		if attacker then
			notify(attacker, "\u{1F6E1}\u{FE0F} " .. target.DisplayName .. "'s air defense shot down your missile!", "bad")
		end
		return
	end

	local worth, count, popLost = ctx.Plot.applyBlast(slot, pos, damage)
	if count &gt; 0 and attacker then
		ctx.Economy.addCash(attacker, worth)
		local aProfile = ctx.Data.get(attacker)
		if aProfile then
			aProfile.stats.stolen += worth
		end
		if ctx.Quests then
			ctx.Quests.onEvent(attacker, "destroy", count)
		end
		notify(attacker, "\u{1F4A5} Destroyed " .. count .. " buildings! +\u{1F4B5} "
			.. NumberFormat.abbrev(worth), "victory")
		notify(target, "\u{1F4A5} " .. attacker.DisplayName .. "'s missile destroyed "
			.. count .. " buildings! \u{1F465} -" .. NumberFormat.abbrev(popLost) .. " people", "bad")
		ctx.Economy.pushState(attacker)
	elseif attacker then
		notify(attacker, "\u{1F4A8} Missile hit, but nothing was destroyed...", "info")
	end
	ctx.Economy.pushState(target)
end

local function impactNuke(attackerUserId, targetUserId)
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target then
		return
	end
	local slot = ctx.Plot.getSlot(target)
	if not slot then
		return
	end
	local attacker = Players:GetPlayerByUserId(attackerUserId)

	local worth = ctx.Plot.nukeSlot(slot)
	if attacker then
		ctx.Economy.addCash(attacker, worth)
		local aProfile = ctx.Data.get(attacker)
		if aProfile then
			aProfile.stats.stolen += worth
		end
		notify(attacker, "\u{2622}\u{FE0F} DIRECT HIT! You stole \u{1F4B5} "
			.. NumberFormat.abbrev(worth) .. "!", "victory")
		ctx.Economy.pushState(attacker)
	end
	notify(target, "\u{2622}\u{FE0F} Your city was NUKED! It will rebuild itself over the next few minutes.", "bad")
	notifyAll("\u{2622}\u{FE0F} " .. (attacker and attacker.DisplayName or "Someone")
		.. " NUKED " .. target.DisplayName .. "'s city for \u{1F4B5} " .. NumberFormat.abbrev(worth) .. "!")
	ctx.Economy.pushState(target)
end

local function onRequestLaunch(player, targetUserId, x, z, useNuke, useBarrage)
	if type(targetUserId) ~= "number" or type(x) ~= "number" or type(z) ~= "number" then
		return
	end
	local session = ctx.session[player]
	local profile = ctx.Data.get(player)
	local mySlot = ctx.Plot.getSlot(player)
	if not session or not profile or not mySlot then
		return
	end

	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		notify(player, "That player isn't here anymore!", "bad")
		return
	end
	local targetSlot = ctx.Plot.getSlot(target)
	if not targetSlot then
		notify(player, "That player has no city!", "bad")
		return
	end
	if ctx.Plot.isImmune(targetSlot) then
		notify(player, "\u{1F6E1}\u{FE0F} " .. target.DisplayName .. " is protected right now!", "bad")
		return
	end

	local pos = Layout.clampToPlot(targetSlot.index, Vector3.new(x, 0, z))
	local fromPos = siloLaunchPos(mySlot.index, 1)

	if useNuke then
		local canNuke = profile.nukeIsland or profile.nukeCharges &gt; 0
		if not canNuke then
			notify(player, "\u{2622}\u{FE0F} You need Nuke Access (\u{1F4B5} "
				.. NumberFormat.abbrev(Config.Nuke.IslandCost) .. ") or a free nuke charge!", "bad")
			return
		end
		if os.time() - profile.lastNukeAt &lt; Config.Nuke.Cooldown then
			local wait = Config.Nuke.Cooldown - (os.time() - profile.lastNukeAt)
			notify(player, "\u{2622}\u{FE0F} Nuke ready in " .. NumberFormat.clock(wait) .. " (one per day)!", "bad")
			return
		end
		if not profile.nukeIsland then
			profile.nukeCharges -= 1
		end
		profile.lastNukeAt = os.time()
		profile.stats.nukesFired += 1

		local flight = Config.Nuke.FlightTime
		Remotes.Events.MissileEvent:FireAllClients({
			kind = "nuke",
			from = fromPos,
			to = pos,
			flight = flight,
			attacker = player.DisplayName,
			previewFor = player.UserId,
		})
		Remotes.Events.Alarm:FireClient(target, { kind = "nuke", pos = pos, eta = flight })
		notifyAll("\u{2622}\u{FE0F} " .. player.DisplayName .. " has launched a NUKE at "
			.. target.DisplayName .. "'s city!", "bad")
		task.delay(flight, impactNuke, player.UserId, target.UserId)
		ctx.Plot.setSiloRocket(mySlot, 1, false)
		task.delay(flight + 4, function()
			if ctx.Plot.getSlot(player) == mySlot then
				ctx.Plot.setSiloRocket(mySlot, 1, true)
			end
		end)
		if ctx.Quests then
			ctx.Quests.onEvent(player, "nuke", 1)
		end
	else
		if now() &lt; (session.siloDisabledUntil or 0) then
			notify(player, "\u{2708}\u{FE0F} Your silos were bombed! Rockets offline for "
				.. NumberFormat.clock((session.siloDisabledUntil or 0) - now()), "bad")
			return
		end
		if now() &lt; (session.rocketReadyAt or 0) then
			notify(player, "\u{1F680} Rocket reloading! "
				.. NumberFormat.clock((session.rocketReadyAt or 0) - now()), "bad")
			return
		end
		session.rocketReadyAt = now() + Config.Rocket.Cooldown

		-- One rocket per owned silo; barrage triples the volley.
		local siloCount = math.clamp(profile.siloCount or 1, 1, Config.Silos.Max)
		local salvo = siloCount
		if useBarrage and profile.barrage &gt; 0 then
			profile.barrage -= 1
			salvo = math.min(siloCount * 3, #SALVO_OFFSETS)
		end
		local damage = rocketDamage(player)
		for s = 1, salvo do
			local siloIndex = ((s - 1) % siloCount) + 1
			local hitPos = Layout.clampToPlot(targetSlot.index, pos + SALVO_OFFSETS[s])
			local flight = Config.Rocket.FlightTime + (s - 1) * 0.7
			Remotes.Events.MissileEvent:FireAllClients({
				kind = "rocket",
				from = siloLaunchPos(mySlot.index, siloIndex),
				to = hitPos,
				flight = flight,
				attacker = player.DisplayName,
				previewFor = (s == 1) and player.UserId or nil, -- first rocket = camera
			})
			task.delay(flight, impactRocket, player.UserId, target.UserId, hitPos, damage)
		end
		-- The decorative silo rockets "lift off": hide, then respawn later.
		for i = 1, siloCount do
			ctx.Plot.setSiloRocket(mySlot, i, false)
		end
		task.delay(Config.Rocket.FlightTime + 4, function()
			if ctx.Plot.getSlot(player) == mySlot then
				for i = 1, siloCount do
					ctx.Plot.setSiloRocket(mySlot, i, true)
				end
			end
		end)
		profile.stats.missilesFired += salvo
		if ctx.Quests then
			ctx.Quests.onEvent(player, "missile_launch", 1)
		end
		Remotes.Events.Alarm:FireClient(target, { kind = "rocket", pos = pos, eta = Config.Rocket.FlightTime })
		notify(target, "\u{1F6A8} " .. player.DisplayName .. " launched "
			.. (salvo &gt; 1 and salvo .. " missiles" or "a missile") .. " at your city!", "bad")
	end
	ctx.Economy.pushState(player)
end

local function onUpgradeRocket(player)
	local profile = ctx.Data.get(player)
	if not profile then
		return
	end
	if profile.rocketLevel &gt;= Config.Rocket.MaxLevel then
		notify(player, "\u{1F680} Rocket is max level!", "info")
		return
	end
	local cost = math.floor(Config.Rocket.BaseUpgradeCost * Config.Rocket.CostGrowth ^ (profile.rocketLevel - 1))
	if not ctx.Economy.trySpend(player, cost) then
		notify(player, "Need \u{1F4B5} " .. NumberFormat.abbrev(cost) .. " to upgrade!", "bad")
		return
	end
	profile.rocketLevel += 1
	local slot = ctx.Plot.getSlot(player)
	if slot then
		ctx.Plot.updateRocketVisual(slot, profile.rocketLevel)
	end
	if ctx.Quests then
		ctx.Quests.onEvent(player, "rocket_upgrade", 1)
	end
	notify(player, "\u{1F680} Rocket upgraded to Lv" .. profile.rocketLevel
		.. "! It's bigger and hits harder.", "buy")
	ctx.Economy.pushState(player)
end

function CombatService.init(context)
	ctx = context

	Remotes.Events.RequestLaunch.OnServerEvent:Connect(onRequestLaunch)
	Remotes.Events.UpgradeRocket.OnServerEvent:Connect(onUpgradeRocket)

	Remotes.Functions.GetTargets.OnServerInvoke = function(player)
		local targets = {}
		for _, slot in ipairs(ctx.Plot.slots()) do
			local owner = slot.owner
			if owner and owner ~= player then
				targets[#targets + 1] = {
					userId = owner.UserId,
					name = owner.DisplayName,
					plotIndex = slot.index,
					immune = ctx.Plot.isImmune(slot),
				}
			end
		end
		return targets
	end
end

return CombatService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">CosmeticsService</string><ProtectedString name="Source">-- Character shop cosmetics: speed/jump tiers, overhead titles, rainbow trail.
-- Purchases come through the ShopBuy remote (handled by EconomyService,
-- which calls buy() here); effects are applied on every character spawn.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local CosmeticsService = {}

local ctx

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function titleById(id)
	for _, t in ipairs(Config.Character.Titles) do
		if t.id == id then
			return t
		end
	end
	return nil
end

function CosmeticsService.apply(player, character)
	local profile = ctx.Data.get(player)
	if not profile or not character then
		return
	end
	local cos = profile.cosmetics or {}
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end

	humanoid.WalkSpeed = 16 + (cos.speed or 0) * Config.Character.SpeedPerTier
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 50 + (cos.jump or 0) * Config.Character.JumpPerTier

	-- Overhead title.
	local head = character:FindFirstChild("Head")
	if head and cos.title and cos.title ~= "" then
		local old = head:FindFirstChild("MVC_Title")
		if old then
			old:Destroy()
		end
		local titleDef = titleById(cos.title)
		if titleDef then
			local gui = Instance.new("BillboardGui")
			gui.Name = "MVC_Title"
			gui.Size = UDim2.new(12, 0, 2.4, 0)
			gui.StudsOffset = Vector3.new(0, 2.4, 0)
			gui.AlwaysOnTop = true
			gui.MaxDistance = 200
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(255, 215, 80)
			label.TextStrokeColor3 = Color3.new(0, 0, 0)
			label.TextStrokeTransparency = 0
			label.Text = titleDef.label
			label.Parent = gui
			gui.Parent = head
		end
	end

	-- Rainbow trail.
	if cos.trail then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp and not hrp:FindFirstChild("MVC_Trail") then
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, 1, 0)
			a0.Parent = hrp
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -1, 0)
			a1.Parent = hrp
			local trail = Instance.new("Trail")
			trail.Name = "MVC_Trail"
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.6
			trail.WidthScale = NumberSequence.new(1, 0)
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 220, 90)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 160, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 90, 240)),
			})
			trail.Parent = hrp
		end
	end
end

local function reapply(player)
	if player.Character then
		CosmeticsService.apply(player, player.Character)
	end
end

-- Returns true if the itemId was a cosmetics purchase (handled here).
function CosmeticsService.buy(player, itemId)
	local profile = ctx.Data.get(player)
	if not profile then
		return false
	end
	profile.cosmetics = profile.cosmetics or { speed = 0, jump = 0, trail = false, title = "" }
	local cos = profile.cosmetics

	if itemId == "cos_speed" then
		local tier = (cos.speed or 0) + 1
		local cost = Config.Character.SpeedCosts[tier]
		if not cost then
			notify(player, "\u{1F45F} Speed is already maxed!", "info")
		elseif ctx.Economy.trySpendGems(player, cost) then
			cos.speed = tier
			reapply(player)
			notify(player, "\u{1F45F} Speed boost tier " .. tier .. " equipped!", "buy")
		else
			notify(player, "Need \u{1F48E} " .. cost .. " gems!", "bad")
		end
		return true
	elseif itemId == "cos_jump" then
		local tier = (cos.jump or 0) + 1
		local cost = Config.Character.JumpCosts[tier]
		if not cost then
			notify(player, "\u{1F998} Jump is already maxed!", "info")
		elseif ctx.Economy.trySpendGems(player, cost) then
			cos.jump = tier
			reapply(player)
			notify(player, "\u{1F998} Jump boost tier " .. tier .. " equipped!", "buy")
		else
			notify(player, "Need \u{1F48E} " .. cost .. " gems!", "bad")
		end
		return true
	elseif itemId == "cos_trail" then
		if cos.trail then
			notify(player, "\u{1F308} You already have the rainbow trail!", "info")
		elseif ctx.Economy.trySpendGems(player, Config.Character.TrailCost) then
			cos.trail = true
			reapply(player)
			notify(player, "\u{1F308} Rainbow trail equipped!", "buy")
		else
			notify(player, "Need \u{1F48E} " .. Config.Character.TrailCost .. " gems!", "bad")
		end
		return true
	elseif itemId:sub(1, 10) == "cos_title_" then
		local titleId = itemId:sub(11)
		local titleDef = titleById(titleId)
		if not titleDef then
			return true
		end
		if cos.title == titleId then
			notify(player, "That title is already equipped!", "info")
		elseif ctx.Economy.trySpendGems(player, titleDef.cost) then
			cos.title = titleId
			reapply(player)
			notify(player, "\u{1F3F7}\u{FE0F} Title equipped: " .. titleDef.label, "buy")
		else
			notify(player, "Need \u{1F48E} " .. titleDef.cost .. " gems!", "bad")
		end
		return true
	end
	return false
end

function CosmeticsService.init(context)
	ctx = context
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			task.wait(0.2)
			CosmeticsService.apply(player, character)
		end)
	end)
end

return CosmeticsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">DataService</string><ProtectedString name="Source">-- DataStore persistence with retries and graceful degradation: if DataStores
-- are unavailable (unpublished place / Studio without API access) the game
-- still runs, it just won't save.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("MVC_PlayerData_v1")
	end)
	if ok then
		store = result
	else
		warn("[MVC] DataStores unavailable, running without saving: " .. tostring(result))
	end
end

local profiles = {} -- [player] = profile

local function defaultProfile()
	return {
		cash = Config.StartingCash,
		gems = Config.StartingGems,
		buildings = { house = 1 },
		unlocked = 1, -- how many zone areas of the island are unlocked
		rocketLevel = 1,
		siloCount = 1,
		autoCollect = false,
		hangars = 0,
		jetLevel = 1,
		defenseLevel = 0,
		batteryUnlocked = false,
		batteryLevel = 1,
		shields = 0,
		barrage = 0,
		nukeIsland = false,
		nukeCharges = 0,
		lastNukeAt = 0,
		rebirths = 0,
		cosmetics = { speed = 0, jump = 0, trail = false, title = "" },
		quests = {},
		daily = { streak = 0, lastClaimAt = 0 },
		stats = { nukesFired = 0, missilesFired = 0, stolen = 0 },
	}
end

local function mergeInto(base, saved)
	for k, v in pairs(saved) do
		if type(v) == "table" and type(base[k]) == "table" then
			mergeInto(base[k], v)
		else
			base[k] = v
		end
	end
end

local function key(player)
	return "u_" .. player.UserId
end

function DataService.load(player)
	local profile = defaultProfile()
	if store then
		local loaded = nil
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				loaded = result
				profile.__loadOk = true
				break
			end
			if attempt &lt; 3 then
				task.wait(1.5 * attempt)
			end
		end
		if type(loaded) == "table" then
			mergeInto(profile, loaded)
			profile.__loadOk = true
		end
	end
	if not profile.__loadOk and store then
		-- Never overwrite real data with defaults after a failed load.
		profile.__noSave = true
		warn("[MVC] Failed to load data for " .. player.Name .. "; running session-only.")
	end
	profiles[player] = profile
	return profile
end

function DataService.get(player)
	return profiles[player]
end

local function snapshot(profile)
	local copy = {}
	for k, v in pairs(profile) do
		if type(k) == "string" and k:sub(1, 2) ~= "__" then
			if type(v) == "table" then
				local inner = {}
				for k2, v2 in pairs(v) do
					inner[k2] = v2
				end
				copy[k] = inner
			else
				copy[k] = v
			end
		end
	end
	return copy
end

function DataService.save(player)
	local profile = profiles[player]
	if not profile or not store or profile.__noSave then
		return false
	end
	local data = snapshot(profile)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function()
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("[MVC] Save attempt " .. attempt .. " failed for " .. player.Name .. ": " .. tostring(err))
		if attempt &lt; 3 then
			task.wait(2 * attempt)
		end
	end
	return false
end

function DataService.forget(player)
	profiles[player] = nil
end

function DataService.available()
	return store ~= nil
end

function DataService.allPlayers()
	return profiles
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">DecorService</string><ProtectedString name="Source">-- Inserts real Roblox Creator Store models (trees, benches, lamps, fountain,
-- rocks, a car) onto every island, plus a community skybox. Everything is
-- pcall-guarded: if an asset fails to load (offline Studio, moderated id),
-- the game keeps its built-in part decorations instead.
--
-- SECURITY: every script inside inserted free models is destroyed before the
-- model touches the world.

local InsertService = game:GetService("InsertService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local DecorSets = require(Shared.DecorSets)

local DecorService = {}

local templates = {} -- [category] = sanitized template Model or false

local function sanitize(model)
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("LuaSourceContainer") or obj:IsA("Sound") or obj:IsA("RemoteEvent")
			or obj:IsA("RemoteFunction") or obj:IsA("Fire") and obj.Size &gt; 15 then
			obj:Destroy()
		end
	end
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored = true
		end
	end
end

local function loadTemplate(category)
	if templates[category] ~= nil then
		return templates[category] or nil
	end
	for _, id in ipairs(DecorSets.Models[category] or {}) do
		local ok, asset = pcall(function()
			return InsertService:LoadAsset(id)
		end)
		if ok and asset then
			local model = asset:FindFirstChildWhichIsA("Model")
			if not model then
				-- Wrap loose parts in a Model.
				model = Instance.new("Model")
				for _, child in ipairs(asset:GetChildren()) do
					child.Parent = model
				end
			end
			sanitize(model)
			if #model:GetDescendants() &gt; 0 then
				-- Normalize to the target size for this category.
				local okBB, bbCF, bbSize = pcall(function()
					local cf, size = model:GetBoundingBox()
					return cf, size
				end)
				if okBB and bbSize then
					local target = DecorSets.TargetSize[category] or 8
					local current = (category == "tree" or category == "lamp") and bbSize.Y
						or math.max(bbSize.X, bbSize.Z)
					if current &gt; 0.5 then
						local scale = math.clamp(target / current, 0.02, 30)
						pcall(function()
							model:ScaleTo(scale)
						end)
					end
					model.Parent = nil
					templates[category] = model
					asset:Destroy()
					return model
				end
			end
			asset:Destroy()
		end
	end
	warn("[MVC] No Store model loaded for decor category: " .. category)
	templates[category] = false
	return nil
end

local function place(category, position, folder, faceTowards)
	local template = loadTemplate(category)
	if not template then
		return
	end
	local clone = template:Clone()
	clone.Name = "Decor_" .. category
	clone.Parent = folder

	local bbCF, bbSize = clone:GetBoundingBox()
	local pivotY = clone:GetPivot().Position.Y
	local feetOffset = pivotY - (bbCF.Position.Y - bbSize.Y / 2)
	local pos = Vector3.new(position.X, Config.GroundY + feetOffset, position.Z)
	if faceTowards then
		clone:PivotTo(CFrame.lookAt(pos, Vector3.new(faceTowards.X, pos.Y, faceTowards.Z)))
	else
		clone:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	end
end

local function decorateIsland(slot, folder)
	local c = Layout.plotCenter(slot.index)
	local half = Config.PlotSize / 2
	local townZ = c.Z + half

	-- Town square: fountain centerpiece, benches facing it, lamps, greenery.
	place("fountain", Vector3.new(c.X, 0, townZ + 40), folder)
	place("bench", Vector3.new(c.X - 22, 0, townZ + 32), folder, Vector3.new(c.X, 0, townZ + 40))
	place("bench", Vector3.new(c.X + 22, 0, townZ + 32), folder, Vector3.new(c.X, 0, townZ + 40))
	place("lamp", Vector3.new(c.X - 58, 0, townZ + 12), folder)
	place("lamp", Vector3.new(c.X + 58, 0, townZ + 12), folder)
	place("tree", Vector3.new(c.X - 122, 0, townZ + 48), folder)
	place("tree", Vector3.new(c.X + 122, 0, townZ + 50), folder)
	place("bush", Vector3.new(c.X - 100, 0, townZ + 52), folder)
	place("bush", Vector3.new(c.X + 100, 0, townZ + 52), folder)

	-- Island edges: trees, bushes, rocks along the fence line.
	place("tree", Vector3.new(c.X - 122, 0, c.Z - 20), folder)
	place("tree", Vector3.new(c.X + 122, 0, c.Z + 30), folder)
	place("bush", Vector3.new(c.X - 122, 0, c.Z + 60), folder)
	place("bush", Vector3.new(c.X + 122, 0, c.Z - 60), folder)
	place("rock", Vector3.new(c.X - 122, 0, c.Z - 120), folder)
	place("rock", Vector3.new(c.X + 122, 0, c.Z - 116), folder)

	-- A parked car at the roadside.
	place("car", Vector3.new(c.X + 58, 0, c.Z - 40), folder, Vector3.new(c.X + 58, 0, c.Z + 40))
end

local function applySky()
	for _, id in ipairs(DecorSets.Sky) do
		local ok, asset = pcall(function()
			return InsertService:LoadAsset(id)
		end)
		if ok and asset then
			sanitize(asset)
			local sky = asset:FindFirstChildWhichIsA("Sky", true)
			if sky then
				-- Replace any existing skybox.
				for _, old in ipairs(Lighting:GetChildren()) do
					if old:IsA("Sky") then
						old:Destroy()
					end
				end
				sky.Parent = Lighting
				asset:Destroy()
				return
			end
			asset:Destroy()
		end
	end
	warn("[MVC] No Store skybox loaded; keeping the default sky.")
end

function DecorService.init(ctx)
	if Config.UseStoreSky then
		task.spawn(applySky)
	end
	if Config.UseStoreDecor == false then
		return
	end
	task.spawn(function()
		local folder = Instance.new("Folder")
		folder.Name = "StoreDecor"
		folder.Parent = workspace
		for _, slot in ipairs(ctx.World.slots) do
			decorateIsland(slot, folder)
			task.wait() -- spread the work out
		end
	end)
end

return DecorService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">DefenseService</string><ProtectedString name="Source">-- Air defense: turret models on the island that give a chance to intercept
-- incoming missiles and jets. More levels = more turrets + higher chance.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Remotes = require(Shared.Remotes)

local DefenseService = {}

local ctx
local rng = Random.new()

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function buildTurret(pos, parent)
	local model = Instance.new("Model")
	model.Name = "Turret"
	part({
		Name = "Base",
		Size = Vector3.new(5, 2, 5),
		Position = pos + Vector3.new(0, 1, 0),
		Color = Color3.fromRGB(70, 80, 70),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local dome = part({
		Name = "Dome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3.5, 3.5, 3.5),
		Position = pos + Vector3.new(0, 3, 0),
		Color = Color3.fromRGB(90, 110, 90),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	-- Twin barrels angled up.
	for _, dx in ipairs({ -0.8, 0.8 }) do
		part({
			Name = "Barrel",
			Size = Vector3.new(0.6, 0.6, 6),
			CFrame = CFrame.new(pos + Vector3.new(dx, 4, 1.5)) * CFrame.Angles(math.rad(-35), 0, 0),
			Color = Color3.fromRGB(40, 45, 40),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	model.PrimaryPart = dome
	model.Parent = parent
	return model
end

-- Turret count grows with defense level (1 turret per 3 levels, up to 4).
local function turretCount(level)
	if level &lt;= 0 then
		return 0
	end
	return math.clamp(1 + math.floor((level - 1) / 3), 1, 4)
end

function DefenseService.updateTurrets(slot, level)
	slot.turrets = slot.turrets or {}
	local want = turretCount(level)
	-- Remove extras.
	for i = #slot.turrets, want + 1, -1 do
		slot.turrets[i]:Destroy()
		slot.turrets[i] = nil
	end
	-- Add missing.
	for i = #slot.turrets + 1, want do
		slot.turrets[i] = buildTurret(Layout.defensePos(slot.index, i), slot.folder)
	end
end

function DefenseService.interceptChance(level, kind)
	if level &lt;= 0 then
		return 0
	end
	local per = (kind == "jet") and Config.Defense.JetChancePerLevel or Config.Defense.MissileChancePerLevel
	return math.min(level * per, Config.Defense.MaxChance)
end

-- Rolls interception; on success plays flak FX above the city.
function DefenseService.tryIntercept(slot, kind, pos)
	if not slot.owner then
		return false
	end
	local profile = ctx.Data.get(slot.owner)
	local level = profile and profile.defenseLevel or 0
	if level &lt;= 0 then
		return false
	end
	if rng:NextNumber() &lt;= DefenseService.interceptChance(level, kind) then
		Remotes.Events.GameEvent:FireAllClients({
			kind = "intercept",
			pos = pos or Layout.plotCenter(slot.index),
		})
		return true
	end
	return false
end

function DefenseService.init(context)
	ctx = context
end

return DefenseService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">-- Income ticks, cash/gems, state pushes to clients, leaderstats,
-- the free-gift timer, the gem shop and gamepass hooks.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local BuildingDefs = require(Shared.BuildingDefs)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local Layout = require(Shared.Layout)

local EconomyService = {}

local ctx

local function now()
	return os.clock()
end

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

function EconomyService.addCash(player, amount)
	local profile = ctx.Data.get(player)
	if profile then
		profile.cash += amount
	end
end

function EconomyService.trySpend(player, amount)
	local profile = ctx.Data.get(player)
	if not profile or profile.cash &lt; amount then
		return false
	end
	profile.cash -= amount
	return true
end

function EconomyService.addGems(player, amount)
	local profile = ctx.Data.get(player)
	if profile then
		profile.gems += amount
	end
end

function EconomyService.trySpendGems(player, amount)
	local profile = ctx.Data.get(player)
	if not profile or profile.gems &lt; amount then
		return false
	end
	profile.gems -= amount
	return true
end

function EconomyService.cashMultiplier(player)
	local session = ctx.session[player]
	local profile = ctx.Data.get(player)
	local mult = (session and session.passCash) and 2 or 1
	-- Permanent rebirth bonus (+100% per rebirth) and temporary event boosts.
	if profile then
		mult *= 1 + (profile.rebirths or 0) * Config.Rebirth.IncomePerRebirth
	end
	mult *= ctx.eventCashMult or 1
	return mult
end

function EconomyService.rebirthCost(profile)
	return Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ (profile.rebirths or 0)
end

-- Number of distinct building types currently owned (for quest stats).
local function distinctBuildings(slot)
	local count = 0
	for _, zone in pairs(slot.zones) do
		if zone.level &gt; 0 then
			count += 1
		end
	end
	return count
end

function EconomyService.damageMultiplier(player)
	local session = ctx.session[player]
	return (session and session.passDamage) and 2 or 1
end

function EconomyService.getIncomePerSec(player)
	local slot = ctx.Plot.getSlot(player)
	if not slot then
		return 0
	end
	local total = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 and not zone.destroyed then
			total += BuildingDefs.income(def, zone.level)
		end
	end
	return total * EconomyService.cashMultiplier(player)
end

function EconomyService.pushState(player)
	local profile = ctx.Data.get(player)
	local session = ctx.session[player]
	if not profile or not session then
		return
	end
	local slot = ctx.Plot.getSlot(player)
	local rocketLevel = profile.rocketLevel
	local stats = slot and {
		cash = profile.cash,
		worth = ctx.Plot.cityWorth(slot),
		rocket_level = rocketLevel,
		buildings = distinctBuildings(slot),
	} or nil
	local snapshot = {
		cash = profile.cash,
		gems = profile.gems,
		income = EconomyService.getIncomePerSec(player),
		worth = slot and ctx.Plot.cityWorth(slot) or 0,
		plotIndex = slot and slot.index or 0,
		rebirths = profile.rebirths or 0,
		rebirthCost = EconomyService.rebirthCost(profile),
		quests = ctx.Quests and ctx.Quests.getSummary(player, stats) or nil,
		cosmetics = profile.cosmetics,
		rocketLevel = rocketLevel,
		rocketCost = rocketLevel &lt; Config.Rocket.MaxLevel
			and math.floor(Config.Rocket.BaseUpgradeCost * Config.Rocket.CostGrowth ^ (rocketLevel - 1))
			or 0,
		rocketDamage = math.floor(Config.Rocket.BaseDamage * Config.Rocket.DamageGrowth ^ (rocketLevel - 1))
			* EconomyService.damageMultiplier(player),
		rocketRemaining = math.max(0, (session.rocketReadyAt or 0) - now()),
		siloCount = profile.siloCount or 1,
		nextSiloCost = Config.Silos.Costs[(profile.siloCount or 1) + 1] or 0,
		autoCollect = profile.autoCollect or false,
		autoCollectCost = Config.AutoCollectCost,
		population = slot and ctx.Plot.population(slot) or 0,
		hangars = profile.hangars or 0,
		nextHangarCost = Config.Jets.HangarCosts[(profile.hangars or 0) + 1] or 0,
		jetLevel = profile.jetLevel or 1,
		jetCost = (profile.jetLevel or 1) &lt; Config.Jets.MaxLevel
			and math.floor(Config.Jets.BaseUpgradeCost * Config.Jets.CostGrowth ^ ((profile.jetLevel or 1) - 1)) or 0,
		jetRemaining = math.max(0, (session.jetReadyAt or 0) - now()),
		hasAirport = slot and slot.zones[Layout.AirportZoneIndex]
			and slot.zones[Layout.AirportZoneIndex].level &gt; 0 or false,
		defenseLevel = profile.defenseLevel or 0,
		defenseCost = (profile.defenseLevel or 0) &lt; Config.Defense.MaxLevel
			and math.floor(Config.Defense.BaseCost * Config.Defense.CostGrowth ^ (profile.defenseLevel or 0)) or 0,
		batteryUnlocked = profile.batteryUnlocked or false,
		batteryCost = Config.Battery.UnlockCost,
		batteryLevel = profile.batteryLevel or 1,
		batteryUpgradeCost = (profile.batteryLevel or 1) &lt; Config.Battery.MaxLevel
			and math.floor(Config.Battery.BaseUpgradeCost * Config.Battery.CostGrowth ^ ((profile.batteryLevel or 1) - 1)) or 0,
		batteryRemaining = math.max(0, (session.batteryReadyAt or 0) - now()),
		siloDisabledRemaining = math.max(0, (session.siloDisabledUntil or 0) - now()),
		isAdmin = ctx.isAdmin and ctx.isAdmin(player) or false,
		nukeOwned = profile.nukeIsland,
		nukeCharges = profile.nukeCharges,
		nukeRemaining = math.max(0, profile.lastNukeAt + Config.Nuke.Cooldown - os.time()),
		shields = profile.shields,
		barrage = profile.barrage,
		giftRemaining = math.max(0, (session.giftReadyAt or 0) - now()),
		daily = ctx.Rewards.getData(player),
		passes = { cash2x = session.passCash or false, dmg2x = session.passDamage or false },
	}
	Remotes.Events.State:FireClient(player, snapshot)
end

local function updateLeaderstats(player)
	local profile = ctx.Data.get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not profile or not stats then
		return
	end
	local slot = ctx.Plot.getSlot(player)
	stats.Cash.Value = NumberFormat.abbrev(profile.cash)
	stats.Worth.Value = NumberFormat.abbrev(slot and ctx.Plot.cityWorth(slot) or 0)
end

local function makeLeaderstats(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "0"
	cash.Parent = stats
	local worth = Instance.new("StringValue")
	worth.Name = "Worth"
	worth.Value = "0"
	worth.Parent = stats
	stats.Parent = player
end

local function incomeLoop()
	while true do
		task.wait(Config.IncomeInterval)
		for _, slot in ipairs(ctx.Plot.slots()) do
			local player = slot.owner
			if player then
				local profile = ctx.Data.get(player)
				if profile then
					local mult = EconomyService.cashMultiplier(player)
					local autoCollect = profile.autoCollect
					local autoTotal = 0
					local pops = {}
					for zi, def in ipairs(BuildingDefs.List) do
						local zone = slot.zones[zi]
						if zone.level &gt; 0 and not zone.destroyed then
							local amt = BuildingDefs.income(def, zone.level) * Config.IncomeInterval * mult
							if autoCollect then
								autoTotal += amt
								pops[#pops + 1] = { zi, amt }
							else
								-- Cash piles up at the building until the player
								-- walks over to collect it (cap ~10 min income).
								local cap = BuildingDefs.income(def, zone.level) * mult * 600
								zone.pending = math.min((zone.pending or 0) + amt, cap)
								ctx.Plot.updateCollect(slot, zi)
							end
						end
					end
					if autoCollect and autoTotal &gt; 0 then
						profile.cash += autoTotal
						Remotes.Events.IncomePops:FireAllClients(slot.index, pops)
					end
					slot.bannerLabel.Text = "\u{1F3D9}\u{FE0F} " .. player.DisplayName
						.. "\n\u{1F4B5} " .. NumberFormat.abbrev(ctx.Plot.cityWorth(slot))
						.. "  \u{1F465} " .. NumberFormat.abbrev(ctx.Plot.population(slot))
					updateLeaderstats(player)
					if ctx.Quests then
						ctx.Quests.evaluate(player, {
							cash = profile.cash,
							worth = ctx.Plot.cityWorth(slot),
							rocket_level = profile.rocketLevel,
							buildings = distinctBuildings(slot),
						})
					end
					EconomyService.pushState(player)
				end
			end
		end
	end
end

local function onShopBuy(player, itemId)
	local profile = ctx.Data.get(player)
	local session = ctx.session[player]
	if not profile or not session or type(itemId) ~= "string" then
		return
	end

	-- Character shop items are handled by CosmeticsService.
	if ctx.Cosmetics and ctx.Cosmetics.buy(player, itemId) then
		EconomyService.pushState(player)
		return
	end

	if itemId == "repair_all" then
		local slot = ctx.Plot.getSlot(player)
		if not slot then
			return
		end
		local anyDestroyed = false
		for _, zone in pairs(slot.zones) do
			if zone.destroyed then
				anyDestroyed = true
				break
			end
		end
		if not anyDestroyed then
			notify(player, "Nothing needs repairs!", "info")
			return
		end
		if not EconomyService.trySpendGems(player, Config.Shop.RepairAllGems) then
			notify(player, "Need \u{1F48E} " .. Config.Shop.RepairAllGems .. " gems!", "bad")
			return
		end
		local count = ctx.Plot.repairAll(slot)
		notify(player, "\u{1F527} Instantly rebuilt " .. count .. " buildings!", "good")
	elseif itemId == "skip_cooldown" then
		if (session.rocketReadyAt or 0) &lt;= now() then
			notify(player, "Your rocket is already ready!", "info")
			return
		end
		if not EconomyService.trySpendGems(player, Config.Shop.SkipCooldownGems) then
			notify(player, "Need \u{1F48E} " .. Config.Shop.SkipCooldownGems .. " gems!", "bad")
			return
		end
		session.rocketReadyAt = 0
		notify(player, "\u{1F680} Rocket ready!", "good")
	elseif itemId == "shield" then
		if not EconomyService.trySpendGems(player, Config.Shop.ShieldGems) then
			notify(player, "Need \u{1F48E} " .. Config.Shop.ShieldGems .. " gems!", "bad")
			return
		end
		profile.shields += 1
		notify(player, "\u{1F6E1}\u{FE0F} Shield armed! Blocks the next missile strike.", "good")
	elseif itemId == "barrage" then
		if not EconomyService.trySpendGems(player, Config.Shop.BarrageGems) then
			notify(player, "Need \u{1F48E} " .. Config.Shop.BarrageGems .. " gems!", "bad")
			return
		end
		profile.barrage += 1
		notify(player, "\u{1F680}\u{1F680}\u{1F680} Barrage loaded! Your next launch fires 3 rockets.", "good")
	elseif itemId == "buy_silo" then
		local count = profile.siloCount or 1
		local cost = Config.Silos.Costs[count + 1]
		if not cost then
			notify(player, "\u{1F680} You already have the maximum " .. Config.Silos.Max .. " silos!", "info")
			return
		end
		if not EconomyService.trySpend(player, cost) then
			notify(player, "Silo " .. (count + 1) .. " costs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
			return
		end
		profile.siloCount = count + 1
		local slot = ctx.Plot.getSlot(player)
		if slot then
			ctx.Plot.updateSilos(slot, profile.siloCount)
		end
		notify(player, "\u{1F680} SILO " .. profile.siloCount .. " BUILT! You now fire "
			.. profile.siloCount .. " rockets per launch!", "victory")
	elseif itemId == "auto_collect" then
		if profile.autoCollect then
			notify(player, "\u{1F4B0} You already have Auto-Collect!", "info")
			return
		end
		if not EconomyService.trySpend(player, Config.AutoCollectCost) then
			notify(player, "Auto-Collect costs \u{1F4B5} " .. NumberFormat.abbrev(Config.AutoCollectCost) .. "!", "bad")
			return
		end
		profile.autoCollect = true
		-- Sweep up whatever's pending right now.
		local slot = ctx.Plot.getSlot(player)
		if slot then
			ctx.Plot.collectAll(player, slot)
		end
		notify(player, "\u{1F4B0} AUTO-COLLECT unlocked! Income now goes straight to your wallet.", "victory")
	elseif itemId == "buy_defense" then
		local lvl = profile.defenseLevel or 0
		if lvl &gt;= Config.Defense.MaxLevel then
			notify(player, "\u{1F6E1}\u{FE0F} Air defense is max level!", "info")
			return
		end
		local cost = math.floor(Config.Defense.BaseCost * Config.Defense.CostGrowth ^ lvl)
		if not EconomyService.trySpend(player, cost) then
			notify(player, "Air defense upgrade costs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
			return
		end
		profile.defenseLevel = lvl + 1
		local slot = ctx.Plot.getSlot(player)
		if slot and ctx.Defense then
			ctx.Defense.updateTurrets(slot, profile.defenseLevel)
		end
		notify(player, "\u{1F6E1}\u{FE0F} AIR DEFENSE Lv" .. profile.defenseLevel
			.. "! Better chance to shoot down incoming missiles &amp; jets.", "victory")
	elseif itemId == "buy_hangar" then
		local slot = ctx.Plot.getSlot(player)
		if not slot or not slot.zones[Layout.AirportZoneIndex] or slot.zones[Layout.AirportZoneIndex].level &lt;= 0 then
			notify(player, "\u{2708}\u{FE0F} Build an Airport first to buy hangars!", "bad")
			return
		end
		local count = profile.hangars or 0
		local cost = Config.Jets.HangarCosts[count + 1]
		if not cost then
			notify(player, "\u{2708}\u{FE0F} You already have the max " .. Config.Jets.MaxHangars .. " hangars!", "info")
			return
		end
		if not EconomyService.trySpend(player, cost) then
			notify(player, "Hangar " .. (count + 1) .. " costs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
			return
		end
		profile.hangars = count + 1
		if ctx.Jets then
			ctx.Jets.updateHangars(slot, profile.hangars)
		end
		notify(player, "\u{2708}\u{FE0F} HANGAR " .. profile.hangars .. " BUILT! Launch " .. profile.hangars .. " jets per strike!", "victory")
	elseif itemId == "upgrade_jet" then
		local lvl = profile.jetLevel or 1
		if lvl &gt;= Config.Jets.MaxLevel then
			notify(player, "\u{2708}\u{FE0F} Jets are max level!", "info")
			return
		end
		local cost = math.floor(Config.Jets.BaseUpgradeCost * Config.Jets.CostGrowth ^ (lvl - 1))
		if not EconomyService.trySpend(player, cost) then
			notify(player, "Jet upgrade costs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
			return
		end
		profile.jetLevel = lvl + 1
		notify(player, "\u{2708}\u{FE0F} JETS upgraded to Lv" .. profile.jetLevel .. "!", "buy")
	elseif itemId == "buy_battery" then
		if profile.batteryUnlocked then
			notify(player, "\u{1F680} You already own the Missile Battery!", "info")
			return
		end
		if not EconomyService.trySpend(player, Config.Battery.UnlockCost) then
			notify(player, "The Missile Battery costs \u{1F4B5} " .. NumberFormat.abbrev(Config.Battery.UnlockCost) .. "!", "bad")
			return
		end
		profile.batteryUnlocked = true
		local slot = ctx.Plot.getSlot(player)
		if slot and ctx.Battery then
			ctx.Battery.showIsland(slot, true)
		end
		notify(player, "\u{1F680} MISSILE BATTERY built on your side island! Fires " .. Config.Battery.Volley .. " missiles at once.", "victory")
	elseif itemId == "pass_cash" then
		if Config.GamePassCash2x &gt; 0 then
			MarketplaceService:PromptGamePassPurchase(player, Config.GamePassCash2x)
		else
			notify(player, "2X CASH gamepass isn't configured yet (see Config.luau).", "info")
		end
	elseif itemId == "pass_damage" then
		if Config.GamePassDamage2x &gt; 0 then
			MarketplaceService:PromptGamePassPurchase(player, Config.GamePassDamage2x)
		else
			notify(player, "2X DAMAGE gamepass isn't configured yet (see Config.luau).", "info")
		end
	end
	EconomyService.pushState(player)
end

local function onClaimGift(player)
	local session = ctx.session[player]
	local profile = ctx.Data.get(player)
	if not session or not profile then
		return
	end
	if now() &lt; (session.giftReadyAt or 0) then
		notify(player, "\u{1F381} Gift isn't ready yet!", "bad")
		return
	end
	session.giftReadyAt = now() + Config.GiftInterval
	local cashGift = math.max(1000, EconomyService.getIncomePerSec(player) * 300)
	profile.gems += Config.GiftGems
	profile.cash += cashGift
	notify(player, "\u{1F381} Gift claimed! +\u{1F48E} " .. Config.GiftGems
		.. " and +\u{1F4B5} " .. NumberFormat.abbrev(cashGift) .. "!", "victory")
	EconomyService.pushState(player)
end

function EconomyService.onJoin(player)
	makeLeaderstats(player)
	local session = ctx.session[player]
	session.giftReadyAt = now() + Config.GiftInterval
	session.rocketReadyAt = 0

	if Config.GamePassCash2x &gt; 0 then
		task.spawn(function()
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.GamePassCash2x)
			end)
			if ok and owns then
				session.passCash = true
				EconomyService.pushState(player)
			end
		end)
	end
	if Config.GamePassDamage2x &gt; 0 then
		task.spawn(function()
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.GamePassDamage2x)
			end)
			if ok and owns then
				session.passDamage = true
				EconomyService.pushState(player)
			end
		end)
	end
end

function EconomyService.init(context)
	ctx = context

	Remotes.Events.ShopBuy.OnServerEvent:Connect(onShopBuy)
	Remotes.Events.ClaimGift.OnServerEvent:Connect(onClaimGift)

	Remotes.Events.RequestRebirth.OnServerEvent:Connect(function(player)
		local profile = ctx.Data.get(player)
		local slot = ctx.Plot.getSlot(player)
		if not profile or not slot then
			return
		end
		local cost = EconomyService.rebirthCost(profile)
		if profile.cash &lt; cost then
			notify(player, "\u{1F31F} Rebirth needs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
			return
		end
		profile.rebirths = (profile.rebirths or 0) + 1
		profile.cash = Config.StartingCash
		ctx.Plot.resetBuildings(player)
		local mult = 1 + profile.rebirths * Config.Rebirth.IncomePerRebirth
		notify(player, "\u{1F31F} REBIRTH " .. profile.rebirths .. "! Permanent income x" .. mult .. "!", "victory")
		Remotes.Events.Notify:FireAllClients({
			msg = "\u{1F31F} " .. player.DisplayName .. " was REBORN! Their income is now x" .. mult .. "!",
			kind = "info",
		})
		EconomyService.pushState(player)
	end)

	Remotes.Functions.GetSnapshot.OnServerInvoke = function(player)
		if ctx.Data.get(player) and ctx.session[player] then
			EconomyService.pushState(player)
			return true
		end
		return false
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local session = ctx.session[player]
		if not purchased or not session then
			return
		end
		if passId == Config.GamePassCash2x then
			session.passCash = true
			notify(player, "\u{1F4B5} 2X CASH activated!", "victory")
		elseif passId == Config.GamePassDamage2x then
			session.passDamage = true
			notify(player, "\u{1F4A5} 2X DAMAGE activated!", "victory")
		end
		EconomyService.pushState(player)
	end)

	task.spawn(incomeLoop)
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">EventsService</string><ProtectedString name="Source">-- Random world events on a timer: Cash Frenzy, Gem Rain, Meteor Shower,
-- Supply Drop. Keeps servers lively and unpredictable.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local EventsService = {}

local ctx
local rng = Random.new()

local function announce(kind, msg, duration)
	Remotes.Events.GameEvent:FireAllClients({ kind = kind, msg = msg, duration = duration or 0 })
end

local function notify(player, msg, kindName)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kindName or "info" })
end

local function cashFrenzy()
	announce("frenzy", "\u{1F4B8} CASH FRENZY! All income x" .. Config.Events.FrenzyMult
		.. " for " .. Config.Events.FrenzyDuration .. " seconds!", Config.Events.FrenzyDuration)
	ctx.eventCashMult = Config.Events.FrenzyMult
	task.delay(Config.Events.FrenzyDuration, function()
		ctx.eventCashMult = 1
	end)
end

local function gemRain()
	announce("gems", "\u{1F48E} GEM RAIN! Everyone gets +" .. Config.Events.GemRainAmount .. " gems!", 6)
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = ctx.Data.get(player)
		if profile then
			profile.gems += Config.Events.GemRainAmount
			ctx.Economy.pushState(player)
		end
	end
end

local function meteorShower()
	local occupied = {}
	for _, slot in ipairs(ctx.Plot.slots()) do
		if slot.owner and not ctx.Plot.isImmune(slot) then
			occupied[#occupied + 1] = slot
		end
	end
	if #occupied == 0 then
		return
	end
	announce("meteor", "\u{2604}\u{FE0F} METEOR SHOWER! Small meteors are falling on cities!", 14)

	for i = 1, Config.Events.MeteorCount do
		task.delay(1 + i * 1.2, function()
			local slot = occupied[rng:NextInteger(1, #occupied)]
			if not slot.owner then
				return
			end
			local minX, minZ, maxX, maxZ = Layout.plotBounds(slot.index)
			local pos = Vector3.new(rng:NextNumber(minX, maxX), Layout.GroundY, rng:NextNumber(minZ, maxZ))
			local from = pos + Vector3.new(rng:NextNumber(-80, 80), 420, rng:NextNumber(-80, 80))
			local flight = 2.2
			Remotes.Events.MissileEvent:FireAllClients({
				kind = "meteor",
				from = from,
				to = pos,
				flight = flight,
			})
			task.delay(flight, function()
				if slot.owner then
					-- No payout and no shield use for weather damage.
					local _, count = ctx.Plot.applyBlast(slot, pos, Config.Events.MeteorDamage)
					if count &gt; 0 then
						notify(slot.owner, "\u{2604}\u{FE0F} A meteor smashed " .. count .. " of your buildings!", "bad")
					end
				end
			end)
		end)
	end
end

local function supplyDrop()
	local occupied = {}
	for _, slot in ipairs(ctx.Plot.slots()) do
		if slot.owner then
			occupied[#occupied + 1] = slot
		end
	end
	if #occupied == 0 then
		return
	end
	local slot = occupied[rng:NextInteger(1, #occupied)]
	announce("supply", "\u{1F4E6} SUPPLY DROP on " .. slot.owner.DisplayName
		.. "'s island! First one to grab it wins!", 25)

	local c = Layout.plotCenter(slot.index)
	local pos = Vector3.new(
		c.X + rng:NextNumber(-80, 80),
		Config.GroundY + 2,
		c.Z + rng:NextNumber(-80, 80)
	)
	local crate = Instance.new("Part")
	crate.Name = "SupplyDrop"
	crate.Size = Vector3.new(4, 4, 4)
	crate.Position = pos + Vector3.new(0, 60, 0)
	crate.Anchored = true
	crate.Color = Color3.fromRGB(255, 215, 80)
	crate.Material = Enum.Material.Neon
	crate.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(16, 0, 5, 0)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 1000
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 230, 120)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = "\u{1F4E6} SUPPLY DROP!"
	label.Parent = gui
	gui.Parent = crate

	-- Drop animation.
	task.spawn(function()
		for _ = 1, 30 do
			task.wait(0.05)
			if not crate.Parent then
				return
			end
			crate.Position -= Vector3.new(0, 2, 0)
		end
		crate.Position = pos
	end)

	local claimed = false
	crate.Touched:Connect(function(hit)
		if claimed then
			return
		end
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		claimed = true
		local profile = ctx.Data.get(player)
		if profile then
			local cashReward = math.max(5000, ctx.Economy.getIncomePerSec(player) * 60 * Config.Events.SupplyCashMinutes)
			profile.cash += cashReward
			profile.gems += Config.Events.SupplyGems
			announce("supply_claim", "\u{1F4E6} " .. player.DisplayName .. " grabbed the supply drop! (+\u{1F4B5} "
				.. NumberFormat.abbrev(cashReward) .. " +\u{1F48E} " .. Config.Events.SupplyGems .. ")", 5)
			ctx.Economy.pushState(player)
		end
		crate:Destroy()
	end)

	task.delay(60, function()
		if crate.Parent then
			crate:Destroy()
		end
	end)
end

-- Double-gems minute: gifts and gem rewards pay extra (flavour announce).
local function goldRush()
	announce("frenzy", "\u{2728} GOLD RUSH! Collect fast — income x3 for 45s!", 45)
	ctx.eventCashMult = 3
	task.delay(45, function()
		ctx.eventCashMult = 1
	end)
end

local EVENTS = { cashFrenzy, gemRain, meteorShower, supplyDrop, goldRush }

function EventsService.fireRandom()
	local event = EVENTS[rng:NextInteger(1, #EVENTS)]
	task.spawn(event)
end

function EventsService.init(context)
	ctx = context
	ctx.eventCashMult = 1
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(Config.Events.MinInterval, Config.Events.MaxInterval))
			if #Players:GetPlayers() &gt; 0 then
				EventsService.fireRandom()
			end
		end
	end)
end

return EventsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">JetService</string><ProtectedString name="Source">-- Jets: needs an Airport built. Buy hangars (1 jet each), upgrade jets, then
-- strike an enemy city OR their rocket silos. Silo strikes knock the victim's
-- rockets offline for a while. Air defense can shoot jets down.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local JetService = {}

local ctx

local function now()
	return os.clock()
end

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

-- A small hangar with a parked jet, placed near the airport zone.
local function buildHangar(slot, index)
	local airportCenter = Layout.zoneCenter(slot.index, Layout.AirportZoneIndex)
	local pos = airportCenter + Vector3.new((index - 2) * 16, 0, 22)
	local model = Instance.new("Model")
	model.Name = "Hangar" .. index
	part({
		Name = "Pad",
		Size = Vector3.new(14, 0.3, 14),
		Position = pos + Vector3.new(0, 0.2, 0),
		Color = Color3.fromRGB(90, 90, 96),
		Material = Enum.Material.Concrete,
		Parent = model,
	})
	-- Parked jet: body + wings + tail.
	local jet = Instance.new("Model")
	jet.Name = "Jet"
	local body = part({
		Name = "Body",
		Size = Vector3.new(2.4, 2, 10),
		Position = pos + Vector3.new(0, 2, 0),
		Color = Color3.fromRGB(90, 100, 120),
		Material = Enum.Material.Metal,
		Parent = jet,
	})
	part({
		Name = "Nose",
		Size = Vector3.new(1.6, 1.4, 3),
		Position = pos + Vector3.new(0, 2, -6),
		Color = Color3.fromRGB(60, 70, 90),
		Parent = jet,
	})
	part({
		Name = "Wings",
		Size = Vector3.new(12, 0.5, 3),
		Position = pos + Vector3.new(0, 2, 0.5),
		Color = Color3.fromRGB(110, 120, 140),
		Parent = jet,
	})
	part({
		Name = "Tail",
		Size = Vector3.new(0.5, 2.4, 2),
		Position = pos + Vector3.new(0, 3.2, 4),
		Color = Color3.fromRGB(110, 120, 140),
		Parent = jet,
	})
	jet.PrimaryPart = body
	jet.Parent = model
	model.Parent = slot.folder
	return model
end

function JetService.updateHangars(slot, count)
	slot.hangars = slot.hangars or {}
	for i = #slot.hangars, count + 1, -1 do
		slot.hangars[i]:Destroy()
		slot.hangars[i] = nil
	end
	for i = #slot.hangars + 1, count do
		slot.hangars[i] = buildHangar(slot, i)
	end
end

local function jetDamage(profile)
	local level = profile.jetLevel or 1
	return math.floor(Config.Jets.BaseDamage * Config.Jets.DamageGrowth ^ (level - 1))
end

local function jetLaunchPos(slot)
	local c = Layout.zoneCenter(slot.index, Layout.AirportZoneIndex)
	return c + Vector3.new(0, 30, 0)
end

-- mode: "city" (bomb buildings) or "silos" (knock rockets offline)
local function impactJet(attackerUserId, targetUserId, mode, damage)
	local target = Players:GetPlayerByUserId(targetUserId)
	local attacker = Players:GetPlayerByUserId(attackerUserId)
	if not target then
		return
	end
	local slot = ctx.Plot.getSlot(target)
	if not slot then
		return
	end

	if ctx.Defense and ctx.Defense.tryIntercept(slot, "jet", Layout.plotCenter(slot.index)) then
		if attacker then
			notify(attacker, "\u{1F6E1}\u{FE0F} " .. target.DisplayName .. "'s air defense shot down your jet!", "bad")
		end
		notify(target, "\u{1F6E1}\u{FE0F} Your air defense downed an enemy jet!", "good")
		return
	end

	if mode == "silos" then
		local session = ctx.session[target]
		if session then
			session.siloDisabledUntil = now() + Config.Jets.SiloDisable
		end
		-- Visual: briefly hide the victim's silo rockets.
		for i = 1, Config.Silos.Max do
			ctx.Plot.setSiloRocket(slot, i, false)
		end
		task.delay(Config.Jets.SiloDisable, function()
			if ctx.Plot.getSlot(target) == slot then
				local p = ctx.Data.get(target)
				for i = 1, (p and p.siloCount or 1) do
					ctx.Plot.setSiloRocket(slot, i, true)
				end
			end
		end)
		notify(target, "\u{2708}\u{FE0F} Your ROCKET SILOS were bombed! Rockets offline for "
			.. NumberFormat.clock(Config.Jets.SiloDisable) .. "!", "bad")
		if attacker then
			notify(attacker, "\u{2708}\u{FE0F} Direct hit on " .. target.DisplayName
				.. "'s silos! Their rockets are down.", "victory")
			ctx.Economy.pushState(attacker)
		end
		ctx.Economy.pushState(target)
	else
		-- City strike: hit a random spot with a jet-sized blast.
		local minX, minZ, maxX, maxZ = Layout.plotBounds(slot.index)
		local pos = Vector3.new((minX + maxX) / 2, Layout.GroundY, (minZ + maxZ) / 2)
		local worth, count, popLost = ctx.Plot.applyBlast(slot, pos, damage, 46)
		if count &gt; 0 and attacker then
			ctx.Economy.addCash(attacker, worth)
			notify(attacker, "\u{2708}\u{FE0F} Your jets destroyed " .. count .. " buildings! +\u{1F4B5} "
				.. NumberFormat.abbrev(worth), "victory")
			notify(target, "\u{2708}\u{FE0F} " .. attacker.DisplayName .. "'s jets bombed "
				.. count .. " buildings! \u{1F465} -" .. NumberFormat.abbrev(popLost), "bad")
			ctx.Economy.pushState(attacker)
		elseif attacker then
			notify(attacker, "\u{2708}\u{FE0F} Jets bombed the city but nothing was destroyed.", "info")
		end
		ctx.Economy.pushState(target)
	end
end

local function onRequestJet(player, targetUserId, mode)
	if type(targetUserId) ~= "number" then
		return
	end
	mode = (mode == "silos") and "silos" or "city"
	local session = ctx.session[player]
	local profile = ctx.Data.get(player)
	local mySlot = ctx.Plot.getSlot(player)
	if not session or not profile or not mySlot then
		return
	end
	if (profile.hangars or 0) &lt;= 0 then
		notify(player, "\u{2708}\u{FE0F} Build an Airport and a hangar first!", "bad")
		return
	end
	if now() &lt; (session.jetReadyAt or 0) then
		notify(player, "\u{2708}\u{FE0F} Jets rearming! " .. NumberFormat.clock((session.jetReadyAt or 0) - now()), "bad")
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		notify(player, "That player isn't here!", "bad")
		return
	end
	local targetSlot = ctx.Plot.getSlot(target)
	if not targetSlot then
		return
	end
	if ctx.Plot.isImmune(targetSlot) then
		notify(player, "\u{1F6E1}\u{FE0F} " .. target.DisplayName .. " is protected right now!", "bad")
		return
	end

	session.jetReadyAt = now() + Config.Jets.Cooldown
	local hangars = math.clamp(profile.hangars or 1, 1, Config.Jets.MaxHangars)
	local damage = jetDamage(profile)
	local from = jetLaunchPos(mySlot)
	local toCenter = Layout.plotCenter(targetSlot.index)

	for i = 1, hangars do
		local flight = Config.Jets.FlightTime + (i - 1) * 0.5
		Remotes.Events.JetEvent:FireAllClients({
			from = from + Vector3.new((i - 2) * 10, 0, 0),
			to = Vector3.new(toCenter.X, Layout.GroundY + 20, toCenter.Z),
			flight = flight,
			mode = mode,
		})
		task.delay(flight, impactJet, player.UserId, target.UserId, mode, damage)
	end

	Remotes.Events.Alarm:FireClient(target, {
		kind = "jet",
		pos = toCenter,
		eta = Config.Jets.FlightTime,
	})
	notify(target, "\u{2708}\u{FE0F} " .. player.DisplayName .. " is sending " .. hangars
		.. " JET" .. (hangars &gt; 1 and "S" or "") .. " at your "
		.. (mode == "silos" and "rocket silos" or "city") .. "!", "bad")
	ctx.Economy.pushState(player)
end

function JetService.init(context)
	ctx = context
	Remotes.Events.RequestJet.OnServerEvent:Connect(onRequestJet)
end

return JetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Global "Richest Cities of All Time" leaderboard (OrderedDataStore),
-- displayed on a board in EVERY island's town square.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)

local LeaderboardService = {}

local ctx
local store = nil
local boards = {} -- array of { rows = {TextLabel x10} }
local nameCache = {}

local MAX_STORE = 9e15 -- OrderedDataStore integer ceiling safety

do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("MVC_TopWorth_v1")
	end)
	if ok then
		store = result
	else
		warn("[MVC] Leaderboard store unavailable: " .. tostring(result))
	end
end

local function buildBoard(pos)
	local board = Instance.new("Part")
	board.Name = "Leaderboard"
	board.Anchored = true
	board.Size = Vector3.new(20, 12, 1.4)
	board.Position = pos + Vector3.new(0, 7, 0)
	board.Color = Color3.fromRGB(38, 40, 50)
	board.Material = Enum.Material.SmoothPlastic
	board.Parent = workspace

	for _, off in ipairs({ Vector3.new(-8, 0, 0), Vector3.new(8, 0, 0) }) do
		local leg = Instance.new("Part")
		leg.Anchored = true
		leg.Size = Vector3.new(1, 7, 1)
		leg.Position = pos + off + Vector3.new(0, 1.5, 0)
		leg.Color = Color3.fromRGB(110, 110, 118)
		leg.Material = Enum.Material.Metal
		leg.Parent = workspace
	end

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(440, 280)
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 42)
	title.BackgroundColor3 = Color3.fromRGB(235, 60, 60)
	title.BorderSizePixel = 0
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeColor3 = Color3.new(0, 0, 0)
	title.TextStrokeTransparency = 0
	title.Text = "\u{1F3C6} RICHEST CITIES OF ALL TIME \u{1F3C6}"
	title.Parent = gui

	local rows = {}
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, -16, 0, 22)
		row.Position = UDim2.new(0, 8, 0, 44 + (i - 1) * 23)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.FredokaOne
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = i &lt;= 3 and Color3.fromRGB(255, 215, 80) or Color3.new(1, 1, 1)
		row.TextStrokeColor3 = Color3.new(0, 0, 0)
		row.TextStrokeTransparency = 0
		row.Text = i .. ". ..."
		row.Parent = gui
		rows[i] = row
	end
	boards[#boards + 1] = { rows = rows }
end

local function playerName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function setAllRows(i, text)
	for _, board in ipairs(boards) do
		board.rows[i].Text = text
	end
end

local function submitScores()
	if not store then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local slot = ctx.Plot.getSlot(player)
		if slot then
			local worth = math.floor(math.min(ctx.Plot.cityWorth(slot), MAX_STORE))
			if worth &gt; 0 then
				pcall(function()
					store:UpdateAsync(tostring(player.UserId), function(old)
						if old and old &gt;= worth then
							return old
						end
						return worth
					end)
				end)
			end
		end
	end
end

local function refreshBoards()
	if not store then
		for i = 1, 10 do
			setAllRows(i, i .. ". (publish + enable API access)")
		end
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok then
		return
	end
	local top = pages:GetCurrentPage()
	for i = 1, 10 do
		local entry = top[i]
		if entry then
			setAllRows(i, i .. ". " .. playerName(tonumber(entry.key)) .. " — \u{1F4B5} " .. NumberFormat.abbrev(entry.value))
		else
			setAllRows(i, i .. ". ---")
		end
	end
end

function LeaderboardService.init(context)
	ctx = context
	for _, slot in ipairs(ctx.World.slots) do
		buildBoard(slot.boardPos)
	end
	task.spawn(function()
		while true do
			submitScores()
			refreshBoards()
			task.wait(90)
		end
	end)
end

return LeaderboardService
</ProtectedString></Properties></Item><Item class="Script" referent="RBX24"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Missiles vs Cities: server bootstrap.
-- Builds the world, wires the services, manages player lifecycle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
require(Shared.Remotes) -- create remotes before any client can ask for them

local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local BuildingVisuals = require(script.Parent.BuildingVisuals)
local PlotService = require(script.Parent.PlotService)
local EconomyService = require(script.Parent.EconomyService)
local CombatService = require(script.Parent.CombatService)
local RewardsService = require(script.Parent.RewardsService)
local QuestService = require(script.Parent.QuestService)
local EventsService = require(script.Parent.EventsService)
local CosmeticsService = require(script.Parent.CosmeticsService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local CitizensService = require(script.Parent.CitizensService)
local DecorService = require(script.Parent.DecorService)
local NPCBuilder = require(script.Parent.NPCBuilder)
local DefenseService = require(script.Parent.DefenseService)
local JetService = require(script.Parent.JetService)
local BatteryService = require(script.Parent.BatteryService)
local PilotService = require(script.Parent.PilotService)
local AdminService = require(script.Parent.AdminService)

StarterPlayer.CameraMaxZoomDistance = 500
Players.RespawnTime = 3

local world = WorldBuilder.build()
task.spawn(function()
	NPCBuilder.build(world) -- avatar loading yields; don't block startup
end)
task.spawn(function()
	-- Warm the Store building templates, then upgrade any already-built
	-- cities from part visuals to the real models.
	BuildingVisuals.preload()
	PlotService.rerenderAll()
end)

local ctx = {
	Data = DataService,
	Visuals = BuildingVisuals,
	World = world,
	Plot = PlotService,
	Economy = EconomyService,
	Combat = CombatService,
	Rewards = RewardsService,
	Quests = QuestService,
	Events = EventsService,
	Cosmetics = CosmeticsService,
	Leaderboard = LeaderboardService,
	Defense = DefenseService,
	Jets = JetService,
	Battery = BatteryService,
	Pilot = PilotService,
	Admin = AdminService,
	eventCashMult = 1,
	session = {}, -- [player] = { giftReadyAt, rocketReadyAt, passCash, passDamage }
}

PlotService.init(ctx)
EconomyService.init(ctx)
CombatService.init(ctx)
RewardsService.init(ctx)
QuestService.init(ctx)
CosmeticsService.init(ctx)
EventsService.init(ctx)
LeaderboardService.init(ctx)
DefenseService.init(ctx)
JetService.init(ctx)
BatteryService.init(ctx)
PilotService.init(ctx)
AdminService.init(ctx)
CitizensService.init(ctx)
DecorService.init(ctx)

local Remotes = require(Shared.Remotes)

local function onPlayerAdded(player)
	ctx.session[player] = {}
	DataService.load(player)
	if not player.Parent then
		return -- left while loading
	end
	EconomyService.onJoin(player)
	PlotService.assign(player)
	EconomyService.pushState(player)

	-- Make it obvious when progress can't be saved (unpublished / API off).
	local profile = DataService.get(player)
	if profile and (profile.__noSave or not DataService.available()) then
		task.delay(6, function()
			if player.Parent then
				Remotes.Events.Notify:FireClient(player, {
					msg = "\u{26A0}\u{FE0F} SAVING IS OFF! Publish the game, then enable "
						.. "Game Settings \u{2192} Security \u{2192} Allow Studio Access to API Services.",
					kind = "bad",
				})
			end
		end)
	end
end

local function onPlayerRemoving(player)
	PlotService.release(player)
	DataService.save(player)
	DataService.forget(player)
	ctx.session[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Autosave.
task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			DataService.save(player)
		end
	end
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		DataService.save(player)
	end
	task.wait(1)
end)

print("[MVC] Missiles vs Cities server ready. Max " .. Config.MaxPlayers .. " players per server.")
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">NPCBuilder</string><ProtectedString name="Source">-- Places the four NPCs on EVERY island's town square using real Roblox
-- avatar rigs (loaded once per NPC from actual Roblox accounts, then cloned),
-- with idle animations. Falls back to a blocky figure if avatar loading
-- fails (e.g. offline Studio).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NPCDefs = require(Shared.NPCDefs)
local RigUtil = require(script.Parent.RigUtil)

local NPCBuilder = {}

local IDLE_ANIM = "rbxassetid://507766388" -- Roblox default R15 idle

local SKIN = Color3.fromRGB(255, 204, 148)

-- Custom outfits per NPC role (built from a HumanoidDescription, so NOBODY is
-- "builderman"). Colors come from NPCDefs (shirt/pants/hat).
local ROLE_ACCESSORY = {
	shopkeeper = 121850938, -- classic cap
	tailor = 20573327, -- bow/hair-ish
	mayor = 12898202, -- top hat
	general = 1029025, -- military-ish helmet
}

local function blockyFallback(def)
	local model = Instance.new("Model")
	local function p(name, size, cfOff, color)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Anchored = true
		piece.CanCollide = false
		piece.TopSurface = Enum.SurfaceType.Smooth
		piece.BottomSurface = Enum.SurfaceType.Smooth
		piece.Size = size
		piece.CFrame = cfOff
		piece.Color = color
		piece.Parent = model
		return piece
	end
	local cf = CFrame.new()
	p("LegL", Vector3.new(0.9, 1.8, 0.9), cf * CFrame.new(-0.5, 0.9, 0), def.pants)
	p("LegR", Vector3.new(0.9, 1.8, 0.9), cf * CFrame.new(0.5, 0.9, 0), def.pants)
	local torso = p("Torso", Vector3.new(2.1, 2.1, 1.1), cf * CFrame.new(0, 2.85, 0), def.shirt)
	p("ArmL", Vector3.new(0.8, 1.9, 0.8), cf * CFrame.new(-1.5, 2.9, 0), def.shirt)
	p("ArmR", Vector3.new(0.8, 1.9, 0.8), cf * CFrame.new(1.5, 2.9, 0), def.shirt)
	p("Head", Vector3.new(1.3, 1.3, 1.3), cf * CFrame.new(0, 4.6, 0), SKIN)
	p("Hat", Vector3.new(1.5, 0.5, 1.5), cf * CFrame.new(0, 5.4, 0), def.hat)
	model.PrimaryPart = torso
	return model
end

local function loadAvatarBase(def)
	-- Build a custom-dressed rig from a HumanoidDescription (never a real
	-- account avatar), colored to match this NPC's role.
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.TorsoColor = def.shirt
		desc.LeftArmColor = SKIN
		desc.RightArmColor = SKIN
		desc.LeftLegColor = def.pants
		desc.RightLegColor = def.pants
		desc.HeadColor = SKIN
		local acc = ROLE_ACCESSORY[def.id]
		if acc then
			desc.HatAccessory = tostring(acc)
		end
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and model then
		return model, true
	end
	return blockyFallback(def), false
end

local function decorate(model, def)
	local head = model:FindFirstChild("Head") or model.PrimaryPart
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(14, 0, 3.2, 0)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 140
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = def.emoji .. " " .. def.name
	label.Parent = gui
	gui.Parent = head

	local promptHolder = model.PrimaryPart or head
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TalkPrompt_" .. def.id
	prompt.ActionText = "Talk"
	prompt.ObjectText = def.name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = promptHolder
end

local function playIdle(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = IDLE_ANIM
		local track = animator:LoadAnimation(anim)
		track.Looped = true
		track:Play()
	end)
end

function NPCBuilder.build(world)
	local folder = Instance.new("Folder")
	folder.Name = "NPCs"
	folder.Parent = world.root

	-- Load each avatar once, clone per island.
	local bases = {}
	for _, def in ipairs(NPCDefs.List) do
		bases[def.id] = loadAvatarBase(def)
	end

	for _, slot in ipairs(world.slots) do
		for _, def in ipairs(NPCDefs.List) do
			local anchor = slot.npcAnchors[def.id]
			if anchor then
				local model = bases[def.id]:Clone()
				model.Name = "NPC_" .. def.id .. "_" .. slot.index
				model.Parent = folder
				-- Weld everything to the root and anchor only the root so
				-- heads and hats never drift off.
				RigUtil.freeze(model)
				RigUtil.placeOnGround(model, anchor, anchor.Y, slot.npcLookAt)
				decorate(model, def)
				playIdle(model)
			end
		end
	end

	for _, base in pairs(bases) do
		base:Destroy()
	end
end

return NPCBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">PilotService</string><ProtectedString name="Source">-- Random event for AIRPORT owners: an old pilot in a cropduster appears in the
-- distance on the radio, low on fuel, asking to land. Accept for a big payout
-- (landing + refuel + thank-you + takeoff). Decline and he keeps flying, runs
-- dry, and crashes into your city, costing you money and population.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local PilotService = {}

local ctx
local rng = Random.new()
local pending = {} -- [player] = { answered = bool }

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function airportOwners()
	local list = {}
	for _, slot in ipairs(ctx.Plot.slots()) do
		if slot.owner then
			local z = slot.zones[Layout.AirportZoneIndex]
			if z and z.level &gt; 0 then
				list[#list + 1] = slot
			end
		end
	end
	return list
end

-- Runs the whole pilot sequence for one player.
function PilotService.trigger(slot)
	local player = slot.owner
	if not player or pending[player] then
		return
	end
	pending[player] = { answered = false }

	local c = Layout.plotCenter(slot.index)
	local approach = c + Vector3.new(0, 90, 520) -- far out, high up
	local runway = Layout.zoneCenter(slot.index, Layout.AirportZoneIndex) + Vector3.new(0, 4, 0)

	-- Plane flies in from the distance (client FX).
	Remotes.Events.PlaneEvent:FireAllClients({
		phase = "approach",
		plotIndex = slot.index,
		from = approach,
		to = c + Vector3.new(0, 70, 120),
		flight = 8,
	})
	notify(player, "\u{1F4FB} *static* ...old pilot on the radio, approaching your airport...", "info")

	-- The offer with accept/decline.
	Remotes.Events.PilotOffer:FireClient(player, {
		seconds = Config.Pilot.DecideSeconds,
		reward = Config.Pilot.MinReward,
	})

	task.delay(Config.Pilot.DecideSeconds, function()
		local state = pending[player]
		if state and not state.answered then
			-- No answer counts as a decline.
			PilotService.resolve(player, false)
		end
	end)
end

function PilotService.resolve(player, accepted)
	local state = pending[player]
	if not state or state.answered then
		return
	end
	state.answered = true
	local slot = ctx.Plot.getSlot(player)
	if not slot then
		pending[player] = nil
		return
	end
	local c = Layout.plotCenter(slot.index)
	local runway = Layout.zoneCenter(slot.index, Layout.AirportZoneIndex) + Vector3.new(0, 4, 0)

	if accepted then
		Remotes.Events.PlaneEvent:FireAllClients({
			phase = "land",
			plotIndex = slot.index,
			from = c + Vector3.new(0, 70, 120),
			to = runway,
			flight = 6,
		})
		notify(player, "\u{1F468}\u{200D}\u{2708}\u{FE0F} Pilot: \"Much obliged, partner! Bringin' her down now...\"", "good")
		task.delay(6.5, function()
			local profile = ctx.Data.get(player)
			if profile then
				local bonus = math.max(0, ctx.Economy.getIncomePerSec(player) * 60 * Config.Pilot.RewardMinutes)
				local reward = Config.Pilot.MinReward + bonus
				profile.cash += reward
				notify(player, "\u{1F468}\u{200D}\u{2708}\u{FE0F} Pilot: \"Here's a lil' somethin' for the fuel and the kindness.\" +\u{1F4B5} "
					.. NumberFormat.abbrev(reward), "victory")
				ctx.Economy.pushState(player)
			end
			-- Refuel, thank-you, then take off.
			task.delay(8, function()
				notify(player, "\u{1F468}\u{200D}\u{2708}\u{FE0F} Pilot: \"All fueled up. Thank ya kindly — see ya in the skies!\"", "good")
				Remotes.Events.PlaneEvent:FireAllClients({
					phase = "takeoff",
					plotIndex = slot.index,
					from = runway,
					to = c + Vector3.new(rng:NextNumber(-200, 200), 120, -520),
					flight = 9,
				})
				pending[player] = nil
			end)
		end)
	else
		-- Declined: he keeps going, runs out of fuel, and crashes.
		notify(player, "\u{1F468}\u{200D}\u{2708}\u{FE0F} Pilot: \"Well shoot... I'll try to make it past ya then...\"", "bad")
		local minX, minZ, maxX, maxZ = Layout.plotBounds(slot.index)
		local crashPos = Vector3.new(rng:NextNumber(minX, maxX), Layout.GroundY, rng:NextNumber(minZ, maxZ))
		Remotes.Events.PlaneEvent:FireAllClients({
			phase = "crash",
			plotIndex = slot.index,
			from = c + Vector3.new(0, 70, 120),
			to = crashPos,
			flight = 7,
		})
		task.delay(7.2, function()
			if ctx.Plot.getSlot(player) ~= slot then
				pending[player] = nil
				return
			end
			local worth, count, popLost = ctx.Plot.applyBlast(slot, crashPos, 999999, 40)
			if count &gt; 0 then
				notify(player, "\u{1F4A5} The pilot ran out of fuel and CRASHED into your city! "
					.. count .. " buildings lost, \u{1F465} -" .. NumberFormat.abbrev(popLost), "bad")
			else
				notify(player, "\u{1F4A5} The pilot crashed just outside your city. Lucky!", "info")
			end
			ctx.Economy.pushState(player)
			pending[player] = nil
		end)
	end
end

local function onPilotAnswer(player, accepted)
	PilotService.resolve(player, accepted == true)
end

function PilotService.init(context)
	ctx = context
	Remotes.Events.PilotAnswer.OnServerEvent:Connect(onPilotAnswer)

	-- Periodically offer the event to a random airport owner.
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(240, 420))
			local owners = airportOwners()
			if #owners &gt; 0 then
				local slot = owners[rng:NextInteger(1, #owners)]
				if slot.owner and not pending[slot.owner] then
					PilotService.trigger(slot)
				end
			end
		end
	end)
end

return PilotService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">PlotService</string><ProtectedString name="Source">-- Owns plot assignment and all zone state: buying/upgrading via step-on pads,
-- damage, destruction, rebuild timers and HP regen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local BuildingDefs = require(Shared.BuildingDefs)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local PlotService = {}

local ctx
local slots
local playerSlot = {} -- [player] = slot
local touchDebounce = {} -- [player.UserId .. ":" .. zi] = last touch clock

local function now()
	return os.clock()
end

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

function PlotService.getSlot(player)
	return playerSlot[player]
end

function PlotService.slots()
	return slots
end

local function renderZone(slot, zi)
	local def = BuildingDefs.List[zi]
	local zone = slot.zones[zi]
	local center = Layout.zoneCenter(slot.index, zi)
	ctx.Visuals.render(slot.zoneData[zi].buildings, def, zone.level, slot.index, zi, center, zone.destroyed)
end

local C_GRASS = Color3.fromRGB(96, 186, 78)
local C_SAND = Color3.fromRGB(226, 200, 140)
local C_ZONE = Color3.fromRGB(116, 202, 94)

-- Island GROWTH: shows unlocked zone tiles as grass, the next-to-unlock tile
-- as sand (with its unlock pad), and hides everything further out (ocean).
-- So a new player starts tiny (just the house) and the island grows tile by
-- tile as they buy new areas.
local function applyZoneState(slot, zi)
	local data = slot.zoneData[zi]
	if not data then
		return
	end
	local profile = slot.owner and ctx.Data.get(slot.owner)
	if not slot.owner or not profile then
		data.tile.Parent = nil
		return
	end
	local unlocked = profile.unlocked or 1
	if zi &lt;= unlocked then
		data.tile.Parent = slot.folder
		data.ground.Color = C_GRASS
		data.ground.Material = Enum.Material.Grass
		data.plate.Color = C_ZONE
		data.plate.Material = Enum.Material.Grass
		data.sidewalk.Transparency = 0
	elseif zi == unlocked + 1 then
		data.tile.Parent = slot.folder
		data.ground.Color = C_SAND
		data.ground.Material = Enum.Material.Sand
		data.plate.Color = C_SAND
		data.plate.Material = Enum.Material.Sand
		data.sidewalk.Transparency = 1
	else
		data.tile.Parent = nil -- not yet reachable; ocean
	end
end

-- Back-compat: old call sites pass a `locked` flag we now ignore (state is
-- derived from the profile's unlocked count).
local function setZoneGround(slot, zi)
	applyZoneState(slot, zi)
end

function PlotService.updatePad(slot, zi)
	local def = BuildingDefs.List[zi]
	local zone = slot.zones[zi]
	local data = slot.zoneData[zi]
	local label = data.padLabel
	local pad = data.pad

	local function hidePad()
		label.Text = ""
		pad.Transparency = 1
	end

	if not slot.owner then
		hidePad()
		return
	end
	local profile = ctx.Data.get(slot.owner)
	if not profile then
		hidePad()
		return
	end

	-- Island expansion: only the NEXT locked area shows an unlock pad.
	if zone.locked then
		if zi == (profile.unlocked or 1) + 1 then
			pad.Transparency = 0
			pad.Color = Color3.fromRGB(250, 200, 60)
			label.Text = "\u{1F513} UNLOCK NEW AREA\n\u{1F4B5} " .. NumberFormat.abbrev(BuildingDefs.unlockCost(def))
		else
			hidePad()
		end
		return
	end
	pad.Transparency = 0

	if zone.destroyed then
		local remaining = math.max(0, math.ceil(zone.repairAt - now()))
		label.Text = "\u{1F4A5} " .. def.name .. " destroyed!\nRebuilding " .. NumberFormat.clock(remaining)
		pad.Color = Color3.fromRGB(120, 120, 120)
	elseif zone.level &lt;= 0 then
		label.Text = "\u{1F3D7}\u{FE0F} Buy " .. def.name .. "\n\u{1F4B5} " .. NumberFormat.abbrev(BuildingDefs.upgradeCost(def, 1))
		pad.Color = Color3.fromRGB(80, 235, 90)
	elseif zone.level &gt;= Config.BuildingMaxLevel then
		label.Text = def.emoji .. " " .. def.name .. " Lv MAX"
		pad.Color = Color3.fromRGB(250, 200, 60)
	else
		local maxHp = BuildingDefs.maxHp(def, zone.level)
		local hpLine = ""
		if zone.hp &lt; maxHp then
			hpLine = "\n\u{2764}\u{FE0F} " .. NumberFormat.commas(zone.hp) .. " / " .. NumberFormat.commas(maxHp) .. " HP"
		end
		label.Text = def.emoji .. " " .. def.name .. " Lv" .. zone.level
			.. "\n\u{2B06}\u{FE0F} Upgrade \u{1F4B5} " .. NumberFormat.abbrev(BuildingDefs.upgradeCost(def, zone.level + 1))
			.. hpLine
		pad.Color = Color3.fromRGB(80, 235, 90)
	end
end

local function onPadTouched(slot, zi, hit)
	local character = hit.Parent
	if not character then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player and character.Parent then
		player = Players:GetPlayerFromCharacter(character.Parent)
	end
	if not player or slot.owner ~= player then
		return
	end

	local dKey = player.UserId .. ":" .. zi
	if touchDebounce[dKey] and now() - touchDebounce[dKey] &lt; 0.8 then
		return
	end
	touchDebounce[dKey] = now()

	local profile = ctx.Data.get(player)
	if not profile then
		return
	end
	local def = BuildingDefs.List[zi]
	local zone = slot.zones[zi]

	-- Unlock the next island area.
	if zone.locked then
		if zi ~= (profile.unlocked or 1) + 1 then
			return
		end
		local cost = BuildingDefs.unlockCost(def)
		if not ctx.Economy.trySpend(player, cost) then
			notify(player, "Unlocking this area costs \u{1F4B5} " .. NumberFormat.abbrev(cost) .. "!", "bad")
			return
		end
		profile.unlocked = zi
		zone.locked = false
		applyZoneState(slot, zi) -- this tile becomes grass
		PlotService.updatePad(slot, zi)
		if slot.zones[zi + 1] then
			applyZoneState(slot, zi + 1) -- reveal the next sand tile + its pad
			PlotService.updatePad(slot, zi + 1)
		end
		notify(player, "\u{1F513} NEW AREA UNLOCKED! The island grew \u{2014} build " .. def.name .. " here.", "victory")
		ctx.Economy.pushState(player)
		return
	end

	if zone.destroyed then
		notify(player, "\u{1F4A5} " .. def.name .. " is rebuilding, hang tight!", "bad")
		return
	end
	if zone.level &gt;= Config.BuildingMaxLevel then
		return
	end

	local targetLevel = zone.level + 1
	local cost = BuildingDefs.upgradeCost(def, targetLevel)
	if not ctx.Economy.trySpend(player, cost) then
		notify(player, "Need \u{1F4B5} " .. NumberFormat.abbrev(cost) .. " for " .. def.name .. "!", "bad")
		return
	end

	zone.level = targetLevel
	zone.hp = BuildingDefs.maxHp(def, targetLevel)
	profile.buildings[def.id] = targetLevel
	renderZone(slot, zi)
	PlotService.updatePad(slot, zi)
	if targetLevel == 1 then
		notify(player, def.emoji .. " Built " .. def.name .. "!", "buy")
	else
		notify(player, def.emoji .. " " .. def.name .. " upgraded to Lv" .. targetLevel .. "!", "buy")
	end
	if ctx.Quests then
		ctx.Quests.onEvent(player, "upgrade", 1)
	end
	ctx.Economy.pushState(player)
end

local function onNukePadTouched(slot, hit)
	local character = hit.Parent
	if not character then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player or slot.owner ~= player then
		return
	end
	local dKey = player.UserId .. ":nuke"
	if touchDebounce[dKey] and now() - touchDebounce[dKey] &lt; 1 then
		return
	end
	touchDebounce[dKey] = now()

	local profile = ctx.Data.get(player)
	if not profile then
		return
	end
	if profile.nukeIsland then
		notify(player, "\u{2622}\u{FE0F} You already own Nuke Access!", "info")
		return
	end
	if not ctx.Economy.trySpend(player, Config.Nuke.IslandCost) then
		notify(player, "Nuke Access costs \u{1F4B5} " .. NumberFormat.abbrev(Config.Nuke.IslandCost) .. "!", "bad")
		return
	end
	profile.nukeIsland = true
	notify(player, "\u{2622}\u{FE0F} NUKE ACCESS UNLOCKED! One nuke every 24 hours.", "victory")
	Remotes.Events.Notify:FireAllClients({
		msg = "\u{2622}\u{FE0F} " .. player.DisplayName .. " just bought NUKE ACCESS. Be afraid.",
		kind = "info",
	})
	ctx.Economy.pushState(player)
end

function PlotService.assign(player)
	local slot
	for _, s in ipairs(slots) do
		if not s.owner then
			slot = s
			break
		end
	end
	if not slot then
		player:Kick("Server is full (5 cities max). Please try another server!")
		return nil
	end

	local profile = ctx.Data.get(player)
	slot.owner = player
	slot.immuneUntil = now() + Config.JoinImmunity
	playerSlot[player] = slot

	-- Old saves may predate area unlocks: derive from owned buildings.
	local unlocked = profile.unlocked or 1
	for zi, def in ipairs(BuildingDefs.List) do
		local level = (profile.buildings and profile.buildings[def.id]) or 0
		if level &gt; 0 and zi &gt; unlocked then
			unlocked = zi
		end
	end
	profile.unlocked = math.clamp(unlocked, 1, #BuildingDefs.List)

	for zi, def in ipairs(BuildingDefs.List) do
		local level = (profile.buildings and profile.buildings[def.id]) or 0
		slot.zones[zi] = {
			level = level,
			hp = BuildingDefs.maxHp(def, math.max(level, 1)),
			destroyed = false,
			repairAt = 0,
			lastHitAt = 0,
			locked = zi &gt; profile.unlocked,
			pending = 0,
		}
		setZoneGround(slot, zi, slot.zones[zi].locked)
		renderZone(slot, zi)
		PlotService.updatePad(slot, zi)
		PlotService.updateCollect(slot, zi)
	end

	slot.bannerLabel.Text = "\u{1F3D9}\u{FE0F} " .. player.DisplayName
	PlotService.updateSilos(slot, profile.siloCount or 1)
	PlotService.updateRocketVisual(slot, profile.rocketLevel or 1)
	if ctx.Defense then
		ctx.Defense.updateTurrets(slot, profile.defenseLevel or 0)
	end
	if ctx.Jets then
		ctx.Jets.updateHangars(slot, profile.hangars or 0)
	end
	if ctx.Battery then
		ctx.Battery.showIsland(slot, profile.batteryUnlocked or false)
	end

	local function place(character)
		local hrp = character:WaitForChild("HumanoidRootPart", 8)
		if hrp and playerSlot[player] == slot then
			task.wait(0.15)
			character:PivotTo(CFrame.new(Layout.plotSpawn(slot.index)))
		end
	end
	slot.charConn = player.CharacterAdded:Connect(place)
	if player.Character then
		task.spawn(place, player.Character)
	end

	return slot
end

function PlotService.release(player)
	local slot = playerSlot[player]
	if not slot then
		return
	end
	if slot.charConn then
		slot.charConn:Disconnect()
		slot.charConn = nil
	end
	slot.owner = nil
	slot.bannerLabel.Text = "\u{1F3DD}\u{FE0F} Empty Plot"
	PlotService.updateSilos(slot, 1)
	if ctx.Defense then
		ctx.Defense.updateTurrets(slot, 0)
	end
	if ctx.Jets then
		ctx.Jets.updateHangars(slot, 0)
	end
	if ctx.Battery then
		ctx.Battery.showIsland(slot, false)
	end
	for zi in ipairs(BuildingDefs.List) do
		slot.zones[zi] = { level = 0, hp = 0, destroyed = false, repairAt = 0, lastHitAt = 0, locked = true, pending = 0 }
		setZoneGround(slot, zi, true)
		renderZone(slot, zi)
		PlotService.updatePad(slot, zi)
		PlotService.updateCollect(slot, zi)
	end
	playerSlot[player] = nil
end

function PlotService.isImmune(slot)
	return slot.immuneUntil and now() &lt; slot.immuneUntil
end

-- Sum of invested value across intact buildings (used for nuke payouts).
function PlotService.intactWorth(slot)
	local worth = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 and not zone.destroyed then
			worth += BuildingDefs.totalWorth(def, zone.level)
		end
	end
	return worth
end

function PlotService.cityWorth(slot)
	local worth = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 then
			worth += BuildingDefs.totalWorth(def, zone.level)
		end
	end
	return worth
end

-- Total living population across intact buildings.
function PlotService.population(slot)
	local pop = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 and not zone.destroyed then
			pop += BuildingDefs.population(def, zone.level)
		end
	end
	return pop
end

-- Refresh the floating "collect" cash label on a zone.
function PlotService.updateCollect(slot, zi)
	local data = slot.zoneData[zi]
	local zone = slot.zones[zi]
	local gui = data.collectGui
	if not gui then
		return
	end
	local pending = zone.pending or 0
	local profile = slot.owner and ctx.Data.get(slot.owner)
	if profile and profile.autoCollect then
		gui.Enabled = false
		return
	end
	if pending &gt;= 1 and zone.level &gt; 0 and not zone.destroyed then
		gui.Enabled = true
		data.collectLabel.Text = "\u{1F4B5} " .. NumberFormat.abbrev(pending)
	else
		gui.Enabled = false
	end
end

function PlotService.collectZone(player, slot, zi)
	local zone = slot.zones[zi]
	local pending = math.floor(zone.pending or 0)
	if pending &lt; 1 then
		return 0
	end
	zone.pending = 0
	ctx.Economy.addCash(player, pending)
	PlotService.updateCollect(slot, zi)
	Remotes.Events.IncomePops:FireAllClients(slot.index, { { zi, pending } })
	return pending
end

function PlotService.collectAll(player, slot)
	local total = 0
	for zi in ipairs(BuildingDefs.List) do
		total += PlotService.collectZone(player, slot, zi)
	end
	return total
end

function PlotService.destroyZone(slot, zi, repairAfter)
	local zone = slot.zones[zi]
	zone.destroyed = true
	zone.repairAt = now() + repairAfter
	renderZone(slot, zi)
	PlotService.updatePad(slot, zi)
end

-- Missile blast: damages every intact building within the radius.
-- Returns total worth destroyed, how many buildings fell, and population lost.
-- Also makes the victim lose some cash directly.
function PlotService.applyBlast(slot, pos, damage, radius)
	radius = radius or Config.Rocket.BlastRadius
	local worthDestroyed = 0
	local destroyedCount = 0
	local popLost = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 and not zone.destroyed then
			local center = Layout.zoneCenter(slot.index, zi)
			local dx = center.X - pos.X
			local dz = center.Z - pos.Z
			if math.sqrt(dx * dx + dz * dz) &lt;= radius then
				zone.hp -= damage
				zone.lastHitAt = now()
				if zone.hp &lt;= 0 then
					worthDestroyed += BuildingDefs.totalWorth(def, zone.level)
					popLost += BuildingDefs.population(def, zone.level)
					destroyedCount += 1
					PlotService.destroyZone(slot, zi, Config.MissileRepairTime)
				else
					PlotService.updatePad(slot, zi)
				end
			end
		end
	end
	-- Victim also loses cash proportional to the damage dealt.
	if worthDestroyed &gt; 0 and slot.owner then
		local profile = ctx.Data.get(slot.owner)
		if profile then
			local loss = math.floor(worthDestroyed * Config.VictimCashLossRate)
			profile.cash = math.max(0, profile.cash - loss)
		end
	end
	return worthDestroyed, destroyedCount, popLost
end

-- True if this slot has an intact rocket silo zone owner can launch from.
function PlotService.zoneLevel(slot, zi)
	local zone = slot.zones[zi]
	return zone and zone.level or 0
end

-- Nuke: flattens the whole city, staggered rebuild, temporary immunity.
function PlotService.nukeSlot(slot)
	local worth = 0
	local delayStep = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 and not zone.destroyed then
			worth += BuildingDefs.totalWorth(def, zone.level)
			delayStep += 1
			PlotService.destroyZone(slot, zi, 60 + delayStep * 15)
		end
	end
	slot.immuneUntil = now() + Config.Nuke.ImmunityAfter
	return worth
end

-- Show/hide extra silo models to match how many the player owns.
function PlotService.updateSilos(slot, count)
	for i = 2, #slot.siloGroups do
		local group = slot.siloGroups[i]
		if i &lt;= count then
			group.model.Parent = slot.folder
		else
			group.model.Parent = nil
		end
	end
end

-- Hide/show a silo's decorative rocket (during launches).
function PlotService.setSiloRocket(slot, siloIndex, visible)
	local group = slot.siloGroups[siloIndex]
	if not group then
		return
	end
	for _, p in ipairs(group.rocketModel:GetChildren()) do
		if p:IsA("BasePart") then
			p.Transparency = visible and 0 or 1
		end
	end
end

-- Grow and restyle every silo rocket to match the rocket level.
local ROCKET_TIERS = {
	{ 1, Color3.fromRGB(240, 240, 245), Color3.fromRGB(230, 60, 60) },
	{ 10, Color3.fromRGB(200, 220, 250), Color3.fromRGB(60, 120, 240) },
	{ 25, Color3.fromRGB(150, 235, 160), Color3.fromRGB(40, 180, 70) },
	{ 45, Color3.fromRGB(250, 210, 90), Color3.fromRGB(240, 150, 30) },
	{ 70, Color3.fromRGB(210, 130, 250), Color3.fromRGB(150, 40, 220) },
}
function PlotService.updateRocketVisual(slot, level)
	local scale = 1 + math.min(level, Config.Rocket.MaxLevel) / 100 * 1.4 -- up to ~2.4x
	local body, nose = ROCKET_TIERS[1][2], ROCKET_TIERS[1][3]
	for _, tier in ipairs(ROCKET_TIERS) do
		if level &gt;= tier[1] then
			body, nose = tier[2], tier[3]
		end
	end
	for _, group in ipairs(slot.siloGroups) do
		local rm = group.rocketModel
		if rm and rm.PrimaryPart then
			-- ScaleTo is absolute relative to the model's build-time size.
			pcall(function()
				rm:ScaleTo(scale)
			end)
			for _, p in ipairs(rm:GetChildren()) do
				if p:IsA("BasePart") then
					p.Color = (p.Name == "SiloRocket") and body or nose
				end
			end
		end
	end
end

-- Rebirth: wipe the city back to a single house (visuals + profile).
function PlotService.resetBuildings(player)
	local slot = playerSlot[player]
	local profile = ctx.Data.get(player)
	if not slot or not profile then
		return
	end
	profile.buildings = { house = 1 }
	-- Unlocked areas survive rebirth; only buildings reset.
	for zi, def in ipairs(BuildingDefs.List) do
		local level = (def.id == "house") and 1 or 0
		slot.zones[zi] = {
			level = level,
			hp = BuildingDefs.maxHp(def, math.max(level, 1)),
			destroyed = false,
			repairAt = 0,
			lastHitAt = 0,
			locked = zi &gt; (profile.unlocked or 1),
		}
		setZoneGround(slot, zi, slot.zones[zi].locked)
		renderZone(slot, zi)
		PlotService.updatePad(slot, zi)
	end
end

-- Re-render every owned city (used after Store building models finish loading).
function PlotService.rerenderAll()
	for _, slot in ipairs(slots) do
		if slot.owner then
			for zi in ipairs(BuildingDefs.List) do
				renderZone(slot, zi)
				PlotService.updatePad(slot, zi)
			end
		end
	end
end

function PlotService.repairAll(slot)
	local repaired = 0
	for zi, def in ipairs(BuildingDefs.List) do
		local zone = slot.zones[zi]
		if zone.level &gt; 0 and zone.destroyed then
			zone.destroyed = false
			zone.hp = BuildingDefs.maxHp(def, zone.level)
			renderZone(slot, zi)
			PlotService.updatePad(slot, zi)
			repaired += 1
		end
	end
	return repaired
end

local function maintenanceLoop()
	while true do
		task.wait(1)
		for _, slot in ipairs(slots) do
			if slot.owner then
				for zi, def in ipairs(BuildingDefs.List) do
					local zone = slot.zones[zi]
					if zone.destroyed then
						if now() &gt;= zone.repairAt then
							zone.destroyed = false
							zone.hp = BuildingDefs.maxHp(def, zone.level)
							renderZone(slot, zi)
							PlotService.updatePad(slot, zi)
							notify(slot.owner, "\u{2705} " .. def.name .. " rebuilt!", "good")
						else
							PlotService.updatePad(slot, zi) -- live countdown text
						end
					elseif zone.level &gt; 0 then
						local maxHp = BuildingDefs.maxHp(def, zone.level)
						if zone.hp &lt; maxHp and now() - zone.lastHitAt &gt; Config.HpRegenDelay then
							zone.hp = maxHp
							PlotService.updatePad(slot, zi)
						end
					end
				end
			end
		end
	end
end

function PlotService.init(context)
	ctx = context
	slots = ctx.World.slots

	for _, slot in ipairs(slots) do
		slot.zones = {}
		for zi in ipairs(BuildingDefs.List) do
			slot.zones[zi] = { level = 0, hp = 0, destroyed = false, repairAt = 0, lastHitAt = 0, locked = true, pending = 0 }
			setZoneGround(slot, zi, true)
			-- Floating "collect" cash label above the building.
			local data = slot.zoneData[zi]
			local gui = Instance.new("BillboardGui")
			gui.Name = "CollectGui"
			gui.Size = UDim2.new(10, 0, 4, 0)
			gui.StudsOffset = Vector3.new(0, 12, 0)
			gui.MaxDistance = 220
			gui.Enabled = false
			gui.Adornee = data.plate
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(120, 245, 100)
			label.TextStrokeColor3 = Color3.new(0, 0, 0)
			label.TextStrokeTransparency = 0
			label.Text = ""
			label.Parent = gui
			gui.Parent = data.plate
			data.collectGui = gui
			data.collectLabel = label
			PlotService.updatePad(slot, zi)
		end
		for zi in ipairs(BuildingDefs.List) do
			local data = slot.zoneData[zi]
			data.pad.Touched:Connect(function(hit)
				onPadTouched(slot, zi, hit)
			end)
			-- Stepping onto the building tile collects its piled-up cash.
			data.plate.Touched:Connect(function(hit)
				local character = hit.Parent
				local player = character and Players:GetPlayerFromCharacter(character)
				if player and slot.owner == player then
					local dKey = player.UserId .. ":collect:" .. zi
					if not touchDebounce[dKey] or now() - touchDebounce[dKey] &gt; 0.5 then
						touchDebounce[dKey] = now()
						local got = PlotService.collectZone(player, slot, zi)
						if got &gt; 0 then
							ctx.Economy.pushState(player)
						end
					end
				end
			end)
		end
	end

	for _, slot in ipairs(slots) do
		slot.nukePad.Touched:Connect(function(hit)
			onNukePadTouched(slot, hit)
		end)
	end

	task.spawn(maintenanceLoop)
end

return PlotService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">QuestService</string><ProtectedString name="Source">-- Quest chains: counters advance on gameplay events, stat quests are
-- evaluated against live values every economy tick. Completions pay out
-- automatically with a fanfare; repeatable end-quests loop forever.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestDefs = require(Shared.QuestDefs)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local QuestService = {}

local ctx

local STAT_KINDS = { cash = true, worth = true, rocket_level = true, buildings = true }

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local function chainState(profile, chainId)
	profile.quests = profile.quests or {}
	local state = profile.quests[chainId]
	if not state then
		state = { index = 1, progress = 0, loops = 0 }
		profile.quests[chainId] = state
	end
	return state
end

local function currentQuest(chainId, state)
	local chain = QuestDefs.Chains[chainId]
	return chain.quests[state.index]
end

local function grantReward(player, reward)
	local profile = ctx.Data.get(player)
	local bits = {}
	if reward.cash then
		profile.cash += reward.cash
		bits[#bits + 1] = "\u{1F4B5} " .. NumberFormat.abbrev(reward.cash)
	end
	if reward.cashMinutes then
		local amount = math.max(5000, ctx.Economy.getIncomePerSec(player) * 60 * reward.cashMinutes)
		profile.cash += amount
		bits[#bits + 1] = "\u{1F4B5} " .. NumberFormat.abbrev(amount)
	end
	if reward.gems then
		profile.gems += reward.gems
		bits[#bits + 1] = "\u{1F48E} " .. reward.gems
	end
	if reward.shield then
		profile.shields += reward.shield
		bits[#bits + 1] = "\u{1F6E1}\u{FE0F} Shield"
	end
	if reward.barrage then
		profile.barrage += reward.barrage
		bits[#bits + 1] = "\u{1F680}x3 Barrage"
	end
	return table.concat(bits, " + ")
end

local function tryComplete(player, chainId, state, statValue)
	local quest = currentQuest(chainId, state)
	if not quest then
		return
	end
	local progress = statValue or state.progress
	if progress &lt; quest.goal then
		return
	end

	local rewardText = grantReward(player, quest.reward)
	notify(player, "\u{1F4DC} QUEST COMPLETE: " .. quest.name .. "! Reward: " .. rewardText, "victory")

	if quest.repeatable then
		state.loops += 1
		state.progress = 0
	else
		state.index += 1
		state.progress = 0
	end
end

-- Counter events: upgrade, destroy, missile_launch, nuke.
function QuestService.onEvent(player, kind, amount)
	local profile = ctx.Data.get(player)
	if not profile then
		return
	end
	for chainId in pairs(QuestDefs.Chains) do
		local state = chainState(profile, chainId)
		local quest = currentQuest(chainId, state)
		if quest and quest.kind == kind then
			state.progress += amount
			tryComplete(player, chainId, state)
		end
	end
end

-- Stat evaluation, called from the economy tick.
-- stats = { cash =, worth =, rocket_level =, buildings = }
function QuestService.evaluate(player, stats)
	local profile = ctx.Data.get(player)
	if not profile then
		return
	end
	for chainId in pairs(QuestDefs.Chains) do
		local state = chainState(profile, chainId)
		local quest = currentQuest(chainId, state)
		if quest and STAT_KINDS[quest.kind] then
			tryComplete(player, chainId, state, stats[quest.kind] or 0)
		end
	end
end

-- Compact summary for the client (state push).
function QuestService.getSummary(player, stats)
	local profile = ctx.Data.get(player)
	if not profile then
		return nil
	end
	local summary = {}
	for chainId, chain in pairs(QuestDefs.Chains) do
		local state = chainState(profile, chainId)
		local quest = currentQuest(chainId, state)
		if quest then
			local progress = state.progress
			if STAT_KINDS[quest.kind] and stats then
				progress = stats[quest.kind] or 0
			end
			summary[chainId] = {
				title = chain.title,
				name = quest.name,
				desc = quest.desc,
				progress = math.min(progress, quest.goal),
				goal = quest.goal,
				number = state.index,
				total = #chain.quests,
				repeatable = quest.repeatable or false,
			}
		else
			summary[chainId] = { title = chain.title, done = true, total = #chain.quests }
		end
	end
	return summary
end

function QuestService.init(context)
	ctx = context
end

return QuestService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">RewardsService</string><ProtectedString name="Source">-- Daily reward streak (7-day calendar, day 7 = free nuke charge).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)

local RewardsService = {}

local ctx

local function notify(player, msg, kind)
	Remotes.Events.Notify:FireClient(player, { msg = msg, kind = kind or "info" })
end

local rng = Random.new()

-- Random reward pool. Day 7 is always the big FREE NUKE.
local POOL = {
	{ label = "50 Gems", emoji = "\u{1F48E}", kind = "gems", amount = 50 },
	{ label = "120 Gems", emoji = "\u{1F48E}", kind = "gems", amount = 120 },
	{ label = "300 Gems", emoji = "\u{1F48E}", kind = "gems", amount = 300 },
	{ label = "Cash Boost", emoji = "\u{1F4B5}", kind = "cash_minutes", amount = 10 },
	{ label = "Big Cash", emoji = "\u{1F4B0}", kind = "cash_minutes", amount = 30 },
	{ label = "Shield", emoji = "\u{1F6E1}\u{FE0F}", kind = "shield", amount = 1 },
	{ label = "Barrage", emoji = "\u{1F680}", kind = "barrage", amount = 1 },
	{ label = "Nuke Charge", emoji = "\u{2622}\u{FE0F}", kind = "nuke_charge", amount = 1 },
}

-- Builds a fresh randomized 7-day set; day 7 is the guaranteed FREE NUKE.
local function generateRewards()
	local rewards = {}
	for day = 1, 6 do
		rewards[day] = POOL[rng:NextInteger(1, #POOL - 1)] -- exclude nuke from 1-6
	end
	rewards[7] = { label = "FREE NUKE", emoji = "\u{2622}\u{FE0F}", kind = "nuke_charge", amount = 1 }
	return rewards
end

local function effectiveStreak(profile)
	local daily = profile.daily
	if daily.lastClaimAt &gt; 0 and os.time() - daily.lastClaimAt &gt; Config.DailyStreakBreak then
		return 0 -- streak expired
	end
	return daily.streak
end

-- Ensures the player has a randomized reward set; regenerates on streak reset.
local function ensureRewards(profile)
	local streak = effectiveStreak(profile)
	if not profile.daily.rewards or streak == 0 then
		profile.daily.rewards = generateRewards()
	end
	return profile.daily.rewards
end

function RewardsService.getData(player)
	local profile = ctx.Data.get(player)
	if not profile then
		return nil
	end
	local streak = effectiveStreak(profile)
	local sinceClaim = os.time() - profile.daily.lastClaimAt
	local canClaim = profile.daily.lastClaimAt == 0 or sinceClaim &gt;= Config.DailyClaimWindow
	local rewards = ensureRewards(profile)
	return {
		dayIndex = (streak % 7) + 1, -- the next day to claim
		canClaim = canClaim,
		nextIn = canClaim and 0 or (Config.DailyClaimWindow - sinceClaim),
		rewards = rewards, -- randomized set the client renders
	}
end

local function onClaimDaily(player)
	local profile = ctx.Data.get(player)
	if not profile then
		return
	end
	local data = RewardsService.getData(player)
	if not data.canClaim then
		notify(player, "\u{23F3} Next reward in " .. NumberFormat.clock(data.nextIn) .. "!", "bad")
		return
	end

	local rewards = ensureRewards(profile)
	local reward = rewards[data.dayIndex] or Config.DailyRewards[data.dayIndex]
	if reward.kind == "gems" then
		profile.gems += reward.amount
		notify(player, "\u{1F48E} Day " .. data.dayIndex .. " reward: +" .. reward.amount .. " gems!", "victory")
	elseif reward.kind == "cash_minutes" then
		local amount = math.max(2500, ctx.Economy.getIncomePerSec(player) * 60 * reward.amount)
		profile.cash += amount
		notify(player, "\u{1F4B5} Day " .. data.dayIndex .. " reward: +"
			.. NumberFormat.abbrev(amount) .. " cash!", "victory")
	elseif reward.kind == "shield" then
		profile.shields += reward.amount
		notify(player, "\u{1F6E1}\u{FE0F} Day " .. data.dayIndex .. " reward: Shield armed!", "victory")
	elseif reward.kind == "barrage" then
		profile.barrage += reward.amount
		notify(player, "\u{1F680} Day " .. data.dayIndex .. " reward: Barrage loaded!", "victory")
	elseif reward.kind == "nuke_charge" then
		profile.nukeCharges += reward.amount
		notify(player, "\u{2622}\u{FE0F} DAY 7 REWARD: FREE NUKE! Open the attack view to use it.", "victory")
	end

	profile.daily.streak = effectiveStreak(profile) + 1
	profile.daily.lastClaimAt = os.time()

	Remotes.Events.DailyData:FireClient(player, RewardsService.getData(player))
	ctx.Economy.pushState(player)
end

function RewardsService.init(context)
	ctx = context
	Remotes.Events.ClaimDaily.OnServerEvent:Connect(onClaimDaily)
end

return RewardsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">RigUtil</string><ProtectedString name="Source">-- Shared helper for placing static avatar rigs. We anchor ONLY the
-- HumanoidRootPart and leave the limbs jointed (Motor6D) and unanchored, so:
--   * the rig can't fall or drift (root is anchored),
--   * heads and hats stay attached (via their joints/welds),
--   * idle animations still drive the limbs.

local RigUtil = {}

function RigUtil.freeze(model)
	local root = model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart")
	if not root then
		return
	end
	model.PrimaryPart = root

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		humanoid.BreakJointsOnDeath = false
	end

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = false
			obj.Anchored = (obj == root) -- only the root is anchored
			obj.Massless = (obj ~= root)
		end
	end
end

-- Places a frozen rig so its feet touch groundY, facing lookTarget.
function RigUtil.placeOnGround(model, footPos, groundY, lookTarget)
	model:PivotTo(CFrame.new(footPos + Vector3.new(0, 50, 0)))
	local bbCF, bbSize = model:GetBoundingBox()
	local pivotY = model:GetPivot().Position.Y
	local feetOffset = pivotY - (bbCF.Position.Y - bbSize.Y / 2)
	local pos = Vector3.new(footPos.X, groundY + feetOffset + 0.05, footPos.Z)
	local look = lookTarget and Vector3.new(lookTarget.X, pos.Y, lookTarget.Z) or (pos + Vector3.new(0, 0, 1))
	model:PivotTo(CFrame.lookAt(pos, look))
end

return RigUtil
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">StoreModels</string><ProtectedString name="Source">-- Shared loader for Creator Store assets: inserts, sanitizes (strips ALL
-- scripts/sounds), normalizes scale, caches templates. Everything pcall'd —
-- a broken id just means the caller falls back to part-built visuals.

local InsertService = game:GetService("InsertService")

local StoreModels = {}

local cache = {} -- [key] = { model, scale } | false (known-failed)

local function sanitize(model)
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("LuaSourceContainer") or obj:IsA("Sound")
			or obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
			obj:Destroy()
		end
	end
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored = true
		end
	end
end

-- opts: { size = studs, byHeight = bool }
function StoreModels.get(key, ids, opts)
	if cache[key] ~= nil then
		return cache[key] or nil
	end
	for _, id in ipairs(ids or {}) do
		local ok, asset = pcall(function()
			return InsertService:LoadAsset(id)
		end)
		if ok and asset then
			local model = asset:FindFirstChildWhichIsA("Model")
			if not model then
				model = Instance.new("Model")
				for _, child in ipairs(asset:GetChildren()) do
					child.Parent = model
				end
			end
			sanitize(model)
			if #model:GetDescendants() &gt; 0 then
				local okBB, bbSize = pcall(function()
					local _, size = model:GetBoundingBox()
					return size
				end)
				if okBB and bbSize and bbSize.Magnitude &gt; 0.5 then
					local current = opts.byHeight and bbSize.Y or math.max(bbSize.X, bbSize.Z)
					local factor = math.clamp((opts.size or 10) / math.max(current, 0.5), 0.01, 50)
					local okScale = pcall(function()
						model:ScaleTo(factor)
					end)
					if okScale then
						model.Parent = nil
						cache[key] = { model = model, scale = factor }
						asset:Destroy()
						return cache[key]
					end
				end
			end
			asset:Destroy()
		end
	end
	warn("[MVC] Store asset unavailable for: " .. key .. " (using built-in visuals)")
	cache[key] = false
	return nil
end

return StoreModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source">-- Builds the map in classic stud-brick style: 5 far-apart islands, each with
-- the 4x4 expandable city grid, up to 3 rocket silos RIGHT BY SPAWN on the
-- town square (shop, NPCs, leaderboard, rebirth shrine), a park strip at the
-- back, and decorative filler islands so the ocean isn't empty.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local BuildingDefs = require(Shared.BuildingDefs)
local NumberFormat = require(Shared.NumberFormat)

local WorldBuilder = {}

local COLOR_GRASS = Color3.fromRGB(96, 186, 78)
local COLOR_SAND = Color3.fromRGB(226, 200, 140)
local COLOR_ROAD = Color3.fromRGB(48, 48, 54)
local COLOR_DASH = Color3.fromRGB(248, 214, 62)
local COLOR_SIDEWALK = Color3.fromRGB(168, 168, 172)
local COLOR_PLAZA = Color3.fromRGB(196, 190, 178)

-- Materials that should stay smooth (no studs): glass, neon signs, metal, etc.
local SMOOTH_MATERIALS = {
	[Enum.Material.Neon] = true,
	[Enum.Material.Glass] = true,
	[Enum.Material.ForceField] = true,
	[Enum.Material.DiamondPlate] = true,
	[Enum.Material.Metal] = true,
}

-- Applies classic raised STUDS to all six faces (engine-rendered, no assets).
local function studAll(p)
	p.TopSurface = Enum.SurfaceType.Studs
	p.BottomSurface = Enum.SurfaceType.Studs
	p.LeftSurface = Enum.SurfaceType.Studs
	p.RightSurface = Enum.SurfaceType.Studs
	p.FrontSurface = Enum.SurfaceType.Studs
	p.BackSurface = Enum.SurfaceType.Studs
	return p
end

-- Every world part is a classic studded brick (Plastic + Studs on all faces)
-- unless its material is one that should stay smooth, or props.Smooth is set.
local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	local mat = props.Material or Enum.Material.Plastic
	if mat == Enum.Material.SmoothPlastic then
		mat = Enum.Material.Plastic
	end
	local smooth = props.Smooth or SMOOTH_MATERIALS[mat]
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Smooth" and k ~= "Material" then
			p[k] = v
		end
	end
	p.Material = mat
	if smooth then
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
	else
		studAll(p)
	end
	p.Parent = props.Parent
	return p
end

-- Back-compat shim: parts are already studded by default, so this is a no-op
-- that just returns the part (older call sites pass face lists we now ignore).
local function studs(p)
	return p
end

local function billboard(adornee, sizeX, sizeY, offsetY, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(sizeX, 0, sizeY, 0)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = maxDistance or 250
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = ""
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

-- Minecraft-style blocky tree: stud trunk + cube canopy.
local function buildTree(pos, parent, big)
	local h = big and 9 or 7
	studs(part({
		Name = "Trunk",
		Size = Vector3.new(2, h, 2),
		Position = pos + Vector3.new(0, h / 2, 0),
		Color = Color3.fromRGB(118, 84, 50),
		Parent = parent,
	}), { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }, 2)
	local canopy = big and 9 or 7
	studs(part({
		Name = "Leaves",
		Size = Vector3.new(canopy, canopy - 2, canopy),
		Position = pos + Vector3.new(0, h + (canopy - 2) / 2 - 0.5, 0),
		Color = Color3.fromRGB(62, 158, 62),
		Parent = parent,
	}), { Enum.NormalId.Top, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }, 3)
end

local function buildLamp(pos, parent)
	part({
		Name = "LampPole",
		Size = Vector3.new(0.7, 9, 0.7),
		Position = pos + Vector3.new(0, 4.5, 0),
		Color = Color3.fromRGB(70, 70, 78),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local bulb = part({
		Name = "LampBulb",
		Size = Vector3.new(1.4, 1, 1.4),
		Position = pos + Vector3.new(0, 9.4, 0),
		Color = Color3.fromRGB(255, 236, 160),
		Material = Enum.Material.Neon,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(255, 230, 160)
	light.Parent = bulb
end

local function buildRoads(center, folder)
	local dashLimit = Config.PlotSize / 2 - 16
	for _, x in ipairs(Layout.RoadXs) do
		part({
			Name = "RoadV",
			Size = Vector3.new(12, 0.2, Config.PlotSize),
			Position = Vector3.new(center.X + x, Config.GroundY + 0.1, center.Z),
			Color = COLOR_ROAD,
			Material = Enum.Material.Asphalt,
			Parent = folder,
		})
		local zDash = -dashLimit
		while zDash &lt;= dashLimit do
			part({
				Name = "DashV",
				Size = Vector3.new(1.6, 0.05, 6),
				Position = Vector3.new(center.X + x, Config.GroundY + 0.22, center.Z + zDash),
				Color = COLOR_DASH,
				Material = Enum.Material.Neon,
				Parent = folder,
			})
			zDash += 24
		end
	end
	for _, z in ipairs(Layout.RoadZs) do
		part({
			Name = "RoadH",
			Size = Vector3.new(Config.PlotSize, 0.2, 12),
			Position = Vector3.new(center.X, Config.GroundY + 0.14, center.Z + z),
			Color = COLOR_ROAD,
			Material = Enum.Material.Asphalt,
			Parent = folder,
		})
		local x = -dashLimit
		while x &lt;= dashLimit do
			part({
				Name = "Dash",
				Size = Vector3.new(6, 0.05, 1.6),
				Position = Vector3.new(center.X + x, Config.GroundY + 0.26, center.Z + z),
				Color = COLOR_DASH,
				Material = Enum.Material.Neon,
				Parent = folder,
			})
			x += 24
		end
	end
	-- Zebra crosswalk into the town square.
	for i = 0, 5 do
		part({
			Name = "Zebra",
			Size = Vector3.new(10, 0.05, 1.4),
			Position = Vector3.new(center.X, Config.GroundY + 0.3, center.Z + Config.PlotSize / 2 + 4 + i * 2.6),
			Color = Color3.fromRGB(240, 240, 245),
			Parent = folder,
		})
	end
end

local function buildFence(center, folder)
	local h = 3
	local halfX = Config.PlotSize / 2
	local backZ = -halfX
	local frontZ = halfX + Layout.TownDepth
	local depth = frontZ - backZ
	local midZ = (frontZ + backZ) / 2
	local segs = {
		{ Vector3.new(center.X, Config.GroundY + h / 2, center.Z + backZ), Vector3.new(Config.PlotSize, h, 1) },
		{ Vector3.new(center.X, Config.GroundY + h / 2, center.Z + frontZ), Vector3.new(Config.PlotSize, h, 1) },
		{ Vector3.new(center.X - halfX, Config.GroundY + h / 2, center.Z + midZ), Vector3.new(1, h, depth) },
		{ Vector3.new(center.X + halfX, Config.GroundY + h / 2, center.Z + midZ), Vector3.new(1, h, depth) },
	}
	for _, seg in ipairs(segs) do
		part({
			Name = "Fence",
			Size = seg[2],
			Position = seg[1],
			Color = Color3.fromRGB(196, 164, 108),
			Material = Enum.Material.WoodPlanks,
			Parent = folder,
		})
	end
end

-- One rocket silo (hazard pad + scaffold + blocky rocket). Only silo 1 gets
-- the ProximityPrompt; extra silos are visual + extra firepower.
local function buildSiloGroup(plotIndex, siloIndex, parent)
	local pos = Layout.siloPos(plotIndex, siloIndex)
	local model = Instance.new("Model")
	model.Name = "Silo" .. siloIndex

	studs(part({
		Name = "SiloPad",
		Size = Vector3.new(24, 0.4, 24),
		Position = pos + Vector3.new(0, 0.2, 0),
		Color = Color3.fromRGB(240, 200, 40),
		Material = Enum.Material.DiamondPlate,
		Parent = model,
	}), { Enum.NormalId.Top }, 3)
	for i = -1, 1 do
		part({
			Name = "SiloStripe",
			Size = Vector3.new(3, 0.1, 24),
			Position = pos + Vector3.new(i * 8, 0.5, 0),
			Color = Color3.fromRGB(30, 30, 30),
			Parent = model,
		})
	end
	for _, corner in ipairs({ Vector3.new(-6, 0, -6), Vector3.new(6, 0, -6), Vector3.new(-6, 0, 6), Vector3.new(6, 0, 6) }) do
		part({
			Name = "SiloColumn",
			Size = Vector3.new(1.6, 22, 1.6),
			Position = pos + corner + Vector3.new(0, 11, 0),
			Color = Color3.fromRGB(150, 150, 158),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end

	-- Rocket lives in its own model so it can be scaled up on upgrade.
	local rocketModel = Instance.new("Model")
	rocketModel.Name = "RocketModel"
	local body = part({
		Name = "SiloRocket",
		Size = Vector3.new(4.4, 14, 4.4),
		Position = pos + Vector3.new(0, 8, 0),
		Color = Color3.fromRGB(240, 240, 245),
		Parent = rocketModel,
	})
	studs(body, { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }, 3)
	part({
		Name = "SiloRocketNose",
		Size = Vector3.new(3, 3.6, 3),
		Position = pos + Vector3.new(0, 16.8, 0),
		Color = Color3.fromRGB(230, 60, 60),
		Parent = rocketModel,
	})
	for _, off in ipairs({ Vector3.new(-2.8, 0, 0), Vector3.new(2.8, 0, 0), Vector3.new(0, 0, -2.8), Vector3.new(0, 0, 2.8) }) do
		part({
			Name = "SiloFin",
			Size = Vector3.new(1.2, 4.4, 1.2),
			Position = pos + off + Vector3.new(0, 2.2, 0),
			Color = Color3.fromRGB(230, 60, 60),
			Parent = rocketModel,
		})
	end
	rocketModel.PrimaryPart = body
	rocketModel.Parent = model
	local rocketParts = rocketModel:GetChildren()

	if siloIndex == 1 then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RocketPrompt"
		prompt.ActionText = "Rocket Controls"
		prompt.ObjectText = "Rocket Silo"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 18
		prompt.RequiresLineOfSight = false
		prompt.Parent = body
		local _, label = billboard(body, 18, 6, 14, 300)
		label.Text = "\u{1F680} Rocket Silo"
	end

	model.Parent = parent
	return { model = model, rocketParts = rocketParts, rocketModel = rocketModel, basePos = pos, parent = parent }
end

local function buildTownSquare(plotIndex, folder)
	local c = Layout.plotCenter(plotIndex)
	local half = Config.PlotSize / 2
	local townZ = c.Z + half

	studs(part({
		Name = "Plaza",
		Size = Vector3.new(Config.PlotSize, 0.3, Layout.TownDepth - 4),
		Position = Vector3.new(c.X, Config.GroundY + 0.15, townZ + Layout.TownDepth / 2),
		Color = COLOR_PLAZA,
		Material = Enum.Material.Concrete,
		Parent = folder,
	}), { Enum.NormalId.Top }, 4)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn" .. plotIndex
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(c.X, Config.GroundY + 0.6, townZ + 16)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Color = Color3.fromRGB(90, 160, 240)
	spawn.Parent = folder

	-- Rocket silos (left of spawn). Extra silos start hidden.
	local siloGroups = {}
	for i = 1, Config.Silos.Max do
		siloGroups[i] = buildSiloGroup(plotIndex, i, folder)
		if i &gt; 1 then
			siloGroups[i].model.Parent = nil
		end
	end

	-- Nuke-access pad beside the silos.
	local nukePadPos = Layout.nukePadPos(plotIndex)
	local nukePad = part({
		Name = "NukeBuyPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 12, 12),
		CFrame = CFrame.new(nukePadPos + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(190, 90, 240),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	local _, nukeLabel = billboard(nukePad, 20, 9, 7, 220)
	nukeLabel.Text = "\u{2622}\u{FE0F} NUKE ACCESS\n\u{1F4B5} " .. NumberFormat.abbrev(Config.Nuke.IslandCost)
		.. "\nOne nuke every 24h!"
	local nukePrompt = Instance.new("ProximityPrompt")
	nukePrompt.Name = "NukePrompt"
	nukePrompt.ActionText = "Nuke Controls"
	nukePrompt.ObjectText = "Nuclear Option"
	nukePrompt.HoldDuration = 0
	nukePrompt.MaxActivationDistance = 14
	nukePrompt.RequiresLineOfSight = false
	nukePrompt.Parent = nukePad

	-- Benny's shop stand (right side).
	local standX = c.X + 80
	local standZ = townZ + 34
	part({
		Name = "Counter",
		Size = Vector3.new(10, 3.2, 2),
		Position = Vector3.new(standX, Config.GroundY + 1.6, standZ - 4),
		CanCollide = true,
		Color = Color3.fromRGB(150, 116, 78),
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	})
	part({
		Name = "PostL",
		Size = Vector3.new(0.8, 8, 0.8),
		Position = Vector3.new(standX - 4.5, Config.GroundY + 4, standZ + 1.5),
		Color = Color3.fromRGB(120, 90, 60),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	part({
		Name = "PostR",
		Size = Vector3.new(0.8, 8, 0.8),
		Position = Vector3.new(standX + 4.5, Config.GroundY + 4, standZ + 1.5),
		Color = Color3.fromRGB(120, 90, 60),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for i = 0, 3 do
		part({
			Name = "Awning",
			Size = Vector3.new(2.6, 0.4, 6.5),
			CFrame = CFrame.new(standX - 3.9 + i * 2.6, Config.GroundY + 8.4, standZ - 1)
				* CFrame.Angles(math.rad(-12), 0, 0),
			Color = (i % 2 == 0) and Color3.fromRGB(235, 60, 60) or Color3.fromRGB(240, 240, 245),
			Parent = folder,
		})
	end

	-- Rebirth shrine (far right).
	local shrineX = c.X + 118
	local shrineZ = townZ + 44
	local pedestal = studs(part({
		Name = "Pedestal",
		Size = Vector3.new(7, 2, 7),
		Position = Vector3.new(shrineX, Config.GroundY + 1, shrineZ),
		CanCollide = true,
		Color = Color3.fromRGB(255, 215, 80),
		Material = Enum.Material.Metal,
		Parent = folder,
	}), { Enum.NormalId.Top }, 3)
	local orb = part({
		Name = "Orb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(4, 4, 4),
		Position = Vector3.new(shrineX, Config.GroundY + 4.5, shrineZ),
		Color = Color3.fromRGB(255, 230, 120),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120))
	sparkle.Rate = 5
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.Parent = orb
	local _, shrineLabel = billboard(orb, 18, 7, 5, 240)
	shrineLabel.Text = "\u{1F31F} REBIRTH SHRINE\nReset city \u{2192} PERMANENT\nincome multiplier!"
	shrineLabel.TextColor3 = Color3.fromRGB(255, 230, 120)
	local shrinePrompt = Instance.new("ProximityPrompt")
	shrinePrompt.Name = "RebirthPrompt"
	shrinePrompt.ActionText = "Rebirth"
	shrinePrompt.ObjectText = "Rebirth Shrine"
	shrinePrompt.HoldDuration = 0.5
	shrinePrompt.MaxActivationDistance = 12
	shrinePrompt.RequiresLineOfSight = false
	shrinePrompt.Parent = pedestal

	-- Decorations.
	buildTree(Vector3.new(c.X + 122, Config.GroundY, townZ + 10), folder)
	buildLamp(Vector3.new(c.X - 30, Config.GroundY, townZ + 10), folder)
	buildLamp(Vector3.new(c.X + 30, Config.GroundY, townZ + 10), folder)

	-- Owner banner pole (right of spawn).
	local pole = part({
		Name = "BannerPole",
		Size = Vector3.new(1, 12, 1),
		Position = Vector3.new(c.X + 118, Config.GroundY + 6, townZ + 14),
		Color = Color3.fromRGB(120, 120, 128),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	local bannerGui, bannerLabel = billboard(pole, 26, 8, 8, 1400)
	bannerGui.AlwaysOnTop = true
	bannerLabel.Text = "\u{1F3DD}\u{FE0F} Empty Plot"

	return {
		bannerLabel = bannerLabel,
		boardPos = Vector3.new(c.X, Config.GroundY, townZ + Layout.TownDepth - 6),
		siloGroups = siloGroups,
		nukePad = nukePad,
		npcAnchors = {
			shopkeeper = Vector3.new(standX, Config.GroundY, standZ + 2.5),
			tailor = Vector3.new(c.X + 45, Config.GroundY, townZ + 30),
			mayor = Vector3.new(c.X + 26, Config.GroundY, townZ + 50),
			general = Vector3.new(c.X - 26, Config.GroundY, townZ + 50),
		},
		npcLookAt = Vector3.new(c.X, Config.GroundY, townZ + 16),
	}
end

-- Back strip where silos used to live: now a little stud park.
local function buildPark(plotIndex, folder)
	local c = Layout.plotCenter(plotIndex)
	local z = c.Z - 110
	buildTree(Vector3.new(c.X - 90, Config.GroundY, z), folder, true)
	buildTree(Vector3.new(c.X - 30, Config.GroundY, z + 8), folder)
	buildTree(Vector3.new(c.X + 34, Config.GroundY, z - 6), folder, true)
	buildTree(Vector3.new(c.X + 96, Config.GroundY, z + 4), folder)
	studs(part({
		Name = "ParkRock",
		Size = Vector3.new(6, 3, 5),
		Position = Vector3.new(c.X + 62, Config.GroundY + 1.5, z - 8),
		Color = Color3.fromRGB(130, 130, 136),
		Material = Enum.Material.Slate,
		Parent = folder,
	}), { Enum.NormalId.Top }, 2)
end

local TILE = 54 -- zone tile footprint (grid spacing is 52, small overlap)

-- One self-contained zone "tile": sand skirt, grass ground, a road cross with
-- dashes, sidewalk, buy pad, building model. Lives in its own folder so the
-- island can GROW tile-by-tile as areas unlock.
local function buildZoneTile(plotIndex, zi, plotFolder)
	local zc = Layout.zoneCenter(plotIndex, zi)
	local tile = Instance.new("Folder")
	tile.Name = "Tile" .. zi
	tile.Parent = plotFolder

	part({
		Name = "Skirt",
		Size = Vector3.new(TILE + 3, 8, TILE + 3),
		Position = Vector3.new(zc.X, -1.6, zc.Z),
		Color = COLOR_SAND,
		Material = Enum.Material.Sand,
		Parent = tile,
	})
	local ground = studs(part({
		Name = "Ground",
		Size = Vector3.new(TILE, 10, TILE),
		Position = Vector3.new(zc.X, -1, zc.Z),
		Color = COLOR_GRASS,
		Material = Enum.Material.Grass,
		Parent = tile,
	}), { Enum.NormalId.Top }, 4)
	-- Road cross with centre dashes.
	part({ Name = "RoadV", Size = Vector3.new(12, 0.2, TILE), Position = Vector3.new(zc.X, Config.GroundY + 0.1, zc.Z), Color = COLOR_ROAD, Material = Enum.Material.Asphalt, Parent = tile })
	part({ Name = "RoadH", Size = Vector3.new(TILE, 0.2, 12), Position = Vector3.new(zc.X, Config.GroundY + 0.12, zc.Z), Color = COLOR_ROAD, Material = Enum.Material.Asphalt, Parent = tile })
	for d = -1, 1 do
		part({ Name = "Dash", Size = Vector3.new(1.4, 0.05, 5), Position = Vector3.new(zc.X, Config.GroundY + 0.22, zc.Z + d * 16), Color = COLOR_DASH, Material = Enum.Material.Neon, Parent = tile })
	end

	local sidewalk = part({
		Name = "Sidewalk",
		Size = Vector3.new(Config.ZoneSize + 4, 0.24, Config.ZoneSize + 4),
		Position = Vector3.new(zc.X, Config.GroundY + 0.14, zc.Z),
		Color = COLOR_SIDEWALK,
		Material = Enum.Material.Concrete,
		Parent = tile,
	})
	local plate = studs(part({
		Name = "ZonePlate",
		Size = Vector3.new(Config.ZoneSize, 0.3, Config.ZoneSize),
		Position = Vector3.new(zc.X, Config.GroundY + 0.2, zc.Z),
		Color = COLOR_ZONE,
		Material = Enum.Material.Grass,
		Parent = tile,
	}), { Enum.NormalId.Top }, 4)

	local buildings = Instance.new("Model")
	buildings.Name = "Buildings" .. zi
	buildings.Parent = tile

	local padPos = Layout.padPos(plotIndex, zi)
	local pad = part({
		Name = "Pad" .. zi,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 9, 9),
		CFrame = CFrame.new(padPos.X, Config.GroundY + 0.4, padPos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(80, 235, 90),
		Material = Enum.Material.Neon,
		Transparency = 1,
		Parent = tile,
	})
	local padGui, padLabel = billboard(pad, 16, 8, 7, 180)
	padGui.AlwaysOnTop = false

	return {
		tile = tile,
		ground = ground,
		plate = plate,
		sidewalk = sidewalk,
		pad = pad,
		padLabel = padLabel,
		buildings = buildings,
	}
end

local function buildPlot(plotIndex, root)
	local center = Layout.plotCenter(plotIndex)
	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. plotIndex
	folder.Parent = root

	-- Town square base (always present): the home platform with spawn, silos,
	-- shop, NPCs, leaderboard and rebirth shrine.
	local half = Config.PlotSize / 2
	local townZ = center.Z + half + Layout.TownDepth / 2
	part({
		Name = "TownSkirt",
		Size = Vector3.new(Config.PlotSize + 30, 8, Layout.TownDepth + 80),
		Position = Vector3.new(center.X, -1.6, townZ),
		Color = COLOR_SAND,
		Material = Enum.Material.Sand,
		Parent = folder,
	})
	studs(part({
		Name = "TownGround",
		Size = Vector3.new(Config.PlotSize + 6, 10, Layout.TownDepth + 70),
		Position = Vector3.new(center.X, -1, townZ - 20),
		Color = COLOR_GRASS,
		Material = Enum.Material.Grass,
		Parent = folder,
	}), { Enum.NormalId.Top }, 4)

	local town = buildTownSquare(plotIndex, folder)

	-- Per-zone tiles (hidden/shown by PlotService as areas unlock).
	local zoneData = {}
	for zi = 1, #BuildingDefs.List do
		zoneData[zi] = buildZoneTile(plotIndex, zi, folder)
	end

	return {
		index = plotIndex,
		folder = folder,
		zoneData = zoneData,
		bannerLabel = town.bannerLabel,
		siloGroups = town.siloGroups,
		nukePad = town.nukePad,
		boardPos = town.boardPos,
		npcAnchors = town.npcAnchors,
		npcLookAt = town.npcLookAt,
	}
end

-- Small scenic islands scattered between the player islands.
local function buildFillerIsland(pos, size, root)
	local folder = Instance.new("Folder")
	folder.Name = "FillerIsland"
	folder.Parent = root
	part({
		Name = "FillerSand",
		Size = Vector3.new(size + 14, 7, size + 14),
		Position = pos + Vector3.new(0, -2, 0),
		Color = COLOR_SAND,
		Material = Enum.Material.Sand,
		Parent = folder,
	})
	studs(part({
		Name = "FillerGrass",
		Size = Vector3.new(size, 8, size),
		Position = pos + Vector3.new(0, 0, 0),
		Color = COLOR_GRASS,
		Material = Enum.Material.Grass,
		Parent = folder,
	}), { Enum.NormalId.Top }, 4)
	buildTree(pos + Vector3.new(-size / 5, Config.GroundY, -size / 6), folder, true)
	buildTree(pos + Vector3.new(size / 4, Config.GroundY, size / 5), folder)
	studs(part({
		Name = "FillerRock",
		Size = Vector3.new(5, 2.5, 4),
		Position = pos + Vector3.new(size / 4, Config.GroundY + 1.25, -size / 4),
		Color = Color3.fromRGB(130, 130, 136),
		Material = Enum.Material.Slate,
		Parent = folder,
	}), { Enum.NormalId.Top }, 2)
end

function WorldBuilder.build()
	local root = Instance.new("Folder")
	root.Name = "GameWorld"
	root.Parent = workspace

	-- Ocean.
	workspace.Terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(6000, 10, 6000), Enum.Material.Water)

	local slots = {}
	for i = 1, Config.PlotCount do
		slots[i] = buildPlot(i, root)
	end

	-- Fill the sea between islands with scenery.
	for i = 1, 5 do
		local angle = math.rad(-18 + (i - 1) * 72)
		local pos = Vector3.new(math.cos(angle) * 400, 0, math.sin(angle) * 400)
		buildFillerIsland(pos, 46 + (i % 3) * 14, root)
	end
	buildFillerIsland(Vector3.new(0, 0, 0), 70, root)

	-- Bright cartoon lighting with modern rendering.
	Lighting.Brightness = 3
	Lighting.ClockTime = 13.5
	Lighting.Ambient = Color3.fromRGB(130, 130, 135)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 150, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.15
	Lighting.ExposureCompensation = 0.05
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.58
	clouds.Density = 0.85
	clouds.Parent = workspace.Terrain

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.05
	bloom.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.08
	sunRays.Spread = 0.7
	sunRays.Parent = Lighting

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Saturation = 0.28 -- punchy, saturated colors like the reference
	grade.Contrast = 0.1
	grade.Brightness = 0.02
	grade.TintColor = Color3.fromRGB(255, 252, 245)
	grade.Parent = Lighting

	return {
		root = root,
		slots = slots,
	}
end

return WorldBuilder
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX64"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX59"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX58"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">AdminPanel</string><ProtectedString name="Source">-- Admin Panel: gold badge button (admins only) opening a panel of tools.
-- Self actions, server/cross-server actions, an announce box, and targeted
-- actions (kick/ban/wipe/nuke) against a selected player.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local AdminPanel = {}

local ctx
local buttonGui
local panelGui
local selectedUserId = nil
local selectedName = "(none)"
local targetLabel
local announceBox

local SELF_ACTIONS = {
	{ id = "give_cash", label = "\u{1F4B5} +$1B", arg = 1e9 },
	{ id = "give_gems", label = "\u{1F48E} +1000", arg = 1000 },
	{ id = "max_rockets", label = "\u{1F680} Max Rockets" },
	{ id = "give_nuke", label = "\u{2622}\u{FE0F} Nuke Access" },
	{ id = "unlock_all", label = "\u{1F513} Unlock All" },
	{ id = "repair", label = "\u{1F527} Repair" },
	{ id = "trigger_event", label = "\u{1F3B2} Event" },
	{ id = "trigger_pilot", label = "\u{1F468}\u{200D}\u{2708}\u{FE0F} Pilot" },
}

local SERVER_ACTIONS = {
	{ id = "nuke_server", label = "\u{2622}\u{FE0F} NUKE SERVER", color = "Red" },
	{ id = "nuke_all_servers", label = "\u{2622}\u{FE0F} NUKE ALL SERVERS", color = "Red" },
}

local TARGET_ACTIONS = {
	{ id = "kick", label = "\u{1F462} Kick" },
	{ id = "ban", label = "\u{1F6AB} Ban", color = "Red" },
	{ id = "nuke_player", label = "\u{2622}\u{FE0F} Nuke City" },
	{ id = "take_cash", label = "\u{1F4B8} Wipe Cash" },
	{ id = "take_gems", label = "\u{1F48E} Wipe Gems" },
}

local function refreshTarget()
	targetLabel.Text = "Target: " .. selectedName
end

local function buildPlayerList(parent)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 0, 90)
	scroll.BackgroundColor3 = Color3.fromRGB(28, 30, 40)
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	UILib.corner(scroll, 6)
	scroll.Parent = parent
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.Parent = scroll

	local function rebuild()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			UILib.button({
				Size = UDim2.new(1, -12, 0, 30),
				Text = plr.DisplayName,
				BackgroundColor3 = UILib.Colors.Blue,
			}, scroll, function()
				selectedUserId = plr.UserId
				selectedName = plr.DisplayName
				refreshTarget()
			end)
		end
	end
	rebuild()
	Players.PlayerAdded:Connect(rebuild)
	Players.PlayerRemoving:Connect(rebuild)
end

function AdminPanel.init(context)
	ctx = context

	local pg, content = UILib.panel("MVC_AdminPanel", "\u{1F6E0}\u{FE0F} ADMIN", UDim2.new(0, 460, 0, 560), 35)
	panelGui = pg

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = content
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.Parent = scroll

	local function heading(text)
		UILib.text({
			Size = UDim2.new(1, -8, 0, 22),
			Text = text,
			TextColor3 = Color3.fromRGB(255, 220, 120),
			TextXAlignment = Enum.TextXAlignment.Left,
		}, scroll)
	end

	local function grid(actions)
		local holder = Instance.new("Frame")
		holder.BackgroundTransparency = 1
		holder.Size = UDim2.new(1, 0, 0, math.ceil(#actions / 2) * 42)
		holder.Parent = scroll
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(0.5, -6, 0, 38)
		g.CellPadding = UDim2.new(0, 6, 0, 4)
		g.Parent = holder
		for _, act in ipairs(actions) do
			UILib.button({
				Size = UDim2.new(0.5, -6, 0, 38),
				Text = act.label,
				BackgroundColor3 = act.color and UILib.Colors[act.color] or UILib.Colors.Gold,
			}, holder, function()
				Remotes.Events.AdminAction:FireServer(act.id, act.arg or selectedUserId)
			end)
		end
	end

	heading("\u{1F464} Self")
	grid(SELF_ACTIONS)

	heading("\u{1F310} Server")
	grid(SERVER_ACTIONS)

	heading("\u{1F4E2} Announce")
	announceBox = Instance.new("TextBox")
	announceBox.Size = UDim2.new(1, 0, 0, 34)
	announceBox.BackgroundColor3 = Color3.fromRGB(28, 30, 40)
	announceBox.TextColor3 = Color3.new(1, 1, 1)
	announceBox.Font = UILib.Font
	announceBox.TextSize = 18
	announceBox.PlaceholderText = "Type an announcement..."
	announceBox.Text = ""
	announceBox.ClearTextOnFocus = false
	announceBox.BorderSizePixel = 0
	UILib.corner(announceBox, 6)
	announceBox.Parent = scroll

	local announceHolder = Instance.new("Frame")
	announceHolder.BackgroundTransparency = 1
	announceHolder.Size = UDim2.new(1, 0, 0, 40)
	announceHolder.Parent = scroll
	local ag = Instance.new("UIGridLayout")
	ag.CellSize = UDim2.new(0.5, -6, 0, 38)
	ag.CellPadding = UDim2.new(0, 6, 0, 4)
	ag.Parent = announceHolder
	UILib.button({
		Size = UDim2.new(0.5, -6, 0, 38),
		Text = "\u{1F4E2} This Server",
		BackgroundColor3 = UILib.Colors.Gold,
	}, announceHolder, function()
		Remotes.Events.AdminAction:FireServer("announce_server", announceBox.Text)
	end)
	UILib.button({
		Size = UDim2.new(0.5, -6, 0, 38),
		Text = "\u{1F4E2} All Servers",
		BackgroundColor3 = UILib.Colors.Gold,
	}, announceHolder, function()
		Remotes.Events.AdminAction:FireServer("announce_all", announceBox.Text)
	end)

	heading("\u{1F3AF} Target Player")
	targetLabel = UILib.text({
		Size = UDim2.new(1, -8, 0, 20),
		Text = "Target: (none)",
		TextXAlignment = Enum.TextXAlignment.Left,
	}, scroll)
	buildPlayerList(scroll)
	grid(TARGET_ACTIONS)

	-- Launcher badge button.
	buttonGui = UILib.screen("MVC_AdminBtn", 34)
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.AnchorPoint = Vector2.new(1, 0)
	frame.Position = UDim2.new(1, -14, 0, 130)
	frame.Size = UDim2.new(0, 76, 0, 88)
	frame.Visible = false
	frame.Parent = buttonGui
	local button = UILib.button({
		Size = UDim2.new(0, 68, 0, 60),
		Position = UDim2.new(0, 4, 0, 0),
		Text = "",
		BackgroundColor3 = UILib.Colors.Gold,
	}, frame, function()
		panelGui.Enabled = not panelGui.Enabled
	end)
	local icon = UILib.icon("admin", button)
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.new(0, 40, 0, 40)
	UILib.text({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 0, 62),
		Text = "Admin",
	}, frame)

	ctx.State.changed.Event:Connect(function(state)
		frame.Visible = state.isAdmin == true
	end)
end

return AdminPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">AlarmUI</string><ProtectedString name="Source">-- Incoming-strike warning: flashing red overlay, siren wail, countdown,
-- and a red beacon beam marking exactly where the strike will land.

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)
local NumberFormat = require(Shared.NumberFormat)

local AlarmUI = {}

local player = Players.LocalPlayer
local activeAlarm = nil

local function beacon(pos, duration)
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Size = Vector3.new(2, 120, 2)
	beam.Position = pos + Vector3.new(0, 60, 0)
	beam.Color = Color3.fromRGB(255, 40, 40)
	beam.Material = Enum.Material.Neon
	beam.Transparency = 0.25
	beam.Parent = workspace

	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 30, 30)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = Color3.fromRGB(255, 40, 40)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.3
	ring.Parent = workspace

	task.spawn(function()
		local elapsed = 0
		while elapsed &lt; duration do
			local pulse = TweenService:Create(ring, TweenInfo.new(0.5), { Transparency = 0.75 })
			pulse:Play()
			task.wait(0.5)
			ring.Transparency = 0.3
			elapsed += 0.6
			task.wait(0.1)
		end
		beam:Destroy()
		ring:Destroy()
	end)
end

local function runSiren(duration)
	local sound = SoundBook.make("Siren", { Looped = true })
	if not sound then
		return
	end
	sound.Parent = player:WaitForChild("PlayerGui")
	sound:Play()
	task.spawn(function()
		task.wait(0.8)
		-- Real air-raid siren loaded? Let it wail naturally. Otherwise
		-- pitch-modulate the fallback bass into a siren.
		local isRealSiren = sound.IsLoaded and sound.TimeLength &gt; 3
		local elapsed = 0.8
		local up = true
		while elapsed &lt; duration do
			if not isRealSiren then
				local target = up and 1.4 or 0.55
				TweenService:Create(sound, TweenInfo.new(0.45), { PlaybackSpeed = target }):Play()
				up = not up
			end
			task.wait(0.45)
			elapsed += 0.45
		end
		sound:Stop()
		sound:Destroy()
	end)
end

local function showAlarm(payload)
	if activeAlarm then
		activeAlarm:Destroy()
		activeAlarm = nil
	end

	local isNuke = payload.kind == "nuke"
	local eta = payload.eta or 6

	local gui = Instance.new("ScreenGui")
	gui.Name = "MVC_Alarm"
	gui.DisplayOrder = 60
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	activeAlarm = gui

	local vignette = Instance.new("Frame")
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
	vignette.BackgroundTransparency = 0.85
	vignette.BorderSizePixel = 0
	vignette.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 64)
	title.Position = UDim2.new(0, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 60, 60)
	title.TextStrokeColor3 = Color3.new(0, 0, 0)
	title.TextStrokeTransparency = 0
	local titleByKind = {
		nuke = "\u{2622}\u{FE0F} NUCLEAR STRIKE INCOMING \u{2622}\u{FE0F}",
		jet = "\u{2708}\u{FE0F} ENEMY JETS INBOUND \u{2708}\u{FE0F}",
		battery = "\u{1F680} MISSILE BARRAGE INCOMING \u{1F680}",
		rocket = "\u{1F6A8} INCOMING MISSILE \u{1F6A8}",
	}
	title.Text = titleByKind[payload.kind] or titleByKind.rocket
	title.Parent = gui

	local countdown = Instance.new("TextLabel")
	countdown.Size = UDim2.new(1, 0, 0, 40)
	countdown.Position = UDim2.new(0, 0, 0.16, 66)
	countdown.BackgroundTransparency = 1
	countdown.Font = Enum.Font.FredokaOne
	countdown.TextScaled = true
	countdown.TextColor3 = Color3.new(1, 1, 1)
	countdown.TextStrokeColor3 = Color3.new(0, 0, 0)
	countdown.TextStrokeTransparency = 0
	countdown.Parent = gui

	if typeof(payload.pos) == "Vector3" then
		beacon(payload.pos, eta)
	end
	runSiren(math.min(eta, 15))

	task.spawn(function()
		local deadline = os.clock() + eta
		local flashUp = true
		while os.clock() &lt; deadline and gui.Parent do
			countdown.Text = "Impact in " .. NumberFormat.clock(deadline - os.clock()) .. "!"
			vignette.BackgroundTransparency = flashUp and 0.75 or 0.9
			title.TextTransparency = flashUp and 0 or 0.25
			flashUp = not flashUp
			task.wait(0.4)
		end
		if gui.Parent then
			gui:Destroy()
		end
		if activeAlarm == gui then
			activeAlarm = nil
		end
	end)
end

function AlarmUI.init()
	Remotes.Events.Alarm.OnClientEvent:Connect(function(payload)
		if type(payload) == "table" then
			showAlarm(payload)
		end
	end)
end

return AlarmUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">AttackView</string><ProtectedString name="Source">-- Top-down attack view. Modes:
--   rocket / nuke : aim a crosshair (tap to place), then BLOW UP.
--   jet           : no aiming; choose BOMB CITY or BOMB SILOS.
--   battery       : no aiming; BLOW UP rains a random volley.
-- Works on PC, mobile and console (ScreenPointToRay handles the GUI inset).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local AttackView = {}

local ctx
local player = Players.LocalPlayer

local function camera()
	return workspace.CurrentCamera
end

local gui
local nameLabel
local hintLabel
local fireButton
local altButton -- "Bomb Silos" in jet mode
local barrageButton
local isOpen = false
local mode = "rocket"
local useBarrage = false
local targets = {}
local targetIndex = 1
local crosshairPos = nil
local crosshair = nil
local inputConn = nil

local function needsAim()
	return mode == "rocket" or mode == "nuke"
end

local function destroyCrosshair()
	if crosshair then
		crosshair:Destroy()
		crosshair = nil
	end
end

local function placeCrosshair(pos)
	destroyCrosshair()
	crosshairPos = pos
	if not needsAim() then
		return
	end
	local model = Instance.new("Model")
	model.Name = "MVC_Crosshair"
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 20, 20)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = Color3.fromRGB(255, 40, 40)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.25
	ring.Parent = model
	local dot = Instance.new("Part")
	dot.Anchored = true
	dot.CanCollide = false
	dot.CanQuery = false
	dot.CanTouch = false
	dot.Shape = Enum.PartType.Ball
	dot.Size = Vector3.new(4, 4, 4)
	dot.Position = pos + Vector3.new(0, 2, 0)
	dot.Color = Color3.fromRGB(255, 40, 40)
	dot.Material = Enum.Material.Neon
	dot.Parent = model
	model.Parent = workspace
	crosshair = model
end

local function currentTarget()
	return targets[targetIndex]
end

local function focusTarget()
	local target = currentTarget()
	if not target then
		return
	end
	nameLabel.Text = (target.immune and "\u{1F6E1}\u{FE0F} " or "") .. target.name
	local center = Layout.plotCenter(target.plotIndex)
	placeCrosshair(Vector3.new(center.X, Layout.GroundY, center.Z))
	TweenService:Create(camera(), TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = Layout.attackCameraCFrame(target.plotIndex),
	}):Play()
end

local function cycle(direction)
	if #targets == 0 then
		return
	end
	targetIndex = ((targetIndex - 1 + direction) % #targets) + 1
	focusTarget()
end

local function updateButtons()
	local state = ctx.State.get()
	if not state then
		return
	end
	barrageButton.Visible = false
	altButton.Visible = false

	if mode == "nuke" then
		local remaining = ctx.State.remaining("nukeRemaining")
		fireButton.Text = remaining &gt; 0 and ("\u{2622}\u{FE0F} " .. NumberFormat.clock(remaining)) or "\u{2622}\u{FE0F} NUKE"
		fireButton.BackgroundColor3 = UILib.Colors.Purple
	elseif mode == "jet" then
		local remaining = ctx.State.remaining("jetRemaining")
		fireButton.Text = remaining &gt; 0 and ("\u{2708}\u{FE0F} " .. NumberFormat.clock(remaining)) or "\u{2708}\u{FE0F} BOMB CITY"
		fireButton.BackgroundColor3 = UILib.Colors.Blue
		altButton.Visible = true
		altButton.Text = "\u{1F680} BOMB SILOS"
	elseif mode == "battery" then
		local remaining = ctx.State.remaining("batteryRemaining")
		fireButton.Text = remaining &gt; 0 and ("\u{1F680} " .. NumberFormat.clock(remaining)) or "\u{1F680} BLOW UP"
		fireButton.BackgroundColor3 = UILib.Colors.Red
	else -- rocket
		local remaining = ctx.State.remaining("rocketRemaining")
		fireButton.Text = remaining &gt; 0 and ("\u{23F3} " .. NumberFormat.clock(remaining)) or ("BLOW UP x" .. (state.siloCount or 1))
		fireButton.BackgroundColor3 = UILib.Colors.Red
		local barrage = state.barrage or 0
		barrageButton.Visible = barrage &gt; 0
		barrageButton.Text = (useBarrage and "\u{2705} " or "") .. "\u{1F680}x3 Barrage (" .. barrage .. ")"
	end
end

function AttackView.close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	destroyCrosshair()
	if inputConn then
		inputConn:Disconnect()
		inputConn = nil
	end
	local cam = camera()
	cam.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		cam.CameraSubject = humanoid
	end
end

local function fire(jetMode)
	local target = currentTarget()
	local state = ctx.State.get()
	if not target or not state then
		return
	end
	if mode == "nuke" then
		if ctx.State.remaining("nukeRemaining") &gt; 0 or not crosshairPos then
			return
		end
		Remotes.Events.RequestLaunch:FireServer(target.userId, crosshairPos.X, crosshairPos.Z, true, false)
	elseif mode == "jet" then
		if ctx.State.remaining("jetRemaining") &gt; 0 then
			return
		end
		Remotes.Events.RequestJet:FireServer(target.userId, jetMode or "city")
	elseif mode == "battery" then
		if ctx.State.remaining("batteryRemaining") &gt; 0 then
			return
		end
		Remotes.Events.RequestBattery:FireServer(target.userId)
	else
		if ctx.State.remaining("rocketRemaining") &gt; 0 or not crosshairPos then
			return
		end
		Remotes.Events.RequestLaunch:FireServer(target.userId, crosshairPos.X, crosshairPos.Z, false, useBarrage)
	end
	useBarrage = false
	task.delay(0.4, AttackView.close)
end

local function onTap(input, gameProcessed)
	if gameProcessed or not isOpen or not needsAim() then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	local target = currentTarget()
	if not target then
		return
	end
	-- ScreenPointToRay accounts for the top GUI inset, so the crosshair lands
	-- exactly under the tap on both PC and mobile.
	local ray = camera():ScreenPointToRay(input.Position.X, input.Position.Y)
	if math.abs(ray.Direction.Y) &lt; 1e-4 then
		return
	end
	local t = (Layout.GroundY - ray.Origin.Y) / ray.Direction.Y
	if t &lt;= 0 then
		return
	end
	local hit = ray.Origin + ray.Direction * t
	placeCrosshair(Layout.clampToPlot(target.plotIndex, hit))
end

function AttackView.open(openMode)
	local ok, result = pcall(function()
		return Remotes.Functions.GetTargets:InvokeServer()
	end)
	if not ok or type(result) ~= "table" or #result == 0 then
		ctx.Notifier.show("No other players to attack yet!", "info")
		return
	end
	targets = result
	targetIndex = 1
	mode = openMode or "rocket"
	useBarrage = false
	isOpen = true
	gui.Enabled = true

	hintLabel.Text = needsAim() and "Tap anywhere on their city to aim!"
		or (mode == "jet" and "Choose your jet target — no aiming needed!"
			or "No aiming — missiles rain across their whole city!")

	camera().CameraType = Enum.CameraType.Scriptable
	focusTarget()
	updateButtons()
	inputConn = UserInputService.InputBegan:Connect(onTap)
end

function AttackView.init(context)
	ctx = context
	gui = UILib.screen("MVC_AttackView", 20)
	gui.Enabled = false

	local banner = UILib.frame({
		Size = UDim2.new(0, 380, 0, 52),
		Position = UDim2.new(0.5, 0, 0, 18),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = UILib.Colors.Panel,
		BackgroundTransparency = 0.25,
	}, gui)

	UILib.button({
		Size = UDim2.new(0, 54, 0, 40),
		Position = UDim2.new(0, 6, 0, 6),
		Text = "\u{25C0}\u{25C0}",
		BackgroundColor3 = UILib.Colors.LightBlue,
	}, banner, function()
		cycle(-1)
	end)

	nameLabel = UILib.text({
		Size = UDim2.new(1, -132, 1, -12),
		Position = UDim2.new(0, 66, 0, 6),
		Text = "",
	}, banner)

	UILib.button({
		Size = UDim2.new(0, 54, 0, 40),
		Position = UDim2.new(1, -60, 0, 6),
		Text = "\u{25B6}\u{25B6}",
		BackgroundColor3 = UILib.Colors.LightBlue,
	}, banner, function()
		cycle(1)
	end)

	hintLabel = UILib.text({
		Size = UDim2.new(0, 460, 0, 24),
		Position = UDim2.new(0.5, 0, 0, 74),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 230, 160),
	}, gui)

	fireButton = UILib.button({
		Size = UDim2.new(0, 300, 0, 74),
		Position = UDim2.new(0.5, 0, 1, -170),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "BLOW UP",
		BackgroundColor3 = UILib.Colors.Red,
	}, gui, function()
		fire("city")
	end)

	altButton = UILib.button({
		Size = UDim2.new(0, 260, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -232),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "\u{1F680} BOMB SILOS",
		BackgroundColor3 = UILib.Colors.Purple,
		Visible = false,
	}, gui, function()
		fire("silos")
	end)

	barrageButton = UILib.button({
		Size = UDim2.new(0, 240, 0, 44),
		Position = UDim2.new(0.5, 0, 1, -232),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		BackgroundColor3 = UILib.Colors.Purple,
		Visible = false,
	}, gui, function()
		useBarrage = not useBarrage
		updateButtons()
	end)

	UILib.button({
		Size = UDim2.new(0, 200, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -84),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "CANCEL",
		BackgroundColor3 = UILib.Colors.Gray,
	}, gui, AttackView.close)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if isOpen then
				updateButtons()
			end
		end
	end)

	ctx.State.changed.Event:Connect(function()
		if isOpen then
			updateButtons()
		end
	end)
end

return AttackView
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">CashPopups</string><ProtectedString name="Source">-- Floating green "+$" popups above earning buildings, like the reference game.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)
local ClientState = require(script.Parent.ClientState)
local UILib = require(script.Parent.UILib)

local CashPopups = {}

local active = 0
local MAX_ACTIVE = 45
local rng = Random.new()
local lastCollectSound = 0

local function popup(worldPos, amount)
	if active &gt;= MAX_ACTIVE then
		return
	end
	active += 1

	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.5, 0.5, 0.5)
	holder.Position = worldPos + Vector3.new(rng:NextNumber(-8, 8), 10, rng:NextNumber(-8, 8))
	holder.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(12, 0, 4, 0)
	gui.StudsOffset = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 400
	gui.Parent = holder

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(110, 240, 90)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = "+" .. NumberFormat.abbrev(amount)
	label.Parent = gui

	TweenService:Create(gui, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = Vector3.new(0, 9, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()

	task.delay(1.25, function()
		holder:Destroy()
		active -= 1
	end)
end

function CashPopups.init()
	Remotes.Events.IncomePops.OnClientEvent:Connect(function(plotIndex, pops)
		if type(plotIndex) ~= "number" or type(pops) ~= "table" then
			return
		end
		for _, entry in ipairs(pops) do
			local zi, amt = entry[1], entry[2]
			if type(zi) == "number" and type(amt) == "number" then
				popup(Layout.zoneCenter(plotIndex, zi), amt)
			end
		end
		-- Coin sound when it's YOUR city collecting (throttled).
		local state = ClientState.get()
		if state and state.plotIndex == plotIndex and os.clock() - lastCollectSound &gt; 0.12 then
			lastCollectSound = os.clock()
			SoundBook.play("Collect", UILib.playerGui())
		end
	end)
end

return CashPopups
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">CharacterShop</string><ProtectedString name="Source">-- Tilly's Character Shop: speed/jump tiers, rainbow trail and titles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local CharacterShop = {}

local ctx
local gui
local buttons = {}

local function makeItem(content, order, id, color)
	local button = UILib.button({
		Size = UDim2.new(1, -16, 0, 46),
		Position = UDim2.new(0, 8, 0, 8 + (order - 1) * 56),
		Text = "",
		BackgroundColor3 = color or UILib.Colors.Green,
	}, content, function()
		Remotes.Events.ShopBuy:FireServer(id)
	end)
	buttons[id] = button
	return button
end

local function refresh()
	local state = ctx.State.get()
	local cos = state and state.cosmetics or {}
	local speedTier = cos.speed or 0
	local jumpTier = cos.jump or 0

	local speedCost = Config.Character.SpeedCosts[speedTier + 1]
	buttons.cos_speed.Text = speedCost
		and ("\u{1F45F} Speed Boost " .. (speedTier + 1) .. "/3 — \u{1F48E} " .. speedCost)
		or "\u{1F45F} Speed Boost MAXED!"

	local jumpCost = Config.Character.JumpCosts[jumpTier + 1]
	buttons.cos_jump.Text = jumpCost
		and ("\u{1F998} Jump Boost " .. (jumpTier + 1) .. "/3 — \u{1F48E} " .. jumpCost)
		or "\u{1F998} Jump Boost MAXED!"

	buttons.cos_trail.Text = cos.trail
		and "\u{1F308} Rainbow Trail OWNED!"
		or ("\u{1F308} Rainbow Trail — \u{1F48E} " .. Config.Character.TrailCost)

	for _, titleDef in ipairs(Config.Character.Titles) do
		local button = buttons["cos_title_" .. titleDef.id]
		if button then
			button.Text = (cos.title == titleDef.id and "\u{2705} " or "")
				.. titleDef.label .. " — \u{1F48E} " .. titleDef.cost
		end
	end
end

function CharacterShop.toggle()
	gui.Enabled = not gui.Enabled
	if gui.Enabled then
		refresh()
	end
end

function CharacterShop.init(context)
	ctx = context
	local panelGui, content = UILib.panel("MVC_CharShop", "\u{2728} Character Shop", UDim2.new(0, 400, 0, 400), 12)
	gui = panelGui

	makeItem(content, 1, "cos_speed")
	makeItem(content, 2, "cos_jump")
	makeItem(content, 3, "cos_trail", UILib.Colors.Purple)
	local order = 4
	for _, titleDef in ipairs(Config.Character.Titles) do
		makeItem(content, order, "cos_title_" .. titleDef.id, UILib.Colors.Gold)
		order += 1
	end

	ctx.State.changed.Event:Connect(function()
		if gui.Enabled then
			refresh()
		end
	end)
end

return CharacterShop
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">ClientState</string><ProtectedString name="Source">-- Client-side mirror of the player's server state, with local countdown helpers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = {}

ClientState.data = nil
ClientState.changed = Instance.new("BindableEvent")

local receivedAt = 0

Remotes.Events.State.OnClientEvent:Connect(function(snapshot)
	ClientState.data = snapshot
	receivedAt = os.clock()
	ClientState.changed:Fire(snapshot)
end)

function ClientState.get()
	return ClientState.data
end

-- For fields sent as "seconds remaining": returns live remaining seconds.
function ClientState.remaining(field)
	local data = ClientState.data
	if not data or not data[field] then
		return 0
	end
	return math.max(0, data[field] - (os.clock() - receivedAt))
end

function ClientState.start()
	task.spawn(function()
		while not ClientState.data do
			local ok = pcall(function()
				Remotes.Functions.GetSnapshot:InvokeServer()
			end)
			if not ok then
				task.wait(1)
			end
			task.wait(0.5)
		end
	end)
end

return ClientState
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">DailyRewardsUI</string><ProtectedString name="Source">-- Daily Rewards calendar: 6 blue day-cards in a grid plus the tall
-- rainbow Day 7 card (free nuke), just like the reference screenshots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local DailyRewardsUI = {}

local ctx
local gui
local cards = {}
local dailyData = nil

local function makeCard(parent, dayNumber, big)
	local reward = Config.DailyRewards[dayNumber]
	local card
	if big then
		-- Rainbow Day 7 card (its own gradient, so not UILib.card).
		card = UILib.frame({
			Size = UDim2.new(0, 150, 0, 268),
			BackgroundColor3 = UILib.Colors.LightBlue,
		}, parent)
		UILib.studOverlay(card, 0.84, 10)
		local rainbow = Instance.new("UIGradient")
		rainbow.Rotation = 90
		rainbow.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 60)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 220, 90)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 160, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 90, 240)),
		})
		rainbow.Parent = card
	else
		card = UILib.card({
			Size = UDim2.new(0, 118, 0, 128),
			BackgroundColor3 = Color3.fromRGB(130, 200, 235),
		}, parent)
	end

	UILib.text({
		Size = UDim2.new(1, -8, 0, big and 34 or 24),
		Position = UDim2.new(0, 4, 0, 4),
		Text = "DAY " .. dayNumber,
	}, card)

	-- Holder for a 3D reward icon (populated in refresh from the reward kind).
	local iconHolder = Instance.new("Frame")
	iconHolder.Name = "IconHolder"
	iconHolder.BackgroundTransparency = 1
	iconHolder.Size = UDim2.new(1, -8, 0, big and 80 or 46)
	iconHolder.Position = UDim2.new(0, 4, 0, big and 44 or 26)
	iconHolder.Parent = card

	local emojiLabel = UILib.text({
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		Text = reward and reward.emoji or "\u{2753}",
	}, iconHolder)

	local nameLabel = UILib.text({
		Size = UDim2.new(1, -8, 0, big and 30 or 20),
		Position = UDim2.new(0, 4, 0, big and 130 or 66),
		Text = reward and reward.label or "Mystery",
		TextColor3 = big and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(235, 250, 255),
	}, card)

	local statusButton = UILib.button({
		Size = UDim2.new(1, -16, 0, big and 44 or 32),
		Position = UDim2.new(0, 8, 1, big and -52 or -38),
		Text = "Locked!",
		BackgroundColor3 = UILib.Colors.Gray,
	}, card, function()
		if dailyData and dailyData.canClaim and dailyData.dayIndex == dayNumber then
			Remotes.Events.ClaimDaily:FireServer()
		end
	end)

	cards[dayNumber] = { button = statusButton, emoji = emojiLabel, name = nameLabel, iconHolder = iconHolder }
	return card
end

-- Reward kind -&gt; 3D icon builder kind.
local REWARD_ICON = {
	gems = "gem", cash_minutes = "cash", shield = "shield",
	barrage = "rocket", nuke_charge = "rocket",
}

local function refresh()
	if not dailyData then
		return
	end
	-- Paint the randomized rewards the server sent this cycle.
	if dailyData.rewards then
		for dayNumber, card in pairs(cards) do
			local reward = dailyData.rewards[dayNumber]
			if reward then
				card.name.Text = reward.label
				-- Swap in a 3D model icon for this reward, or keep the emoji.
				local iconKind = REWARD_ICON[reward.kind]
				local existing = card.iconHolder:FindFirstChild("Icon3D")
				if existing then
					existing:Destroy()
				end
				if iconKind then
					card.emoji.Visible = false
					local vp = UILib.viewportIcon(iconKind, card.iconHolder)
					if vp then
						vp.Name = "Icon3D"
					else
						card.emoji.Visible = true
						card.emoji.Text = reward.emoji
					end
				else
					card.emoji.Visible = true
					card.emoji.Text = reward.emoji
				end
			end
		end
	end
	for dayNumber, card in pairs(cards) do
		local button = card.button
		if dayNumber &lt; dailyData.dayIndex then
			button.Text = "Claimed"
			button.BackgroundColor3 = UILib.Colors.Gray
		elseif dayNumber == dailyData.dayIndex then
			if dailyData.canClaim then
				button.Text = "CLAIM!"
				button.BackgroundColor3 = UILib.Colors.Green
			else
				button.Text = NumberFormat.clock(dailyData.nextIn)
				button.BackgroundColor3 = UILib.Colors.DarkGray
			end
		else
			button.Text = "Locked!"
			button.BackgroundColor3 = UILib.Colors.Gray
		end
	end
end

function DailyRewardsUI.toggle()
	gui.Enabled = not gui.Enabled
	if gui.Enabled then
		refresh()
	end
end

function DailyRewardsUI.init(context)
	ctx = context

	local panelGui, content = UILib.panel("MVC_Daily", "DAILY REWARDS", UDim2.new(0, 560, 0, 320), 12)
	gui = panelGui

	-- Calendar badge sticking out of the header's top-left (reference style).
	local frame = content.Parent
	local badge = UILib.frame({
		Size = UDim2.new(0, 60, 0, 64),
		Position = UDim2.new(0, -8, 0, -40),
		BackgroundColor3 = Color3.fromRGB(245, 245, 250),
	}, frame)
	UILib.frame({
		Size = UDim2.new(1, -8, 0, 20),
		Position = UDim2.new(0, 4, 0, 4),
		BackgroundColor3 = UILib.Colors.Red,
	}, badge)
	UILib.text({
		Size = UDim2.new(1, -8, 0, 32),
		Position = UDim2.new(0, 4, 0, 26),
		Text = "31",
		TextColor3 = Color3.fromRGB(40, 50, 80),
	}, badge)

	-- Days 1-6 in a 3x2 grid on the left.
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Size = UDim2.new(0, 380, 1, -10)
	grid.Position = UDim2.new(0, 0, 0, 5)
	grid.Parent = content
	for day = 1, 6 do
		local card = makeCard(grid, day, false)
		local col = (day - 1) % 3
		local row = (day - 1) // 3
		card.Position = UDim2.new(0, col * 128, 0, row * 140)
	end

	-- Big Day 7 card on the right.
	local day7 = makeCard(content, 7, true)
	day7.Position = UDim2.new(1, -156, 0, 5)

	Remotes.Events.DailyData.OnClientEvent:Connect(function(data)
		dailyData = data
		refresh()
	end)
	ctx.State.changed.Event:Connect(function(state)
		if state.daily then
			dailyData = state.daily
			if gui.Enabled then
				refresh()
			end
		end
	end)

	-- Live countdown while the panel is open.
	task.spawn(function()
		while true do
			task.wait(1)
			if gui.Enabled and dailyData and not dailyData.canClaim and dailyData.nextIn &gt; 0 then
				dailyData.nextIn = math.max(0, dailyData.nextIn - 1)
				if dailyData.nextIn == 0 then
					dailyData.canClaim = true
				end
				refresh()
			end
		end
	end)
end

return DailyRewardsUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">Dialogue</string><ProtectedString name="Source">-- NPC dialogue box: typewriter text with blip sounds, Next/Bye buttons,
-- and an action button on the last line (open shop, view quests, ...).

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NPCDefs = require(Shared.NPCDefs)
local SoundBook = require(Shared.SoundBook)
local UILib = require(script.Parent.UILib)

local Dialogue = {}

local ctx
local gui
local nameLabel
local textLabel
local nextButton
local actionButton

local currentNpc = nil
local lineIndex = 1
local typing = false
local typeToken = 0

local function typeLine(text)
	typeToken += 1
	local token = typeToken
	typing = true
	textLabel.Text = ""
	task.spawn(function()
		for i = 1, #text do
			if token ~= typeToken then
				return
			end
			-- Never split a UTF-8 character (emoji are multi-byte).
			local safe = text:sub(1, i)
			local lastOk = utf8.len(safe)
			if lastOk then
				textLabel.Text = safe
				if i % 3 == 0 then
					SoundBook.play("Blip", UILib.playerGui())
				end
			end
			task.wait(0.018)
		end
		if token == typeToken then
			textLabel.Text = text
			typing = false
		end
	end)
end

local function showLine()
	local def = currentNpc
	if not def then
		return
	end
	local isLast = lineIndex &gt;= #def.lines
	typeLine(def.lines[lineIndex])
	nextButton.Text = isLast and "Bye!" or "Next \u{25B6}"
	actionButton.Visible = isLast and def.action ~= nil
	if isLast and def.action then
		actionButton.Text = def.actionLabel or "Okay"
	end
end

function Dialogue.close()
	currentNpc = nil
	gui.Enabled = false
end

function Dialogue.open(npcId)
	local def = NPCDefs.ById[npcId]
	if not def then
		return
	end
	currentNpc = def
	lineIndex = 1
	nameLabel.Text = def.emoji .. " " .. def.name
	gui.Enabled = true
	SoundBook.play("PanelOpen", UILib.playerGui())
	showLine()
end

local function doAction()
	local def = currentNpc
	Dialogue.close()
	if not def then
		return
	end
	if def.action == "shop" then
		ctx.ShopToggle()
	elseif def.action == "charshop" then
		ctx.CharShop.toggle()
	elseif def.action == "quest" then
		ctx.QuestUI.toggle()
	end
end

function Dialogue.init(context)
	ctx = context

	gui = UILib.screen("MVC_Dialogue", 25)
	gui.Enabled = false

	local box = UILib.frame({
		Size = UDim2.new(0, 560, 0, 170),
		Position = UDim2.new(0.5, 0, 1, -30),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.05,
	}, gui)

	local header = UILib.frame({
		Size = UDim2.new(0, 320, 0, 40),
		Position = UDim2.new(0, 14, 0, -20),
		BackgroundColor3 = UILib.Colors.Blue,
	}, box)
	nameLabel = UILib.text({
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.new(0, 6, 0, 4),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
	}, header)

	textLabel = UILib.text({
		Size = UDim2.new(1, -28, 0, 74),
		Position = UDim2.new(0, 14, 0, 28),
		Text = "",
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextScaled = false,
		TextSize = 22,
	}, box)

	nextButton = UILib.button({
		Size = UDim2.new(0, 130, 0, 42),
		Position = UDim2.new(1, -144, 1, -54),
		Text = "Next \u{25B6}",
		BackgroundColor3 = UILib.Colors.Green,
	}, box, function()
		if not currentNpc then
			return
		end
		if typing then
			typeToken += 1
			typing = false
			textLabel.Text = currentNpc.lines[lineIndex]
			return
		end
		if lineIndex &gt;= #currentNpc.lines then
			Dialogue.close()
		else
			lineIndex += 1
			showLine()
		end
	end)

	actionButton = UILib.button({
		Size = UDim2.new(0, 220, 0, 42),
		Position = UDim2.new(0, 14, 1, -54),
		Text = "",
		BackgroundColor3 = UILib.Colors.Purple,
		Visible = false,
	}, box, doAction)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local id = prompt.Name:match("^TalkPrompt_(.+)$")
		if id then
			Dialogue.open(id)
		end
	end)
end

return Dialogue
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">FX</string><ProtectedString name="Source">-- All combat visuals: rocket/nuke flights along an arc, explosions,
-- the full nuke sequence (flash, fireball, mushroom cloud, shockwave),
-- shield domes and camera shake. Purely cosmetic — damage is server-side.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)

local FX = {}

local player = Players.LocalPlayer
local rng = Random.new()

local function anchoredPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or workspace
	return p
end

local function shake(magnitude, duration)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	task.spawn(function()
		local elapsed = 0
		while elapsed &lt; duration do
			local dt = task.wait()
			elapsed += dt
			local decay = 1 - elapsed / duration
			humanoid.CameraOffset = Vector3.new(
				rng:NextNumber(-1, 1),
				rng:NextNumber(-1, 1),
				rng:NextNumber(-1, 1)
			) * magnitude * decay
		end
		humanoid.CameraOffset = Vector3.new(0, 0, 0)
	end)
end

local function shakeFromDistance(pos, basePower, maxRange, duration)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local dist = (hrp.Position - pos).Magnitude
	if dist &gt; maxRange then
		return
	end
	shake(basePower * (1 - dist / maxRange), duration)
end

local function debris(pos, count, power, color)
	for _ = 1, count do
		local piece = Instance.new("Part")
		piece.Size = Vector3.new(rng:NextNumber(1, 2.5), rng:NextNumber(1, 2.5), rng:NextNumber(1, 2.5))
		piece.Position = pos + Vector3.new(rng:NextNumber(-3, 3), 3, rng:NextNumber(-3, 3))
		piece.Color = color
		piece.CanCollide = false
		piece.CanQuery = false
		piece.AssemblyLinearVelocity = Vector3.new(
			rng:NextNumber(-power, power),
			rng:NextNumber(power * 0.6, power * 1.4),
			rng:NextNumber(-power, power)
		)
		piece.Parent = workspace
		task.delay(2.5, function()
			piece:Destroy()
		end)
	end
end

local function fadeOut(part, duration)
	local tween = TweenService:Create(part, TweenInfo.new(duration), { Transparency = 1 })
	tween:Play()
	tween.Completed:Once(function()
		part:Destroy()
	end)
end

local function explosionFX(pos)
	-- Layered boom: crunch + deep thump reads much bigger than one sample.
	SoundBook.playAt("Explosion", pos, { PlaybackSpeed = rng:NextNumber(0.55, 0.75), RollOffMaxDistance = 600 })
	SoundBook.playAt("BigRumble", pos, { PlaybackSpeed = 0.45, Volume = 0.7, RollOffMaxDistance = 600 })
	SoundBook.playAt("Glass", pos, { PlaybackSpeed = rng:NextNumber(0.8, 1), Volume = 0.35, RollOffMaxDistance = 400 })

	local boom = Instance.new("Explosion")
	boom.Position = pos
	boom.BlastPressure = 0
	boom.BlastRadius = 0
	boom.DestroyJointRadiusPercent = 0
	boom.Parent = workspace

	local flash = anchoredPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(6, 6, 6),
		Position = pos + Vector3.new(0, 4, 0),
		Color = Color3.fromRGB(255, 190, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
	})
	TweenService:Create(flash, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(60, 60, 60),
	}):Play()
	fadeOut(flash, 0.5)

	debris(pos, 8, 40, Color3.fromRGB(80, 75, 70))
	shakeFromDistance(pos, 1.6, 300, 0.6)
end

local function nukeFX(pos)
	-- Blinding flash overlay.
	local gui = Instance.new("ScreenGui")
	gui.Name = "MVC_NukeFlash"
	gui.DisplayOrder = 100
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	local white = Instance.new("Frame")
	white.Size = UDim2.fromScale(1, 1)
	white.BackgroundColor3 = Color3.new(1, 1, 1)
	white.BorderSizePixel = 0
	white.Parent = gui
	local flashTween = TweenService:Create(white, TweenInfo.new(2.2, Enum.EasingStyle.Quad), {
		BackgroundTransparency = 1,
	})
	flashTween:Play()
	flashTween.Completed:Once(function()
		gui:Destroy()
	end)

	SoundBook.playAt("Nuke", pos, { RollOffMaxDistance = 3000 })
	SoundBook.playAt("BigRumble", pos, { PlaybackSpeed = 0.35, Volume = 0.8, RollOffMaxDistance = 3000 })
	SoundBook.playAt("Flash", pos, { RollOffMaxDistance = 3000 })

	-- Fireball.
	local fireball = anchoredPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(10, 10, 10),
		Position = pos + Vector3.new(0, 10, 0),
		Color = Color3.fromRGB(255, 160, 40),
		Material = Enum.Material.Neon,
	})
	TweenService:Create(fireball, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(130, 130, 130),
		Position = pos + Vector3.new(0, 45, 0),
	}):Play()
	fadeOut(fireball, 2.4)

	-- Shockwave ring (flattened, expanding cylinder).
	local ring = anchoredPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 8, 8),
		CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 240, 200),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	})
	TweenService:Create(ring, TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.6, 560, 560),
	}):Play()
	fadeOut(ring, 2.2)

	-- Mushroom cloud: stem grows, cap rises.
	local stem = anchoredPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 22, 22),
		CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(140, 120, 110),
		Material = Enum.Material.Smoke,
		Transparency = 0.15,
	})
	TweenService:Create(stem, TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(110, 30, 30),
		CFrame = CFrame.new(pos + Vector3.new(0, 55, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}):Play()

	local cap = anchoredPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(26, 20, 26),
		Position = pos + Vector3.new(0, 30, 0),
		Color = Color3.fromRGB(160, 140, 125),
		Material = Enum.Material.Smoke,
		Transparency = 0.1,
	})
	TweenService:Create(cap, TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(120, 70, 120),
		Position = pos + Vector3.new(0, 118, 0),
	}):Play()

	task.delay(5.5, function()
		fadeOut(stem, 3)
		fadeOut(cap, 3)
	end)

	debris(pos, 16, 90, Color3.fromRGB(70, 65, 60))
	shakeFromDistance(pos, 3.2, 2000, 2.2)
end

local function quadBezier(p0, p1, p2, t)
	local a = p0:Lerp(p1, t)
	local b = p1:Lerp(p2, t)
	return a:Lerp(b, t)
end

local function buildRocketModel(isNuke)
	local model = Instance.new("Model")
	local body = anchoredPart({
		Name = "Body",
		Size = isNuke and Vector3.new(6, 6, 18) or Vector3.new(3, 3, 9),
		Color = isNuke and Color3.fromRGB(60, 62, 68) or Color3.fromRGB(240, 240, 245),
		Parent = model,
	})
	local nose = anchoredPart({
		Name = "Nose",
		Size = isNuke and Vector3.new(4, 4, 5) or Vector3.new(2, 2, 3),
		Color = isNuke and Color3.fromRGB(180, 235, 60) or Color3.fromRGB(230, 60, 60),
		Material = isNuke and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		Parent = model,
	})
	local att = Instance.new("Attachment")
	att.Parent = body
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = "rbxasset://textures/particles/smoke_main.dds"
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 170, 60), Color3.fromRGB(120, 120, 120))
	fire.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, isNuke and 6 or 3),
		NumberSequenceKeypoint.new(1, isNuke and 12 or 6),
	})
	fire.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	fire.Lifetime = NumberRange.new(0.6, 1.1)
	fire.Rate = 40
	fire.Speed = NumberRange.new(4, 8)
	fire.Parent = att
	model.PrimaryPart = body
	return model, body, nose
end

local function launchPadSmoke(pos)
	local holder = anchoredPart({
		Size = Vector3.new(2, 1, 2),
		Position = pos + Vector3.new(0, 1, 0),
		Transparency = 1,
	})
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(230, 230, 230), Color3.fromRGB(150, 150, 150))
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 4),
		NumberSequenceKeypoint.new(1, 10),
	})
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Lifetime = NumberRange.new(0.8, 1.6)
	smoke.Rate = 60
	smoke.Speed = NumberRange.new(8, 16)
	smoke.SpreadAngle = Vector2.new(80, 80)
	smoke.Parent = holder
	task.delay(2, function()
		smoke.Enabled = false
	end)
	task.delay(4, function()
		holder:Destroy()
	end)
end

local function flyMissile(payload)
	local isNuke = payload.kind == "nuke"
	local isMeteor = payload.kind == "meteor"
	local from = payload.from
	local to = payload.to
	local flight = payload.flight

	local model, body, nose = buildRocketModel(isNuke)
	model.Name = "MVC_Missile"
	model.Parent = workspace

	-- LIFT OFF: vertical rise off the pad, then arc over to the target city.
	local riseTime = isMeteor and 0 or (isNuke and 2.4 or 1.6)
	local riseHeight = isNuke and 110 or 70
	local liftTop = from + Vector3.new(0, riseHeight, 0)
	local apex = (liftTop + to) / 2 + Vector3.new(0, isNuke and 340 or 190, 0)

	if not isMeteor then
		SoundBook.playAt("Launch", from, { PlaybackSpeed = isNuke and 0.75 or 1, RollOffMaxDistance = 1500 })
		launchPadSmoke(from)
		shakeFromDistance(from, 1.2, 220, riseTime)
	end

	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - start
		local pos, ahead
		if elapsed &lt; riseTime then
			-- Accelerating vertical climb.
			local tt = elapsed / riseTime
			local eased = tt * tt
			pos = from:Lerp(liftTop, eased)
			ahead = pos + Vector3.new(0, 5, 0)
		else
			local t = math.min((elapsed - riseTime) / math.max(flight - riseTime, 0.1), 1)
			pos = quadBezier(liftTop, apex, to, t)
			ahead = quadBezier(liftTop, apex, to, math.min(t + 0.02, 1))
			if t &gt;= 1 then
				conn:Disconnect()
				model:Destroy()
				if isNuke then
					nukeFX(to)
				else
					explosionFX(to)
				end
				return
			end
		end
		local lookCF
		if (ahead - pos).Magnitude &gt; 0.01 then
			lookCF = CFrame.lookAt(pos, ahead)
		else
			lookCF = CFrame.new(pos)
		end
		body.CFrame = lookCF
		nose.CFrame = lookCF * CFrame.new(0, 0, -(body.Size.Z / 2 + nose.Size.Z / 2 - 0.4))
	end)
end

local function shieldFX(plotIndex, _pos)
	local center = Layout.plotCenter(plotIndex)
	local dome = anchoredPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(20, 20, 20),
		Position = Vector3.new(center.X, Layout.GroundY, center.Z),
		Color = Color3.fromRGB(90, 180, 255),
		Material = Enum.Material.ForceField,
		Transparency = 0.2,
	})
	SoundBook.playAt("Glass", Vector3.new(center.X, Layout.GroundY + 20, center.Z), { RollOffMaxDistance = 900 })
	TweenService:Create(dome, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = Vector3.new(300, 300, 300),
	}):Play()
	task.delay(1.6, function()
		fadeOut(dome, 0.8)
	end)
end

function FX.init()
	Remotes.Events.MissileEvent.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		if typeof(payload.from) == "Vector3" and typeof(payload.to) == "Vector3" and type(payload.flight) == "number" then
			flyMissile(payload)
		end
	end)
	Remotes.Events.ShieldFX.OnClientEvent:Connect(function(plotIndex, pos)
		if type(plotIndex) == "number" then
			shieldFX(plotIndex, pos)
		end
	end)
end

return FX
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">GameEvents</string><ProtectedString name="Source">-- World event banner (Cash Frenzy, Meteor Shower, ...) with horn fanfare
-- and a live countdown for timed events.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)
local NumberFormat = require(Shared.NumberFormat)
local UILib = require(script.Parent.UILib)

local GameEvents = {}

-- Flak burst when air defense intercepts something.
local function flakBurst(pos)
	SoundBook.playAt("Explosion", pos, { PlaybackSpeed = 1.5, Volume = 0.6, RollOffMaxDistance = 500 })
	for _ = 1, 5 do
		local puff = Instance.new("Part")
		puff.Anchored = true
		puff.CanCollide = false
		puff.CanQuery = false
		puff.Shape = Enum.PartType.Ball
		puff.Material = Enum.Material.Neon
		puff.Color = Color3.fromRGB(60, 60, 60)
		puff.Size = Vector3.new(3, 3, 3)
		puff.Position = pos + Vector3.new(math.random(-20, 20), 45 + math.random(-8, 8), math.random(-20, 20))
		puff.Parent = workspace
		task.spawn(function()
			for i = 1, 8 do
				puff.Size += Vector3.new(1.5, 1.5, 1.5)
				puff.Transparency = i / 8
				task.wait(0.04)
			end
			puff:Destroy()
		end)
	end
end

local KIND_COLORS = {
	frenzy = Color3.fromRGB(88, 200, 60),
	gems = Color3.fromRGB(190, 90, 240),
	meteor = Color3.fromRGB(235, 120, 40),
	supply = Color3.fromRGB(250, 200, 60),
	supply_claim = Color3.fromRGB(250, 200, 60),
}

local gui
local banner
local label
local hideAt = 0
local baseMsg = ""

local function show(payload)
	baseMsg = payload.msg or ""
	banner.BackgroundColor3 = KIND_COLORS[payload.kind] or UILib.Colors.Blue
	label.Text = baseMsg
	hideAt = os.clock() + math.max(payload.duration or 5, 5)

	banner.Visible = true
	banner.Position = UDim2.new(0.5, 0, 0, -70)
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 104),
	}):Play()

	SoundBook.play("Horn", UILib.playerGui(), { PlaybackSpeed = 1.6 })
	SoundBook.play("Ding", UILib.playerGui())
end

function GameEvents.init()
	gui = UILib.screen("MVC_Events", 8)
	banner = UILib.frame({
		Size = UDim2.new(0, 620, 0, 46),
		Position = UDim2.new(0.5, 0, 0, 104),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = UILib.Colors.Blue,
		Visible = false,
	}, gui)
	label = UILib.text({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.new(0, 8, 0, 4),
		Text = "",
	}, banner)

	Remotes.Events.GameEvent.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.kind == "intercept" and typeof(payload.pos) == "Vector3" then
			flakBurst(payload.pos)
			return
		end
		if type(payload.msg) == "string" then
			show(payload)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if banner.Visible then
				local left = hideAt - os.clock()
				if left &lt;= 0 then
					banner.Visible = false
				elseif left &lt; 120 then
					label.Text = baseMsg .. "  (" .. NumberFormat.clock(left) .. ")"
				end
			end
		end
	end)
end

return GameEvents
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">HUD</string><ProtectedString name="Source">-- Top-center HUD: gems, the big comma-formatted cash counter, income/s.
-- Cash smoothly counts up toward the real value for juice.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NumberFormat = require(Shared.NumberFormat)
local UILib = require(script.Parent.UILib)

local HUD = {}

local displayedCash = 0
local targetCash = 0

function HUD.init(ctx)
	local gui = UILib.screen("MVC_HUD", 5)

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, 4)
	holder.Size = UDim2.new(0, 620, 0, 120)
	holder.Parent = gui

	-- Rounded dark "pill" backdrops keep the counters readable on any scene.
	local function pill(width, height, y)
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0.5, 0)
		frame.Position = UDim2.new(0.5, 0, 0, y)
		frame.Size = UDim2.new(0, width, 0, height)
		frame.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
		frame.BackgroundTransparency = 0.35
		frame.BorderSizePixel = 0
		UILib.corner(frame, height / 2)
		frame.Parent = holder
		return frame
	end

	local gemsPill = pill(150, 26, 0)
	local gemIcon = UILib.icon("gem", gemsPill)
	gemIcon.Position = UDim2.new(0, 4, 0, 2)
	gemIcon.Size = UDim2.new(0, 22, 0, 22)
	local gemsLabel = UILib.text({
		Size = UDim2.new(1, -36, 1, -6),
		Position = UDim2.new(0, 30, 0, 3),
		Text = "0",
		TextColor3 = Color3.fromRGB(220, 130, 250),
	}, gemsPill)

	local cashPill = pill(430, 42, 30)
	local cashIcon = UILib.icon("cash", cashPill)
	cashIcon.Position = UDim2.new(0, 6, 0, 4)
	cashIcon.Size = UDim2.new(0, 34, 0, 34)
	local cashLabel = UILib.text({
		Size = UDim2.new(1, -56, 1, -8),
		Position = UDim2.new(0, 46, 0, 4),
		Text = "0",
		TextColor3 = Color3.fromRGB(140, 245, 120),
	}, cashPill)

	local incomePill = pill(170, 24, 76)
	local incomeLabel = UILib.text({
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.new(0, 8, 0, 3),
		Text = "",
		TextColor3 = Color3.fromRGB(200, 235, 190),
	}, incomePill)

	local rebirthLabel = UILib.text({
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 0, 102),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 230, 120),
	}, holder)

	ctx.State.changed.Event:Connect(function(data)
		targetCash = data.cash
		gemsLabel.Text = NumberFormat.commas(data.gems)
		incomeLabel.Text = "+" .. NumberFormat.abbrev(data.income) .. "/s"
		if (data.rebirths or 0) &gt; 0 then
			rebirthLabel.Text = "\u{1F31F} Rebirth " .. data.rebirths .. " (x" .. (1 + data.rebirths) .. " income)"
		else
			rebirthLabel.Text = ""
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if displayedCash ~= targetCash then
			local diff = targetCash - displayedCash
			if math.abs(diff) &lt; math.max(1, math.abs(targetCash) * 1e-9) then
				displayedCash = targetCash
			else
				displayedCash += diff * math.min(dt * 6, 1)
			end
			cashLabel.Text = NumberFormat.commas(displayedCash)
		end
	end)
end

return HUD
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX45"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Missiles vs Cities: client bootstrap.

local ClientState = require(script.Parent.ClientState)
local Notifier = require(script.Parent.Notifier)
local HUD = require(script.Parent.HUD)
local SidePanel = require(script.Parent.SidePanel)
local RocketPanel = require(script.Parent.RocketPanel)
local AttackView = require(script.Parent.AttackView)
local DailyRewardsUI = require(script.Parent.DailyRewardsUI)
local AlarmUI = require(script.Parent.AlarmUI)
local FX = require(script.Parent.FX)
local CashPopups = require(script.Parent.CashPopups)
local MusicPlayer = require(script.Parent.MusicPlayer)
local Dialogue = require(script.Parent.Dialogue)
local QuestUI = require(script.Parent.QuestUI)
local CharacterShop = require(script.Parent.CharacterShop)
local GameEvents = require(script.Parent.GameEvents)
local RebirthUI = require(script.Parent.RebirthUI)
local MissileCam = require(script.Parent.MissileCam)
local PlaneFX = require(script.Parent.PlaneFX)
local PilotPrompt = require(script.Parent.PilotPrompt)
local AdminPanel = require(script.Parent.AdminPanel)
local MilitaryPanel = require(script.Parent.MilitaryPanel)

local UIKit = require(script.Parent.UIKit)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundBook = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SoundBook"))
SoundBook.preload() -- warm the Store SFX so first plays are instant

-- Harvest Store UI-kit art BEFORE building the GUI (wait up to 6s), so icons
-- render with real designed images. Falls back to drawn icons if it times out.
do
	local done = false
	task.spawn(function()
		UIKit.load()
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 &lt; 6 do
		task.wait(0.1)
	end
end

local ctx = {
	State = ClientState,
	Notifier = Notifier,
	AttackView = AttackView,
	DailyUI = DailyRewardsUI,
	QuestUI = QuestUI,
	CharShop = CharacterShop,
	Military = MilitaryPanel,
	ShopToggle = SidePanel.toggleShop,
}

Notifier.init()
HUD.init(ctx)
AttackView.init(ctx)
DailyRewardsUI.init(ctx)
QuestUI.init(ctx)
CharacterShop.init(ctx)
MilitaryPanel.init(ctx)
AdminPanel.init(ctx)
SidePanel.init(ctx)
RocketPanel.init(ctx)
Dialogue.init(ctx)
RebirthUI.init(ctx)
AlarmUI.init()
FX.init()
CashPopups.init()
GameEvents.init()
MissileCam.init()
PlaneFX.init()
PilotPrompt.init()
MusicPlayer.init()

ClientState.start()
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">MilitaryPanel</string><ProtectedString name="Source">-- War &amp; Economy panel: Auto-Collect, Air Defense, Airport hangars + jets,
-- and the Missile Battery. Purchases route through existing remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local MilitaryPanel = {}

local ctx
local gui
local rows = {}

local function makeRow(content, order, id, color, onClick)
	local button = UILib.button({
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.new(0, 8, 0, 8 + (order - 1) * 58),
		Text = "",
		BackgroundColor3 = color or UILib.Colors.Green,
	}, content, onClick)
	rows[id] = button
	return button
end

local function refresh()
	local s = ctx.State.get()
	if not s then
		return
	end
	rows.auto.Text = s.autoCollect and "\u{1F4B0} Auto-Collect: OWNED"
		or ("\u{1F4B0} Auto-Collect \u{2014} \u{1F4B5} " .. NumberFormat.abbrev(s.autoCollectCost))
	rows.defense.Text = (s.defenseLevel or 0) &gt;= Config.Defense.MaxLevel
		and ("\u{1F6E1}\u{FE0F} Air Defense MAX (Lv" .. s.defenseLevel .. ")")
		or ("\u{1F6E1}\u{FE0F} Air Defense Lv" .. (s.defenseLevel or 0) .. " \u{2192} " .. ((s.defenseLevel or 0) + 1)
			.. " \u{2014} \u{1F4B5} " .. NumberFormat.abbrev(s.defenseCost))

	if s.hasAirport then
		rows.hangar.Visible = true
		rows.jet.Visible = true
		rows.hangar.Text = (s.nextHangarCost or 0) &gt; 0
			and ("\u{2708}\u{FE0F} Buy Hangar " .. ((s.hangars or 0) + 1) .. " \u{2014} \u{1F4B5} " .. NumberFormat.abbrev(s.nextHangarCost))
			or ("\u{2708}\u{FE0F} Hangars MAX (" .. (s.hangars or 0) .. ")")
		rows.jet.Text = (s.jetCost or 0) &gt; 0
			and ("\u{2708}\u{FE0F} Upgrade Jets Lv" .. (s.jetLevel or 1) .. " \u{2014} \u{1F4B5} " .. NumberFormat.abbrev(s.jetCost))
			or "\u{2708}\u{FE0F} Jets MAX LEVEL"
	else
		rows.hangar.Visible = false
		rows.jet.Visible = false
	end

	if s.batteryUnlocked then
		rows.battery.Text = "\u{1F680} Battery OWNED (side island)"
		rows.batteryUp.Visible = true
		rows.batteryUp.Text = (s.batteryUpgradeCost or 0) &gt; 0
			and ("\u{1F680} Upgrade Battery Lv" .. (s.batteryLevel or 1) .. " \u{2014} \u{1F4B5} " .. NumberFormat.abbrev(s.batteryUpgradeCost))
			or "\u{1F680} Battery MAX LEVEL"
	else
		rows.battery.Text = "\u{1F680} Buy Missile Battery \u{2014} \u{1F4B5} " .. NumberFormat.abbrev(s.batteryCost)
		rows.batteryUp.Visible = false
	end
end

function MilitaryPanel.toggle()
	gui.Enabled = not gui.Enabled
	if gui.Enabled then
		refresh()
	end
end

function MilitaryPanel.init(context)
	ctx = context
	local pg, content = UILib.panel("MVC_Military", "\u{2699}\u{FE0F} WAR &amp; ECONOMY", UDim2.new(0, 440, 0, 400), 13)
	gui = pg

	makeRow(content, 1, "auto", UILib.Colors.Green, function()
		Remotes.Events.ShopBuy:FireServer("auto_collect")
	end)
	makeRow(content, 2, "defense", UILib.Colors.Blue, function()
		Remotes.Events.ShopBuy:FireServer("buy_defense")
	end)
	makeRow(content, 3, "hangar", UILib.Colors.LightBlue, function()
		Remotes.Events.ShopBuy:FireServer("buy_hangar")
	end)
	makeRow(content, 4, "jet", UILib.Colors.LightBlue, function()
		Remotes.Events.ShopBuy:FireServer("upgrade_jet")
	end)
	makeRow(content, 5, "battery", UILib.Colors.Purple, function()
		Remotes.Events.ShopBuy:FireServer("buy_battery")
	end)
	makeRow(content, 6, "batteryUp", UILib.Colors.Purple, function()
		Remotes.Events.UpgradeBattery:FireServer()
	end)

	ctx.State.changed.Event:Connect(function()
		if gui.Enabled then
			refresh()
		end
	end)
end

return MilitaryPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">MissileCam</string><ProtectedString name="Source">-- Preview camera: when YOU launch a missile/nuke, the camera rides behind it
-- and watches it strike. A SKIP button returns to normal instantly.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)
local UILib = require(script.Parent.UILib)

local MissileCam = {}

local player = Players.LocalPlayer
local active = false
local gui
local skipButton

local function camera()
	return workspace.CurrentCamera
end

local function quadBezier(p0, p1, p2, t)
	local a = p0:Lerp(p1, t)
	local b = p1:Lerp(p2, t)
	return a:Lerp(b, t)
end

local function stop()
	if not active then
		return
	end
	active = false
	gui.Enabled = false
	local cam = camera()
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
end

local function ride(payload)
	if active then
		return -- one preview at a time
	end
	active = true
	gui.Enabled = true

	local isNuke = payload.kind == "nuke"
	local from = payload.from
	local to = payload.to
	local flight = payload.flight or 8
	local riseTime = isNuke and 2.4 or 1.6
	local riseHeight = isNuke and 110 or 70
	local liftTop = from + Vector3.new(0, riseHeight, 0)
	local apex = (liftTop + to) / 2 + Vector3.new(0, isNuke and 340 or 190, 0)

	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable

	SoundBook.play("Launch", UILib.playerGui(), { PlaybackSpeed = isNuke and 0.75 or 1 })

	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not active then
			conn:Disconnect()
			return
		end
		local elapsed = os.clock() - start
		local pos, ahead
		if elapsed &lt; riseTime then
			local tt = elapsed / riseTime
			pos = from:Lerp(liftTop, tt * tt)
			ahead = pos + Vector3.new(0, 8, 0)
		else
			local t = math.min((elapsed - riseTime) / math.max(flight - riseTime, 0.1), 1)
			pos = quadBezier(liftTop, apex, to, t)
			ahead = quadBezier(liftTop, apex, to, math.min(t + 0.03, 1))
			if t &gt;= 1 then
				-- Hold on the impact for a beat, then return.
				cam.CFrame = CFrame.lookAt(to + Vector3.new(30, 40, 30), to)
				task.delay(isNuke and 2.5 or 1.2, stop)
				conn:Disconnect()
				return
			end
		end
		-- Chase camera just behind and above the warhead.
		local dir = (ahead - pos)
		if dir.Magnitude &lt; 0.01 then
			dir = Vector3.new(0, 1, 0)
		end
		local behind = pos - dir.Unit * 22 + Vector3.new(0, 8, 0)
		cam.CFrame = CFrame.lookAt(behind, pos + dir.Unit * 10)
	end)
end

function MissileCam.init()
	gui = UILib.screen("MVC_MissileCam", 40)
	gui.Enabled = false

	local hint = UILib.text({
		Size = UDim2.new(0, 320, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 20),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "\u{1F4F9} MISSILE CAM",
		TextColor3 = Color3.fromRGB(255, 90, 90),
	}, gui)

	skipButton = UILib.button({
		Size = UDim2.new(0, 150, 0, 50),
		Position = UDim2.new(1, -24, 1, -90),
		AnchorPoint = Vector2.new(1, 1),
		Text = "SKIP \u{23ED}\u{FE0F}",
		BackgroundColor3 = UILib.Colors.DarkGray,
	}, gui, stop)

	Remotes.Events.MissileEvent.OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and payload.previewFor == player.UserId
			and typeof(payload.from) == "Vector3" and typeof(payload.to) == "Vector3" then
			ride(payload)
		end
	end)
end

return MissileCam
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">MusicPlayer</string><ProtectedString name="Source">-- Chill background music: finds the first track id that actually loads,
-- then loops it forever. Mute toggle bottom-right.

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundBook = require(Shared.SoundBook)
local UILib = require(script.Parent.UILib)

local MusicPlayer = {}

local muted = false
local current = nil
local VOLUME = 0.16

local function startMusic()
	for _, id in ipairs(SoundBook.Music) do
		local sound = Instance.new("Sound")
		sound.Name = "MVC_Music"
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = muted and 0 or VOLUME
		sound.Looped = true
		sound.Parent = SoundService

		local waited = 0
		while not sound.IsLoaded and waited &lt; 6 do
			task.wait(0.5)
			waited += 0.5
		end
		if sound.IsLoaded then
			current = sound
			sound:Play()
			return -- loop this one forever
		end
		sound:Destroy() -- broken/moderated id, try the next
	end
end

function MusicPlayer.init()
	local gui = UILib.screen("MVC_Music", 4)
	local toggle = UILib.button({
		Size = UDim2.new(0, 44, 0, 44),
		Position = UDim2.new(1, -56, 1, -110),
		Text = "\u{1F50A}",
		BackgroundColor3 = UILib.Colors.DarkGray,
	}, gui, nil)
	toggle.Activated:Connect(function()
		muted = not muted
		toggle.Text = muted and "\u{1F507}" or "\u{1F50A}"
		if current then
			current.Volume = muted and 0 or VOLUME
		end
	end)

	task.spawn(startMusic)
end

return MusicPlayer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">Notifier</string><ProtectedString name="Source">-- Toast notifications: redesigned as rounded cards with a colored side stripe,
-- an emoji badge, drop-in bounce and auto-dismiss. Stacks bottom-left so it
-- never collides with the right-side buttons or the top HUD.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)
local UILib = require(script.Parent.UILib)

local Notifier = {}

local KIND_STYLE = {
	good = { color = Color3.fromRGB(80, 200, 90), sound = "Good", badge = "\u{2705}" },
	bad = { color = Color3.fromRGB(235, 70, 70), sound = "Bad", badge = "\u{26A0}\u{FE0F}" },
	buy = { color = Color3.fromRGB(90, 200, 120), sound = "Buy", badge = "\u{1F6D2}" },
	victory = { color = Color3.fromRGB(250, 200, 60), sound = "Victory", badge = "\u{1F389}" },
	info = { color = Color3.fromRGB(80, 160, 240), sound = "Click", badge = "\u{2139}\u{FE0F}" },
}

local gui
local holder

function Notifier.show(msg, kind)
	local style = KIND_STYLE[kind] or KIND_STYLE.info

	local toast = Instance.new("Frame")
	toast.Size = UDim2.new(1, 0, 0, 56)
	toast.BackgroundColor3 = Color3.fromRGB(28, 30, 40)
	toast.BackgroundTransparency = 0.08
	toast.BorderSizePixel = 0
	UILib.corner(toast, 8)
	UILib.stroke(toast, 2, Color3.new(0, 0, 0))
	toast.Parent = holder

	-- Colored side stripe.
	local stripe = Instance.new("Frame")
	stripe.Size = UDim2.new(0, 7, 1, -10)
	stripe.Position = UDim2.new(0, 5, 0, 5)
	stripe.BackgroundColor3 = style.color
	stripe.BorderSizePixel = 0
	UILib.corner(stripe, 3)
	stripe.Parent = toast

	-- Emoji badge.
	local badge = Instance.new("TextLabel")
	badge.Size = UDim2.new(0, 34, 0, 34)
	badge.Position = UDim2.new(0, 16, 0.5, -17)
	badge.BackgroundTransparency = 1
	badge.Font = UILib.Font
	badge.TextScaled = true
	badge.Text = style.badge
	badge.Parent = toast

	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(1, -64, 1, -10)
	text.Position = UDim2.new(0, 56, 0, 5)
	text.BackgroundTransparency = 1
	text.Font = UILib.Font
	text.TextScaled = true
	text.TextWrapped = true
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeColor3 = Color3.new(0, 0, 0)
	text.TextStrokeTransparency = 0.4
	text.Text = msg
	text.Parent = toast

	SoundBook.play(style.sound, UILib.playerGui())

	toast.Position = UDim2.new(-1, -40, 0, 0)
	TweenService:Create(toast, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0),
	}):Play()

	task.delay(4.5, function()
		local out = TweenService:Create(toast, TweenInfo.new(0.3), {
			Position = UDim2.new(-1, -60, 0, 0),
			BackgroundTransparency = 1,
		})
		out:Play()
		out.Completed:Once(function()
			toast:Destroy()
		end)
	end)
end

function Notifier.init()
	gui = UILib.screen("MVC_Toasts", 50)
	holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0, 1)
	holder.Position = UDim2.new(0, 108, 1, -20)
	holder.Size = UDim2.new(0, 340, 0, 400)
	holder.Parent = gui
	UILib.autoScale(holder)

	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 8)
	list.HorizontalAlignment = Enum.HorizontalAlignment.Left
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = holder

	Remotes.Events.Notify.OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and type(payload.msg) == "string" then
			Notifier.show(payload.msg, payload.kind)
		end
	end)
end

return Notifier
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">PilotPrompt</string><ProtectedString name="Source">-- The old pilot's radio call: ACCEPT (payout, he lands) or DECLINE (he flies
-- on, runs out of fuel and may crash into your city). Auto-declines on timeout.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local NumberFormat = require(Shared.NumberFormat)
local SoundBook = require(Shared.SoundBook)
local UILib = require(script.Parent.UILib)

local PilotPrompt = {}

local gui
local timerLabel
local deadline = 0
local open = false

local function answer(accepted)
	if not open then
		return
	end
	open = false
	gui.Enabled = false
	Remotes.Events.PilotAnswer:FireServer(accepted)
end

function PilotPrompt.init()
	local panelGui, content = UILib.panel("MVC_Pilot", "\u{1F4FB} INCOMING RADIO", UDim2.new(0, 460, 0, 260), 30)
	gui = panelGui

	UILib.text({
		Size = UDim2.new(1, -20, 0, 96),
		Position = UDim2.new(0, 10, 0, 6),
		Text = "\u{1F468}\u{200D}\u{2708}\u{FE0F} \"Mayday... this here's an old cropduster, low on fuel."
			.. " Requestin' permission to land at your airport, over.\"",
		TextWrapped = true,
		TextSize = 20,
		TextScaled = false,
	}, content)

	timerLabel = UILib.text({
		Size = UDim2.new(1, -20, 0, 24),
		Position = UDim2.new(0, 10, 0, 104),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 220, 120),
	}, content)

	UILib.button({
		Size = UDim2.new(0.5, -16, 0, 60),
		Position = UDim2.new(0, 10, 1, -70),
		Text = "\u{2705} ACCEPT",
		BackgroundColor3 = UILib.Colors.Green,
	}, content, function()
		answer(true)
	end)

	UILib.button({
		Size = UDim2.new(0.5, -16, 0, 60),
		Position = UDim2.new(0.5, 6, 1, -70),
		Text = "\u{274C} DECLINE",
		BackgroundColor3 = UILib.Colors.Red,
	}, content, function()
		answer(false)
	end)

	Remotes.Events.PilotOffer.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		open = true
		deadline = os.clock() + (payload.seconds or 25)
		gui.Enabled = true
		SoundBook.play("Ding", UILib.playerGui())
	end)

	task.spawn(function()
		while true do
			task.wait(0.3)
			if open then
				local left = deadline - os.clock()
				if left &lt;= 0 then
					answer(false)
				else
					timerLabel.Text = "Reward if you accept: \u{1F4B5} big payout   \u{2022}   Auto-decline in "
						.. NumberFormat.clock(left)
				end
			end
		end
	end)
end

return PilotPrompt
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">PlaneFX</string><ProtectedString name="Source">-- Flight FX for the pilot's cropduster (PlaneEvent) and jet strikes (JetEvent).
-- The pilot uses ONE continuous plane per island that transitions between
-- phases (approach -&gt; circle/hold -&gt; land or takeoff or crash), so there is
-- never a second plane and the landing is a smooth lined-up approach.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local SoundBook = require(Shared.SoundBook)

local PlaneFX = {}

local activePlanes = {} -- [plotIndex] = record

local function anchoredPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or workspace
	return p
end

local function buildPlane(cropduster)
	local model = Instance.new("Model")
	model.Name = "MVC_Plane"
	local bodyColor = cropduster and Color3.fromRGB(220, 170, 60) or Color3.fromRGB(90, 100, 120)
	local body = anchoredPart({
		Name = "Body",
		Size = Vector3.new(2.4, 2, cropduster and 9 or 11),
		Color = bodyColor,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	anchoredPart({ Name = "Wing", Size = Vector3.new(cropduster and 15 or 12, 0.5, 3), Color = bodyColor, Parent = model })
	anchoredPart({ Name = "TailWing", Size = Vector3.new(5, 0.4, 1.6), Color = bodyColor, Parent = model })
	anchoredPart({ Name = "Tail", Size = Vector3.new(0.5, 2.2, 1.6), Color = bodyColor, Parent = model })
	if cropduster then
		anchoredPart({ Name = "Cockpit", Size = Vector3.new(1.6, 1.2, 2), Color = Color3.fromRGB(120, 180, 220), Material = Enum.Material.Glass, Parent = model })
	end
	local prop = anchoredPart({
		Name = "Prop",
		Size = Vector3.new(cropduster and 5.5 or 3, 0.4, 0.4),
		Color = Color3.fromRGB(40, 40, 40),
		Parent = model,
	})
	model.PrimaryPart = body
	return model, body, prop
end

-- Poses the plane at pos facing 'facing' (a look direction), spinning the prop.
local function poseAt(body, prop, pos, facing, bank)
	local look = facing.Magnitude &gt; 0.01 and CFrame.lookAt(pos, pos + facing) or CFrame.new(pos)
	if bank then
		look = look * CFrame.Angles(0, 0, bank)
	end
	body.CFrame = look
	prop.CFrame = body.CFrame * CFrame.new(0, 0, -(body.Size.Z / 2 + 0.3)) * CFrame.Angles(0, 0, os.clock() * 45)
end

-- Cancels a record's current motion loop (by bumping its token).
local function cancelMotion(rec)
	rec.token = (rec.token or 0) + 1
end

local function destroyPlane(plotIndex)
	local rec = activePlanes[plotIndex]
	if rec then
		cancelMotion(rec)
		if rec.engine then
			rec.engine:Stop()
		end
		if rec.model then
			rec.model:Destroy()
		end
		activePlanes[plotIndex] = nil
	end
end

local function explosion(pos)
	SoundBook.playAt("Explosion", pos, { PlaybackSpeed = 0.7, RollOffMaxDistance = 600 })
	local boom = Instance.new("Explosion")
	boom.Position = pos
	boom.BlastPressure = 0
	boom.BlastRadius = 0
	boom.DestroyJointRadiusPercent = 0
	boom.Parent = workspace
	local flash = anchoredPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(8, 8, 8),
		Position = pos + Vector3.new(0, 4, 0),
		Color = Color3.fromRGB(255, 180, 60),
		Material = Enum.Material.Neon,
	})
	task.spawn(function()
		for i = 1, 12 do
			flash.Size += Vector3.new(4, 4, 4)
			flash.Transparency = i / 12
			task.wait(0.03)
		end
		flash:Destroy()
	end)
end

-- Flies the plane from its current position to 'to' over 'flight' seconds,
-- along a smooth arc, then runs onDone. Cancellable via token.
local function flyTo(rec, to, flight, arcHeight, onDone)
	cancelMotion(rec)
	local token = rec.token
	task.spawn(function()
		local body, prop = rec.body, rec.prop
		local from = body.Position
		local mid = (from + to) / 2 + Vector3.new(0, arcHeight or 0, 0)
		local t0 = os.clock()
		while rec.token == token do
			local a = math.min((os.clock() - t0) / flight, 1)
			-- Quadratic bezier for a smooth curved path.
			local p1 = from:Lerp(mid, a)
			local p2 = mid:Lerp(to, a)
			local pos = p1:Lerp(p2, a)
			local ahead1 = from:Lerp(mid, math.min(a + 0.03, 1))
			local ahead2 = mid:Lerp(to, math.min(a + 0.03, 1))
			local ahead = ahead1:Lerp(ahead2, math.min(a + 0.03, 1))
			poseAt(body, prop, pos, (ahead - pos), math.sin(a * math.pi) * 0.15)
			if a &gt;= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		if rec.token == token and onDone then
			onDone()
		end
	end)
end

-- Circles the plane around a center point until interrupted (hold pattern).
local function orbit(rec, center, radius, height)
	cancelMotion(rec)
	local token = rec.token
	task.spawn(function()
		local body, prop = rec.body, rec.prop
		local angle = 0
		while rec.token == token do
			angle += 0.012
			local pos = center + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
			local ahead = center + Vector3.new(math.cos(angle + 0.1) * radius, height, math.sin(angle + 0.1) * radius)
			poseAt(body, prop, pos, (ahead - pos), 0.35) -- banked turn
			RunService.RenderStepped:Wait()
		end
	end)
end

local function ensurePlane(plotIndex, startPos)
	local rec = activePlanes[plotIndex]
	if rec and rec.model.Parent then
		return rec
	end
	local model, body, prop = buildPlane(true)
	model.Parent = workspace
	body.CFrame = CFrame.new(startPos or Vector3.new(0, 100, 0))
	local engine = SoundBook.make("BigRumble", { Looped = true, PlaybackSpeed = 0.7, Volume = 0.5 })
	if engine then
		engine.Parent = body
		engine:Play()
	end
	rec = { model = model, body = body, prop = prop, engine = engine, token = 0 }
	activePlanes[plotIndex] = rec
	return rec
end

local function handlePlane(payload)
	local plotIndex = payload.plotIndex or 0
	local phase = payload.phase

	if phase == "approach" then
		destroyPlane(plotIndex) -- clear any stale plane first (no doubles)
		local rec = ensurePlane(plotIndex, payload.from)
		-- Fly in, then hold in a circle above the airport until we're told
		-- whether to land, take off, or crash.
		flyTo(rec, payload.to, payload.flight or 8, 20, function()
			orbit(rec, payload.to, 60, 0)
		end)
	elseif phase == "land" then
		local rec = ensurePlane(plotIndex, payload.from)
		-- Line up and descend smoothly onto the runway, then taxi to a stop.
		local lineup = payload.to + Vector3.new(0, 40, 90)
		flyTo(rec, lineup, 2.5, 10, function()
			flyTo(rec, payload.to, (payload.flight or 6), -6, function()
				-- Sit on the runway; despawn later (server sends takeoff).
			end)
		end)
	elseif phase == "takeoff" then
		local rec = activePlanes[plotIndex]
		if not rec or not rec.model.Parent then
			return
		end
		flyTo(rec, payload.to, payload.flight or 9, 60, function()
			destroyPlane(plotIndex)
		end)
	elseif phase == "crash" then
		local rec = ensurePlane(plotIndex, payload.from)
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Rate = 30
		smoke.Lifetime = NumberRange.new(0.8, 1.4)
		smoke.Color = ColorSequence.new(Color3.fromRGB(60, 60, 60))
		smoke.Parent = rec.body
		flyTo(rec, payload.to, payload.flight or 7, 10, function()
			explosion(payload.to)
			destroyPlane(plotIndex)
		end)
	end
end

local function handleJet(payload)
	local model, body, prop = buildPlane(false)
	model.Parent = workspace
	body.CFrame = CFrame.new(payload.from)
	SoundBook.playAt("Launch", payload.from, { PlaybackSpeed = 1.2, RollOffMaxDistance = 1200 })
	local from = payload.from
	local to = payload.to
	local flight = payload.flight or 8
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.min((os.clock() - t0) / flight, 1)
		local mid = (from + to) / 2 + Vector3.new(0, 40, 0)
		local pos = from:Lerp(mid, a):Lerp(mid:Lerp(to, a), a)
		local ahead = from:Lerp(mid, math.min(a + 0.03, 1)):Lerp(mid:Lerp(to, math.min(a + 0.03, 1)), math.min(a + 0.03, 1))
		poseAt(body, prop, pos, (ahead - pos))
		if a &gt;= 1 then
			conn:Disconnect()
			explosion(to)
			model:Destroy()
		end
	end)
end

function PlaneFX.init()
	Remotes.Events.PlaneEvent.OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and typeof(payload.to) == "Vector3" then
			handlePlane(payload)
		end
	end)
	Remotes.Events.JetEvent.OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and typeof(payload.from) == "Vector3" then
			handleJet(payload)
		end
	end)
end

return PlaneFX
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">QuestUI</string><ProtectedString name="Source">-- Quest tracker panel: one card per quest chain with progress bars.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NumberFormat = require(Shared.NumberFormat)
local UILib = require(script.Parent.UILib)

local QuestUI = {}

local ctx
local gui
local cards = {}

local function makeCard(parent, order)
	local card = UILib.frame({
		Size = UDim2.new(1, -8, 0, 118),
		Position = UDim2.new(0, 4, 0, 8 + (order - 1) * 128),
		BackgroundColor3 = UILib.Colors.LightBlue,
	}, parent)

	local title = UILib.text({
		Size = UDim2.new(1, -16, 0, 26),
		Position = UDim2.new(0, 8, 0, 4),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local questName = UILib.text({
		Size = UDim2.new(1, -16, 0, 24),
		Position = UDim2.new(0, 8, 0, 32),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 235, 160),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local desc = UILib.text({
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.new(0, 8, 0, 58),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local barBack = UILib.frame({
		Size = UDim2.new(1, -16, 0, 22),
		Position = UDim2.new(0, 8, 0, 86),
		BackgroundColor3 = UILib.Colors.DarkGray,
	}, card)
	local barFill = UILib.frame({
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = UILib.Colors.Green,
	}, barBack)
	local barText = UILib.text({
		Size = UDim2.fromScale(1, 1),
		Text = "",
	}, barBack)

	return { card = card, title = title, questName = questName, desc = desc, barFill = barFill, barText = barText }
end

local function refresh(quests)
	if not quests then
		return
	end
	local order = 1
	for _, chainId in ipairs({ "mayor", "general" }) do
		local data = quests[chainId]
		local card = cards[order]
		if data and card then
			card.title.Text = data.title or ""
			if data.done then
				card.questName.Text = "\u{2705} All quests complete!"
				card.desc.Text = "You finished this whole quest line. Legend!"
				card.barFill.Size = UDim2.fromScale(1, 1)
				card.barText.Text = "DONE"
			else
				card.questName.Text = "\u{1F4DC} Quest " .. data.number .. "/" .. data.total .. ": " .. data.name
					.. (data.repeatable and " (\u{221E} repeatable)" or "")
				card.desc.Text = data.desc
				local frac = math.clamp(data.progress / math.max(data.goal, 1), 0, 1)
				card.barFill.Size = UDim2.fromScale(frac, 1)
				card.barText.Text = NumberFormat.abbrev(data.progress) .. " / " .. NumberFormat.abbrev(data.goal)
			end
		end
		order += 1
	end
end

function QuestUI.toggle()
	gui.Enabled = not gui.Enabled
	if gui.Enabled then
		local state = ctx.State.get()
		if state then
			refresh(state.quests)
		end
	end
end

function QuestUI.init(context)
	ctx = context
	local panelGui, content = UILib.panel("MVC_Quests", "\u{1F4DC} Quests", UDim2.new(0, 460, 0, 300), 12)
	gui = panelGui

	cards[1] = makeCard(content, 1)
	cards[2] = makeCard(content, 2)

	ctx.State.changed.Event:Connect(function(state)
		if gui.Enabled and state.quests then
			refresh(state.quests)
		end
	end)
end

return QuestUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">RebirthUI</string><ProtectedString name="Source">-- Rebirth confirmation panel, opened from the golden shrine in the lobby.

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local RebirthUI = {}

local ctx
local gui
local infoLabel
local confirmButton

local function refresh()
	local state = ctx.State.get()
	if not state then
		return
	end
	local nextMult = 1 + (state.rebirths + 1) * Config.Rebirth.IncomePerRebirth
	infoLabel.Text = "\u{1F31F} Rebirths so far: " .. state.rebirths
		.. "\n\nRebirthing RESETS your buildings and cash,\nbut your income becomes x" .. nextMult
		.. " FOREVER!\n(You keep gems, rocket level and nuke access.)"
	local afford = state.cash &gt;= state.rebirthCost
	confirmButton.Text = "REBIRTH — \u{1F4B5} " .. NumberFormat.abbrev(state.rebirthCost)
	confirmButton.BackgroundColor3 = afford and UILib.Colors.Gold or UILib.Colors.Gray
end

function RebirthUI.init(context)
	ctx = context
	local panelGui, content = UILib.panel("MVC_Rebirth", "\u{1F31F} Rebirth Shrine", UDim2.new(0, 420, 0, 300), 14)
	gui = panelGui

	infoLabel = UILib.text({
		Size = UDim2.new(1, -20, 0, 160),
		Position = UDim2.new(0, 10, 0, 8),
		Text = "",
		TextWrapped = true,
	}, content)

	confirmButton = UILib.button({
		Size = UDim2.new(1, -20, 0, 56),
		Position = UDim2.new(0, 10, 1, -70),
		Text = "REBIRTH",
		BackgroundColor3 = UILib.Colors.Gold,
	}, content, function()
		Remotes.Events.RequestRebirth:FireServer()
		gui.Enabled = false
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == "RebirthPrompt" then
			refresh()
			gui.Enabled = true
		end
	end)

	ctx.State.changed.Event:Connect(function()
		if gui.Enabled then
			refresh()
		end
	end)
end

return RebirthUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">RocketPanel</string><ProtectedString name="Source">-- "Rocket N · Lv X" panel (opened at your silo): Launch + Upgrade buttons.
-- Also routes the Nuke Island silo prompt into nuke attack mode.

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local RocketPanel = {}

local ctx
local gui
local titleLabel
local statsLabel
local upgradeButton
local launchButton
local siloButton

local function refresh()
	local state = ctx.State.get()
	if not state then
		return
	end
	titleLabel.Text = "\u{1F680} Rocket \u{00B7} Lv " .. state.rocketLevel
		.. "  (" .. (state.siloCount or 1) .. " silo" .. ((state.siloCount or 1) &gt; 1 and "s" or "") .. ")"
	statsLabel.Text = "\u{1F4A5} Damage: " .. NumberFormat.abbrev(state.rocketDamage)
		.. "   \u{1F4CD} Blast: " .. Config.Rocket.BlastRadius .. " studs"

	local remaining = ctx.State.remaining("rocketRemaining")
	if remaining &gt; 0 then
		launchButton.Text = "\u{23F3} " .. NumberFormat.clock(remaining)
	else
		launchButton.Text = "LAUNCH x" .. (state.siloCount or 1)
	end

	if state.rocketLevel &gt;= Config.Rocket.MaxLevel then
		upgradeButton.Text = "MAX LEVEL"
	else
		upgradeButton.Text = "Upgrade  \u{1F4B5} " .. NumberFormat.abbrev(state.rocketCost)
	end

	if (state.nextSiloCost or 0) &gt; 0 then
		siloButton.Visible = true
		siloButton.Text = "Build Silo " .. ((state.siloCount or 1) + 1)
			.. "  \u{1F4B5} " .. NumberFormat.abbrev(state.nextSiloCost)
	else
		siloButton.Visible = false
	end
end

function RocketPanel.init(context)
	ctx = context

	local panelGui, content = UILib.panel("MVC_RocketPanel", "\u{1F680} Rocket Silo", UDim2.new(0, 340, 0, 310), 15)
	gui = panelGui

	titleLabel = UILib.text({
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.new(0, 0, 0, 8),
		Text = "",
	}, content)

	statsLabel = UILib.text({
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 0, 44),
		Text = "",
		TextColor3 = Color3.fromRGB(200, 210, 230),
	}, content)

	launchButton = UILib.button({
		Size = UDim2.new(1, -20, 0, 56),
		Position = UDim2.new(0, 10, 0, 76),
		Text = "Launch",
		BackgroundColor3 = UILib.Colors.Green,
	}, content, function()
		if ctx.State.remaining("rocketRemaining") &gt; 0 then
			ctx.Notifier.show("\u{1F680} Rocket is reloading!", "bad")
			return
		end
		gui.Enabled = false
		ctx.AttackView.open("rocket")
	end)

	upgradeButton = UILib.button({
		Size = UDim2.new(1, -20, 0, 52),
		Position = UDim2.new(0, 10, 0, 142),
		Text = "Upgrade",
		BackgroundColor3 = UILib.Colors.Green,
	}, content, function()
		Remotes.Events.UpgradeRocket:FireServer()
	end)

	siloButton = UILib.button({
		Size = UDim2.new(1, -20, 0, 52),
		Position = UDim2.new(0, 10, 0, 202),
		Text = "Build Silo",
		BackgroundColor3 = UILib.Colors.Purple,
	}, content, function()
		Remotes.Events.ShopBuy:FireServer("buy_silo")
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == "RocketPrompt" then
			refresh()
			gui.Enabled = true
		elseif prompt.Name == "NukePrompt" then
			local state = ctx.State.get()
			if state and (state.nukeOwned or (state.nukeCharges or 0) &gt; 0) then
				ctx.AttackView.open("nuke")
			else
				ctx.Notifier.show("\u{2622}\u{FE0F} You need Nuke Access! Step on the purple pad next to your silo ("
					.. "\u{1F4B5} " .. NumberFormat.abbrev(Config.Nuke.IslandCost) .. ") or claim the Day 7 daily reward.", "bad")
			end
		end
	end)

	ctx.State.changed.Event:Connect(function()
		if gui.Enabled then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if gui.Enabled then
				refresh()
			end
		end
	end)
end

return RocketPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">SidePanel</string><ProtectedString name="Source">-- Left-side button column (Gift / Rewards / Shop / Attack + 2X passes),
-- and the gem shop panel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local Remotes = require(Shared.Remotes)
local UILib = require(script.Parent.UILib)

local SidePanel = {}

local ctx
local giftButton
local shopGui

-- Exposed so NPC dialogue ("Open Shop") can toggle the same panel.
function SidePanel.toggleShop()
	shopGui.Enabled = not shopGui.Enabled
end

-- Redesigned gem shop: a 2-column grid of item CARDS, each with a big emoji,
-- a name, a price chip and a coloured BUY button — like the reference game.
local function makeShop()
	local panelGui, content = UILib.panel("MVC_Shop", "\u{1F6D2} SHOP", UDim2.new(0, 480, 0, 470), 12)
	shopGui = panelGui

	local items = {
		{ id = "shield", emoji = "\u{1F6E1}\u{FE0F}", name = "Shield", desc = "Blocks 1 missile", price = Config.Shop.ShieldGems, cur = "gem" },
		{ id = "barrage", emoji = "\u{1F680}", name = "Barrage x3", desc = "Triple your next launch", price = Config.Shop.BarrageGems, cur = "gem" },
		{ id = "repair_all", emoji = "\u{1F527}", name = "Repair All", desc = "Instantly rebuild", price = Config.Shop.RepairAllGems, cur = "gem" },
		{ id = "skip_cooldown", emoji = "\u{23E9}", name = "Skip Reload", desc = "Rocket ready now", price = Config.Shop.SkipCooldownGems, cur = "gem" },
		{ id = "pass_cash", emoji = "\u{1F4B5}", name = "2X CASH", desc = "Gamepass", price = "R$", cur = "pass" },
		{ id = "pass_damage", emoji = "\u{1F4A5}", name = "2X DAMAGE", desc = "Gamepass", price = "R$", cur = "pass" },
	}

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = content

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -10, 0, 150)
	grid.CellPadding = UDim2.new(0, 8, 0, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingTop = UDim.new(0, 4)
	pad.Parent = scroll

	for i, item in ipairs(items) do
		local card = UILib.card({
			BackgroundColor3 = Color3.fromRGB(130, 200, 235),
			LayoutOrder = i,
		}, scroll)

		UILib.text({
			Size = UDim2.new(1, -8, 0, 52),
			Position = UDim2.new(0, 4, 0, 6),
			Text = item.emoji,
		}, card)
		UILib.text({
			Size = UDim2.new(1, -8, 0, 24),
			Position = UDim2.new(0, 4, 0, 58),
			Text = item.name,
			TextColor3 = Color3.new(1, 1, 1),
		}, card)
		UILib.text({
			Size = UDim2.new(1, -8, 0, 18),
			Position = UDim2.new(0, 4, 0, 82),
			Text = item.desc,
			TextColor3 = Color3.fromRGB(225, 240, 255),
		}, card)

		local priceText = item.cur == "gem" and ("\u{1F48E} " .. item.price)
			or (item.cur == "pass" and "\u{1F311} Robux" or ("\u{1F4B5} " .. item.price))
		UILib.button({
			Size = UDim2.new(1, -16, 0, 40),
			Position = UDim2.new(0, 8, 1, -46),
			Text = priceText,
			BackgroundColor3 = item.cur == "pass" and UILib.Colors.Purple or UILib.Colors.Green,
		}, card, function()
			Remotes.Events.ShopBuy:FireServer(item.id)
		end)
	end
end

local function sideButton(holder, order, iconKind, caption, color, onClick)
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(0, 76, 0, 88)
	frame.LayoutOrder = order
	frame.Parent = holder

	local button = UILib.button({
		Size = UDim2.new(0, 68, 0, 60),
		Position = UDim2.new(0, 4, 0, 0),
		Text = "",
		BackgroundColor3 = color,
	}, frame, onClick)

	local icon = UILib.icon(iconKind, button)
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.new(0, 40, 0, 40)

	local captionLabel = UILib.text({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 0, 62),
		Text = caption,
	}, frame)

	return button, captionLabel
end

function SidePanel.init(context)
	ctx = context
	makeShop()

	local gui = UILib.screen("MVC_Side", 6)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Position = UDim2.new(0, 10, 0, 120)
	holder.Size = UDim2.new(0, 90, 0, 460)
	holder.Parent = gui

	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = holder

	local giftCaption
	giftButton, giftCaption = sideButton(holder, 1, "gift", "Gift", UILib.Colors.Gold, function()
		Remotes.Events.ClaimGift:FireServer()
	end)
	sideButton(holder, 2, "calendar", "Rewards", UILib.Colors.Red, function()
		ctx.DailyUI.toggle()
	end)
	sideButton(holder, 3, "cart", "Shop", UILib.Colors.Blue, function()
		shopGui.Enabled = not shopGui.Enabled
	end)
	sideButton(holder, 4, "bomb", "Attack", UILib.Colors.Purple, function()
		ctx.AttackView.open("rocket")
	end)
	sideButton(holder, 5, "jet", "Jets", UILib.Colors.LightBlue, function()
		ctx.AttackView.open("jet")
	end)
	sideButton(holder, 6, "bomb", "Battery", UILib.Colors.Red, function()
		ctx.AttackView.open("battery")
	end)
	sideButton(holder, 7, "scroll", "Quests", UILib.Colors.Gold, function()
		ctx.QuestUI.toggle()
	end)
	sideButton(holder, 8, "gem", "War", UILib.Colors.DarkGray, function()
		ctx.Military.toggle()
	end)

	-- Compact 2X gamepass buttons under the main column.
	local passCash = UILib.button({
		Size = UDim2.new(0, 84, 0, 30),
		Text = "2X CASH",
		BackgroundColor3 = UILib.Colors.Green,
	}, nil, function()
		Remotes.Events.ShopBuy:FireServer("pass_cash")
	end)
	passCash.LayoutOrder = 9
	passCash.Parent = holder

	local passDmg = UILib.button({
		Size = UDim2.new(0, 84, 0, 30),
		Text = "2X DAMAGE",
		BackgroundColor3 = UILib.Colors.Green,
	}, nil, function()
		Remotes.Events.ShopBuy:FireServer("pass_damage")
	end)
	passDmg.LayoutOrder = 10
	passDmg.Parent = holder

	-- Gift countdown shows in the caption under the icon.
	task.spawn(function()
		while true do
			task.wait(1)
			local remaining = ctx.State.remaining("giftRemaining")
			if remaining &gt; 0 then
				giftCaption.Text = NumberFormat.clock(remaining)
			else
				giftCaption.Text = "GIFT!"
				giftCaption.TextColor3 = Color3.fromRGB(140, 245, 120)
			end
		end
	end)
end

return SidePanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">UIKit</string><ProtectedString name="Source">-- Loads free Creator Store UI packs at runtime and harvests their real image
-- assets (icons, button/panel textures) so the GUI uses designed art instead
-- of code-drawn shapes. Everything is best-effort with graceful fallback: if a
-- pack fails to load or an image isn't found, the caller keeps its drawn look.
--
-- InsertService:LoadAsset works in Studio AND live for public free assets
-- (it does NOT need API Services enabled), so these load during playtests too.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local UIKit = {}

UIKit.ready = false
local images = {} -- lowercased name -&gt; image asset id (string)
local buttonImages = {} -- images whose name looks like a button
local panelImages = {} -- images whose name looks like a panel/frame

local function record(name, id)
	if not id or id == "" or id == "rbxassetid://0" then
		return
	end
	local lname = string.lower(name or "")
	images[lname] = id
	if lname:find("button") or lname:find("btn") then
		buttonImages[#buttonImages + 1] = { name = lname, id = id }
	end
	if lname:find("panel") or lname:find("frame") or lname:find("bg") or lname:find("window") then
		panelImages[#panelImages + 1] = { name = lname, id = id }
	end
end

local function harvest(root)
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			record(obj.Name, obj.Image)
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			record(obj.Name, obj.Texture)
		end
	end
end

function UIKit.load()
	if not Config.UseStoreUIKit then
		return
	end
	for _, packId in ipairs(Config.UIKitPacks or {}) do
		local ok, asset = pcall(function()
			return InsertService:LoadAsset(packId)
		end)
		if ok and asset then
			harvest(asset)
			asset:Destroy()
		end
	end
	UIKit.ready = true
end

-- Returns the first harvested image id whose name contains any keyword.
function UIKit.icon(keywords)
	if not Config.UseStoreUIKit then
		return nil
	end
	for _, kw in ipairs(keywords) do
		for name, id in pairs(images) do
			if name:find(kw, 1, true) then
				return id
			end
		end
	end
	return nil
end

-- Best-guess button texture, preferring one whose name hints the colour.
function UIKit.button(colorHint)
	if not Config.UseStoreUIKit or #buttonImages == 0 then
		return nil
	end
	if colorHint then
		for _, b in ipairs(buttonImages) do
			if b.name:find(colorHint, 1, true) then
				return b.id
			end
		end
	end
	return buttonImages[1].id
end

function UIKit.panel()
	if not Config.UseStoreUIKit or #panelImages == 0 then
		return nil
	end
	return panelImages[1].id
end

return UIKit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">UILib</string><ProtectedString name="Source">-- Chunky cartoon UI toolkit: rounded frames, thick black outlines,
-- bright colors, FredokaOne everywhere. All panels share this look.

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundBook = require(Shared.SoundBook)
local Config = require(Shared.Config)
local UIKit = require(script.Parent.UIKit)

local UILib = {}

-- Which Store-kit image keywords back each drawn icon.
local ICON_KEYWORDS = {
	gift = { "gift", "present" },
	calendar = { "calendar", "daily", "reward" },
	cart = { "shop", "cart", "store" },
	bomb = { "attack", "bomb", "war", "missile" },
	scroll = { "quest", "scroll", "mission" },
	gem = { "gem", "diamond" },
	cash = { "cash", "coin", "money", "dollar" },
	admin = { "admin", "crown", "star", "mod" },
	jet = { "jet", "plane", "air" },
	shield = { "shield", "defense", "defence" },
}

UILib.Font = Enum.Font.FredokaOne
UILib.TitleFont = Enum.Font.Arcade -- blocky pixel font for titles/captions
UILib.Colors = {
	Green = Color3.fromRGB(88, 200, 60),
	DarkGreen = Color3.fromRGB(58, 160, 40),
	Red = Color3.fromRGB(235, 60, 60),
	Blue = Color3.fromRGB(60, 150, 240),
	LightBlue = Color3.fromRGB(120, 200, 250),
	Purple = Color3.fromRGB(150, 80, 220),
	Gold = Color3.fromRGB(250, 200, 60),
	Gray = Color3.fromRGB(120, 120, 128),
	DarkGray = Color3.fromRGB(70, 70, 78),
	Panel = Color3.fromRGB(44, 46, 56),
}

local player = Players.LocalPlayer

function UILib.playerGui()
	return player:WaitForChild("PlayerGui")
end

function UILib.screen(name, displayOrder)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = displayOrder or 1
	gui.Parent = UILib.playerGui()
	return gui
end

function UILib.corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6) -- blockier, old-Roblox feel
	c.Parent = parent
	return c
end

-- Adds a UIScale that keeps UI a sensible size on phones, tablets, TVs.
-- Baselined to a ~900px-tall window; shrinks on small screens.
function UILib.autoScale(frame)
	local scaleObj = Instance.new("UIScale")
	scaleObj.Parent = frame
	local function update()
		local cam = workspace.CurrentCamera
		local vh = cam and cam.ViewportSize.Y or 900
		scaleObj.Scale = math.clamp(vh / 900, 0.55, 1.15)
	end
	update()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	return scaleObj
end

function UILib.stroke(parent, thickness, color)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or Color3.new(0, 0, 0)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function UILib.frame(props, parent)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = UILib.Colors.Panel
	for k, v in pairs(props) do
		f[k] = v
	end
	UILib.corner(f)
	UILib.stroke(f)
	f.Parent = parent
	return f
end

function UILib.text(props, parent)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = UILib.Font
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeColor3 = Color3.new(0, 0, 0)
	t.TextStrokeTransparency = 0
	for k, v in pairs(props) do
		t[k] = v
	end
	t.Parent = parent
	return t
end

function UILib.button(props, parent, onClick)
	local b = Instance.new("TextButton")
	b.BorderSizePixel = 0
	b.Font = UILib.Font
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextStrokeColor3 = Color3.new(0, 0, 0)
	b.TextStrokeTransparency = 0
	b.AutoButtonColor = false
	b.BackgroundColor3 = UILib.Colors.Green
	for k, v in pairs(props) do
		b[k] = v
	end
	UILib.corner(b)
	local strokeObj = UILib.stroke(b, 3)

	-- Glossy top-light gradient (brighter top, darker bottom) for a 3D pill.
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(238, 238, 238)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(206, 206, 206)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(176, 176, 176)),
	})
	gradient.Parent = b

	-- Soft drop shadow behind the button.
	local shadow = Instance.new("ImageLabel")
	shadow.Name = "Shadow"
	shadow.BackgroundTransparency = 1
	shadow.Image = "rbxassetid://5028857084" -- Roblox built-in soft shadow
	shadow.ImageColor3 = Color3.new(0, 0, 0)
	shadow.ImageTransparency = 0.55
	shadow.ScaleType = Enum.ScaleType.Slice
	shadow.SliceCenter = Rect.new(24, 24, 276, 276)
	shadow.Size = UDim2.new(1, 20, 1, 20)
	shadow.Position = UDim2.new(0.5, 0, 0.5, 6)
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.ZIndex = math.max(b.ZIndex - 1, 0)
	shadow.Parent = b

	-- Glossy highlight strip across the top third.
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.BackgroundColor3 = Color3.new(1, 1, 1)
	gloss.BackgroundTransparency = 0.6
	gloss.BorderSizePixel = 0
	gloss.Size = UDim2.new(1, -12, 0, 8)
	gloss.Position = UDim2.new(0, 6, 0, 5)
	gloss.ZIndex = b.ZIndex + 1
	UILib.corner(gloss, 4)
	gloss.Parent = b

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 6)
	padding.PaddingRight = UDim.new(0, 6)
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.Parent = b

	-- Chunky 3D bottom edge + stud dots, like the reference game's buttons.
	local edge = Instance.new("Frame")
	edge.Name = "Edge"
	edge.AnchorPoint = Vector2.new(0.5, 1)
	edge.Position = UDim2.new(0.5, 0, 1, 10)
	edge.Size = UDim2.new(1, 12, 0, 7)
	edge.BackgroundColor3 = Color3.new(0, 0, 0)
	edge.BackgroundTransparency = 0.65
	edge.BorderSizePixel = 0
	edge.ZIndex = b.ZIndex
	UILib.corner(edge, 6)
	edge.Parent = b

	if b.Size.Y.Offset &gt;= 50 then
		for i = 1, 4 do
			local stud = Instance.new("Frame")
			stud.Size = UDim2.new(0, 8, 0, 8)
			stud.Position = UDim2.new((i - 0.5) / 4, -4, 0, 0)
			stud.BackgroundColor3 = Color3.new(1, 1, 1)
			stud.BackgroundTransparency = 0.82
			stud.BorderSizePixel = 0
			UILib.corner(stud, 4)
			stud.Parent = b
		end
	end

	-- Hover feedback via the outline so runtime BackgroundColor3 changes stay intact.
	b.MouseEnter:Connect(function()
		TweenService:Create(strokeObj, TweenInfo.new(0.08), {
			Color = Color3.fromRGB(255, 255, 255),
		}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(strokeObj, TweenInfo.new(0.08), { Color = Color3.new(0, 0, 0) }):Play()
	end)
	b.Activated:Connect(function()
		SoundBook.play("Click", UILib.playerGui())
		if onClick then
			onClick()
		end
	end)
	if parent then
		b.Parent = parent
	end
	return b
end

-- ===== 3D rendered icons (ViewportFrame) — the reference game's "3D icon" look
local function vpart(model, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- Each builder fills a Model with parts centred near the origin (~2-stud tall).
local ICON_MODELS = {
	gem = function(m)
		local top = vpart(m, Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 0.2, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color3.fromRGB(190, 90, 240), Enum.Material.Neon)
		top.Reflectance = 0.2
	end,
	cash = function(m)
		for i = 0, 2 do
			vpart(m, Vector3.new(2.2, 0.4, 1.3), CFrame.new(0, -0.4 + i * 0.42, 0) * CFrame.Angles(0, math.rad(8 * i), 0), Color3.fromRGB(96, 200, 90))
		end
		vpart(m, Vector3.new(0.7, 0.7, 0.05), CFrame.new(0, 0.02, 0.7), Color3.fromRGB(240, 220, 120))
	end,
	coin = function(m)
		vpart(m, Vector3.new(0.4, 2, 2), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(245, 205, 70), Enum.Material.Metal, Enum.PartType.Cylinder)
	end,
	rocket = function(m)
		vpart(m, Vector3.new(0.9, 2, 0.9), CFrame.new(0, 0, 0), Color3.fromRGB(240, 240, 245))
		vpart(m, Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(235, 70, 70), Enum.Material.Neon)
		vpart(m, Vector3.new(0.3, 0.7, 0.3), CFrame.new(-0.55, -0.8, 0), Color3.fromRGB(235, 70, 70))
		vpart(m, Vector3.new(0.3, 0.7, 0.3), CFrame.new(0.55, -0.8, 0), Color3.fromRGB(235, 70, 70))
	end,
	bomb = function(m)
		vpart(m, Vector3.new(1.7, 1.7, 1.7), CFrame.new(0, -0.1, 0), Color3.fromRGB(50, 54, 66), Enum.Material.Metal, Enum.PartType.Ball)
		vpart(m, Vector3.new(0.35, 0.7, 0.35), CFrame.new(0.3, 1, 0) * CFrame.Angles(0, 0, math.rad(-25)), Color3.fromRGB(200, 160, 90))
		vpart(m, Vector3.new(0.5, 0.5, 0.5), CFrame.new(0.6, 1.4, 0), Color3.fromRGB(255, 170, 40), Enum.Material.Neon, Enum.PartType.Ball)
	end,
	gift = function(m)
		vpart(m, Vector3.new(1.8, 1.5, 1.8), CFrame.new(0, -0.2, 0), Color3.fromRGB(235, 70, 70))
		vpart(m, Vector3.new(1.9, 0.4, 0.5), CFrame.new(0, 0, 0), Color3.fromRGB(255, 220, 90))
		vpart(m, Vector3.new(0.5, 0.4, 1.9), CFrame.new(0, 0, 0), Color3.fromRGB(255, 220, 90))
		vpart(m, Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, 0.7, 0) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(255, 220, 90))
	end,
	shield = function(m)
		local s = vpart(m, Vector3.new(1.7, 2, 0.4), CFrame.new(0, 0, 0), Color3.fromRGB(90, 180, 255))
		s.Reflectance = 0.15
		vpart(m, Vector3.new(0.9, 1.1, 0.5), CFrame.new(0, 0.1, 0.05), Color3.fromRGB(150, 210, 255))
	end,
	plane = function(m)
		vpart(m, Vector3.new(0.7, 0.6, 2.2), CFrame.new(0, 0, 0), Color3.fromRGB(120, 140, 170), Enum.Material.Metal)
		vpart(m, Vector3.new(2.4, 0.2, 0.7), CFrame.new(0, 0, 0.1), Color3.fromRGB(150, 170, 200))
		vpart(m, Vector3.new(0.15, 0.7, 0.6), CFrame.new(0, 0.35, 0.9), Color3.fromRGB(150, 170, 200))
	end,
	star = function(m)
		vpart(m, Vector3.new(1.6, 1.6, 0.4), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(250, 205, 60), Enum.Material.Neon)
		vpart(m, Vector3.new(1.6, 1.6, 0.4), CFrame.new(0, 0, 0.02), Color3.fromRGB(250, 205, 60), Enum.Material.Neon)
	end,
}

-- Which drawn-icon kinds map to a 3D model builder.
local ICON_3D = {
	gem = "gem", cash = "cash", gift = "gift", bomb = "bomb",
	jet = "plane", admin = "star", shield = "shield",
}

-- Builds a spinning-free 3D icon in a ViewportFrame.
function UILib.viewportIcon(kind, parent)
	local builder = ICON_MODELS[ICON_3D[kind] or kind]
	if not builder then
		return nil
	end
	local vpf = Instance.new("ViewportFrame")
	vpf.Name = "Icon3D_" .. kind
	vpf.BackgroundTransparency = 1
	vpf.Size = UDim2.fromScale(1, 1)
	vpf.LightColor = Color3.fromRGB(255, 255, 255)
	vpf.Ambient = Color3.fromRGB(180, 180, 190)

	local world = Instance.new("Model")
	world.Parent = vpf
	builder(world)

	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(3.2, 2.4, 4.2), Vector3.new(0, 0, 0))
	cam.Parent = vpf
	vpf.CurrentCamera = cam

	if parent then
		vpf.Parent = parent
	end
	return vpf
end

-- Cartoon icons. Prefer a 3D ViewportFrame model, then a Store-kit image,
-- then a drawn shape. Returns a square Frame/Viewport you size/position.
function UILib.icon(kind, parent)
	-- 1) Real 3D rendered icon (reliable, reference-style).
	if ICON_3D[kind] then
		local vp = UILib.viewportIcon(kind, parent)
		if vp then
			return vp
		end
	end

	local box = Instance.new("Frame")
	box.Name = "Icon_" .. kind
	box.BackgroundTransparency = 1

	-- 2) Store-kit image (no distortion: ScaleType Fit).
	local kw = ICON_KEYWORDS[kind]
	local kitImage = kw and UIKit.icon(kw) or nil
	if kitImage then
		local img = Instance.new("ImageLabel")
		img.Name = "KitIcon"
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = kitImage
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = box
		if parent then
			box.Parent = parent
		end
		return box
	end

	local function shape(props)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		for k, v in pairs(props) do
			if k ~= "Round" and k ~= "Parent" then
				f[k] = v
			end
		end
		UILib.corner(f, props.Round or 3)
		f.Parent = props.Parent or box
		return f
	end

	if kind == "gift" then
		shape({ Size = UDim2.fromScale(0.72, 0.5), Position = UDim2.fromScale(0.5, 0.68), BackgroundColor3 = Color3.fromRGB(235, 60, 60) })
		shape({ Size = UDim2.fromScale(0.84, 0.18), Position = UDim2.fromScale(0.5, 0.4), BackgroundColor3 = Color3.fromRGB(255, 90, 90) })
		shape({ Size = UDim2.fromScale(0.16, 0.78), Position = UDim2.fromScale(0.5, 0.54), BackgroundColor3 = Color3.fromRGB(255, 220, 90) })
		shape({ Size = UDim2.fromScale(0.2, 0.16), Position = UDim2.fromScale(0.36, 0.24), BackgroundColor3 = Color3.fromRGB(255, 220, 90), Round = 8 })
		shape({ Size = UDim2.fromScale(0.2, 0.16), Position = UDim2.fromScale(0.64, 0.24), BackgroundColor3 = Color3.fromRGB(255, 220, 90), Round = 8 })
	elseif kind == "calendar" then
		shape({ Size = UDim2.fromScale(0.78, 0.7), Position = UDim2.fromScale(0.5, 0.6), BackgroundColor3 = Color3.fromRGB(245, 245, 250), Round = 5 })
		shape({ Size = UDim2.fromScale(0.78, 0.24), Position = UDim2.fromScale(0.5, 0.32), BackgroundColor3 = Color3.fromRGB(235, 60, 60), Round = 5 })
		for r = 0, 1 do
			for c = 0, 2 do
				shape({ Size = UDim2.fromScale(0.13, 0.1), Position = UDim2.fromScale(0.32 + c * 0.18, 0.56 + r * 0.18), BackgroundColor3 = Color3.fromRGB(160, 170, 190), Round = 2 })
			end
		end
	elseif kind == "cart" then
		shape({ Size = UDim2.fromScale(0.6, 0.38), Position = UDim2.fromScale(0.52, 0.46), BackgroundColor3 = Color3.fromRGB(235, 90, 100), Round = 5 })
		shape({ Size = UDim2.fromScale(0.5, 0.1), Position = UDim2.fromScale(0.52, 0.3), BackgroundColor3 = Color3.fromRGB(255, 130, 140), Round = 4 })
		local handle = shape({ Size = UDim2.fromScale(0.3, 0.08), Position = UDim2.fromScale(0.2, 0.32), BackgroundColor3 = Color3.fromRGB(120, 130, 150), Round = 4 })
		handle.Rotation = -35
		shape({ Size = UDim2.fromScale(0.16, 0.16), Position = UDim2.fromScale(0.36, 0.76), BackgroundColor3 = Color3.fromRGB(60, 65, 80), Round = 12 })
		shape({ Size = UDim2.fromScale(0.16, 0.16), Position = UDim2.fromScale(0.7, 0.76), BackgroundColor3 = Color3.fromRGB(60, 65, 80), Round = 12 })
	elseif kind == "bomb" then
		shape({ Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.46, 0.62), BackgroundColor3 = Color3.fromRGB(52, 56, 68), Round = 24 })
		shape({ Size = UDim2.fromScale(0.18, 0.14), Position = UDim2.fromScale(0.62, 0.3), BackgroundColor3 = Color3.fromRGB(120, 128, 142), Round = 3 })
		local fuse = shape({ Size = UDim2.fromScale(0.26, 0.07), Position = UDim2.fromScale(0.76, 0.22), BackgroundColor3 = Color3.fromRGB(200, 160, 90), Round = 4 })
		fuse.Rotation = -30
		shape({ Size = UDim2.fromScale(0.16, 0.16), Position = UDim2.fromScale(0.88, 0.14), BackgroundColor3 = Color3.fromRGB(255, 170, 40), Round = 12 })
		shape({ Size = UDim2.fromScale(0.14, 0.14), Position = UDim2.fromScale(0.34, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.6, Round = 10 })
	elseif kind == "scroll" then
		shape({ Size = UDim2.fromScale(0.66, 0.74), Position = UDim2.fromScale(0.5, 0.54), BackgroundColor3 = Color3.fromRGB(245, 230, 190), Round = 5 })
		shape({ Size = UDim2.fromScale(0.74, 0.16), Position = UDim2.fromScale(0.5, 0.22), BackgroundColor3 = Color3.fromRGB(210, 180, 130), Round = 8 })
		for r = 0, 2 do
			shape({ Size = UDim2.fromScale(0.46, 0.06), Position = UDim2.fromScale(0.5, 0.46 + r * 0.16), BackgroundColor3 = Color3.fromRGB(170, 150, 110), Round = 3 })
		end
	elseif kind == "gem" then
		local outer = shape({ Size = UDim2.fromScale(0.58, 0.58), Position = UDim2.fromScale(0.5, 0.52), BackgroundColor3 = Color3.fromRGB(190, 90, 240), Round = 6 })
		outer.Rotation = 45
		local inner = shape({ Size = UDim2.fromScale(0.32, 0.32), Position = UDim2.fromScale(0.5, 0.52), BackgroundColor3 = Color3.fromRGB(225, 160, 255), Round = 4 })
		inner.Rotation = 45
	elseif kind == "admin" then
		-- Gold shield badge with a star.
		local shield = shape({ Size = UDim2.fromScale(0.66, 0.74), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(240, 190, 50), Round = 6 })
		shape({ Size = UDim2.fromScale(0.44, 0.5), Position = UDim2.fromScale(0.5, 0.46), BackgroundColor3 = Color3.fromRGB(255, 225, 120), Round = 5 })
		local star = Instance.new("TextLabel")
		star.AnchorPoint = Vector2.new(0.5, 0.5)
		star.Position = UDim2.fromScale(0.5, 0.48)
		star.Size = UDim2.fromScale(0.6, 0.6)
		star.BackgroundTransparency = 1
		star.Font = UILib.Font
		star.TextScaled = true
		star.Text = "\u{2605}"
		star.TextColor3 = Color3.fromRGB(180, 120, 20)
		star.Parent = box
		local _ = shield
	elseif kind == "jet" then
		local body = shape({ Size = UDim2.fromScale(0.2, 0.6), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(120, 140, 170), Round = 4 })
		shape({ Size = UDim2.fromScale(0.8, 0.16), Position = UDim2.fromScale(0.5, 0.52), BackgroundColor3 = Color3.fromRGB(150, 170, 200), Round = 3 })
		shape({ Size = UDim2.fromScale(0.34, 0.12), Position = UDim2.fromScale(0.5, 0.78), BackgroundColor3 = Color3.fromRGB(150, 170, 200), Round = 3 })
		local _ = body
	elseif kind == "shield" then
		shape({ Size = UDim2.fromScale(0.66, 0.74), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(90, 180, 255), Round = 6 })
		shape({ Size = UDim2.fromScale(0.4, 0.46), Position = UDim2.fromScale(0.5, 0.46), BackgroundColor3 = Color3.fromRGB(150, 210, 255), Round = 5 })
	elseif kind == "cash" then
		shape({ Size = UDim2.fromScale(0.82, 0.52), Position = UDim2.fromScale(0.5, 0.52), BackgroundColor3 = Color3.fromRGB(88, 190, 70), Round = 5 })
		shape({ Size = UDim2.fromScale(0.66, 0.36), Position = UDim2.fromScale(0.5, 0.52), BackgroundColor3 = Color3.fromRGB(120, 215, 95), Round = 4 })
		local dollar = Instance.new("TextLabel")
		dollar.AnchorPoint = Vector2.new(0.5, 0.5)
		dollar.Position = UDim2.fromScale(0.5, 0.52)
		dollar.Size = UDim2.fromScale(0.5, 0.44)
		dollar.BackgroundTransparency = 1
		dollar.Font = UILib.Font
		dollar.TextScaled = true
		dollar.Text = "$"
		dollar.TextColor3 = Color3.fromRGB(40, 110, 35)
		dollar.Parent = box
	end

	if parent then
		box.Parent = parent
	end
	return box
end

-- Tiled stud-texture overlay (the dotted grid on reference panels). Rounds to
-- match its parent. If the texture fails to load it's simply invisible.
function UILib.studOverlay(frame, transparency, radius)
	local overlay = Instance.new("ImageLabel")
	overlay.Name = "Studs"
	overlay.BackgroundTransparency = 1
	overlay.Image = Config.StudTexture
	overlay.ScaleType = Enum.ScaleType.Tile
	overlay.TileSize = UDim2.new(0, 44, 0, 44)
	overlay.ImageTransparency = transparency or 0.82
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = frame.ZIndex
	UILib.corner(overlay, radius or 14)
	overlay.Parent = frame
	return overlay
end

-- A reference-style card: colored, rounded, thick black outline, stud overlay,
-- and a subtle top-light gradient. Used by daily rewards, shop, etc.
function UILib.card(props, parent)
	local card = Instance.new("Frame")
	card.BorderSizePixel = 0
	card.BackgroundColor3 = props.BackgroundColor3 or UILib.Colors.LightBlue
	for k, v in pairs(props) do
		if k ~= "Parent" then
			card[k] = v
		end
	end
	UILib.corner(card, 10)
	UILib.stroke(card, 3)
	UILib.studOverlay(card, 0.86, 10)
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(210, 220, 235))
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.75),
		NumberSequenceKeypoint.new(1, 0.9),
	})
	grad.Parent = card
	card.Parent = parent
	return card
end

-- Reference-style panel: dark navy body + stud overlay + chunky outline, red
-- stud header bar, glossy X close button. This is the shared look for the
-- WHOLE game's menus.
function UILib.panel(name, title, size, displayOrder)
	local gui = UILib.screen(name, displayOrder or 10)
	gui.Enabled = false

	gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if gui.Enabled then
			SoundBook.play("PanelOpen", UILib.playerGui())
		end
	end)

	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	frame.Size = size
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = Color3.fromRGB(40, 44, 58)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	UILib.corner(frame, 16)
	UILib.stroke(frame, 4)
	UILib.studOverlay(frame, 0.86, 16)
	UILib.autoScale(frame)

	-- Soft drop shadow behind the whole panel.
	local shadow = Instance.new("ImageLabel")
	shadow.Name = "PanelShadow"
	shadow.BackgroundTransparency = 1
	shadow.Image = "rbxassetid://5028857084"
	shadow.ImageColor3 = Color3.new(0, 0, 0)
	shadow.ImageTransparency = 0.5
	shadow.ScaleType = Enum.ScaleType.Slice
	shadow.SliceCenter = Rect.new(24, 24, 276, 276)
	shadow.Size = UDim2.new(1, 40, 1, 40)
	shadow.Position = UDim2.new(0.5, 0, 0.5, 10)
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.ZIndex = 0
	shadow.Parent = frame

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 8, 0, 50)
	header.Position = UDim2.new(0.5, 0, 0, -20)
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.BackgroundColor3 = UILib.Colors.Red
	header.BorderSizePixel = 0
	header.ZIndex = 2
	header.Parent = frame
	UILib.corner(header, 12)
	UILib.stroke(header, 4)
	local hstuds = UILib.studOverlay(header, 0.8, 12)
	hstuds.ZIndex = 2

	UILib.text({
		Name = "Title",
		Size = UDim2.new(1, -80, 1, -16),
		Position = UDim2.new(0, 18, 0, 8),
		Text = title,
		Font = UILib.TitleFont,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
	}, header)

	local close = UILib.button({
		Name = "Close",
		Size = UDim2.new(0, 40, 0, 40),
		Position = UDim2.new(1, -50, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Text = "X",
		BackgroundColor3 = Color3.fromRGB(235, 70, 70),
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
	}, header, function()
		gui.Enabled = false
	end)
	local _ = close

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.new(1, -24, 1, -54)
	content.Position = UDim2.new(0, 12, 0, 42)
	content.ZIndex = 2
	content.Parent = frame

	return gui, content
end

return UILib
</ProtectedString></Properties></Item></Item></Item></Item><Item class="Players" referent="RBX65"><Properties><string name="Name">Players</string><int name="MaxPlayersInternal">5</int><int name="PreferredPlayersInternal">5</int></Properties></Item></roblox>